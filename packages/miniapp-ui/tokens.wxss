/* 设计令牌（CSS 变量）— 由各小程序在 app.wxss 中 @import 使用。 */
page {
  --color-brand: #31558a;
  --color-brand-dark: #243f69;
  --color-success: #52c41a;
  --color-warning: #faad14;
  --color-danger: #ff4d4f;
  --color-text: #1f1f1f;
  --color-text-secondary: #595959;
  --color-text-tertiary: #8c8c8c;
  --color-border: #e5e7eb;
  /* 页面底色。和白卡片必须拉开差距 —— 原来是 #f5f6f8，跟 #ffffff 差不到 2%，
     手机上在户外光线下卡片和底色糊成一片，看不出「一张一张」。
     注意它和 --color-bg 是两回事：--color-bg 还兼着卡片内输入框/引用块的底色，
     那个不能跟着变深，否则白卡片里一块块灰太脏。 */
  --color-page-bg: #e6eaf1;
  --color-bg: #f5f6f8;
  --color-card-bg: #ffffff;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* ---------- 间距：严格 8rpx 节奏 ----------
     只用这几档，页面里不要再写 10rpx / 12rpx / 22rpx 这种随手值 ——
     间距一乱，再大的字号也救不回「页面很挤」的观感。
     层级对应：xs 元素内 / sm 相邻元素 / md 字段内 / lg 字段间 / xl 分组间 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;

  /* 触控下限 88rpx = 44pt，老人手指粗、手抖，低于这个数点不准 */
  --tap-min: 88rpx;
  /* 交互过渡统一 200ms：低于 150ms 像闪，高于 300ms 像卡 */
  --dur: 200ms;

  /* ---------- 字号阶梯（两个小程序共用） ----------
     业主端老人多，员工端是站在楼道里单手拿手机看 —— 两边都按「比常规大一档」来：
     正文 32rpx、输入框 34rpx、按钮 36rpx、行高 ≥ 1.6、点击目标 ≥ 88rpx。
     整体缩放只改这几个变量，页面里不要再写死 rpx，否则总有页面漏掉、值还会打架。 */
  --font-xs: 26rpx; /* 角标、缩略图上的小字，能不用就不用 */
  --font-sm: 28rpx; /* 单号、时间、地址这类次要信息 */
  --font-md: 30rpx; /* 表单标签、辅助说明 */
  --font-lg: 32rpx; /* 正文，page 默认 */
  --font-xl: 34rpx; /* 输入框、列表主标题 */
  --font-2xl: 36rpx; /* 卡片标题、按钮 */
  --font-3xl: 38rpx; /* 页面主标题 */

  background: var(--color-page-bg);
  color: var(--color-text);
  font-size: var(--font-lg);
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Noto Sans SC",
    "Helvetica Neue", Arial, sans-serif;
}

/* ---------- 只读信息行：定宽标签 + 值（全局，卡片里的信息一律走这一套） ----------
   规矩来自「一眼能扫」的清单式卡片：
     · 一张卡里只允许有这一种信息排版，不要再混图标行、彩色条、两列页脚
     · 标签定宽，所有的「值」落在同一条竖线上 —— 眼睛顺着一列往下走就行，
       不用每行重新找从哪儿开始读
     · 标签一律 4 个字（报修地址 / 故障描述 / 报修时间 / 等待材料），
       凑不满 4 个字的换词，不要靠空格凑，也不要一会儿 2 字一会儿 4 字
   还有一条不能破的区分：
     **有底色的框 = 要你动手填（.input/.textarea/.picker/.stepper）；
       没底色的 = 只是给你看（.kv）。**
   之前信息和输入长得一样，用户分不清哪些该填，就是因为这条没立起来。 */
.kv {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  line-height: 1.6;
}
.kv:first-child { margin-top: 0; }
.kv__k {
  flex-shrink: 0;
  /* 4 个中文字 + 冒号，正好把所有值对齐到同一条竖线 */
  width: 152rpx;
  font-size: var(--font-lg);
  color: var(--color-text-tertiary);
}
.kv__v {
  flex: 1;
  min-width: 0;
  font-size: var(--font-lg);
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
}
/* 业主原话可能很长，卡片里截两行（详情页看全文），否则一屏放不下三张卡 */
.kv__v--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
/* 跟在值后面的一枚小标（「已等 3 天」这类）。
   为什么不直接把整行值上色：一行「08/24 22:44 已等 8 天」全红，
   和标题前那枚「紧急」标签加起来，一张卡上红成一片，反而看不出重点在哪。
   日期永远是黑的，只有这一小截跟着状态变色。 */
.kv__tag {
  margin-left: 16rpx;
  font-size: var(--font-sm);
}
.kv__tag--warn { color: #ad6800; }
.kv__tag--danger { color: var(--color-danger); font-weight: 600; }

/* ---------- 待填控件的统一外观（两端共用） ----------
   「有底色 = 要你动手填」这条规矩，靠的就是这里的 --color-bg 底色。
   多行输入框原来在 5 个页面里各写了一份（员工端 3 份 + 业主端 2 份），
   min-height 三个值、还有一处把 34rpx 写死 —— 同一个控件长出五种样子，
   下次谁改都不知道该改哪份。基线放这儿，页面只允许覆盖 min-height。 */
textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-xl);
  line-height: 1.6;
}
