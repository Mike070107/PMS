@import "/miniprogram_npm/@pms/miniapp-ui/tokens.wxss";

/* 员工端 2026 秋季视觉体系：沉稳蓝负责行动，雾灰蓝负责分区，白色只留给内容卡片。 */
page {
  --color-brand: #1d5f96;
  --color-brand-dark: #173b63;
  --color-success: #24835b;
  --color-warning: #d88a20;
  --color-danger: #d94b50;
  --color-text: #172433;
  --color-text-secondary: #526274;
  --color-text-tertiary: #7d8b9a;
  --color-border: #d5e0ea;
  --color-page-bg: #edf2f7;
  --color-bg: #f3f6f9;
  --color-card-bg: #ffffff;
  --color-hairline: #e4ebf2;
  --radius-sm: 16rpx;
  --radius-md: 28rpx;
  --radius-lg: 40rpx;
  --shadow-float: 0 12rpx 36rpx rgba(20, 48, 78, 0.16);
  background: linear-gradient(180deg, #f2f6fa 0, #edf2f7 520rpx, #edf2f7 100%);
}

/* ---------- 字号基准（与业主端同一套阶梯，见 tokens.wxss 的 --font-*） ----------
   维修工是站在楼道、蹲在水管边单手看手机，字太小根本看不清。
   整体放大不是逐页加覆盖（那样总有页面漏掉、值还会打架），而是：
   阶梯定义在 tokens.wxss，这里只负责把控件套上去，页面里一律引变量不写死 rpx。
   基准：正文 32rpx、输入框 34rpx、按钮 36rpx、行高 ≥ 1.6、点击目标 ≥ 88rpx。 */

.container { padding: 28rpx 24rpx 64rpx; }

/* tab 页的内容区要给底部 tabBar 让出高度（tabBar 是 position: fixed，盖在内容上）。
   不让出来，最后一张卡片的下半截就压在 tabBar 底下，看着像「列表少了一条」。
   留白 = tabBar 高度（图标 + 文字 ≈ 100rpx，上下 padding 22rpx）+ 安全区 + 一点呼吸空间。
   写成两个类的原因和 .container--with-bar 一样：单写 .container--tabbar 会被
   上面这条同特异度、更靠后的规则整个压掉。 */
.container.container--tabbar {
  /* 2026-08-31 tabBar 改成悬浮胶囊后要多让一档：胶囊高 112 + 离底 24 + 呼吸 64。
     改这个数之前先看 custom-tab-bar/index.wxss 里的 .tabbar 尺寸，两边是一套账。 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card-bg);
  border-radius: 32rpx;
  padding: 32rpx 28rpx;
  /* 列表里是一张卡紧挨着下一张，28rpx 加上投影后两张卡看着像连在一起的一整块，
     一眼分不出「这是两条工单」。卡间 40rpx、卡内上下 40rpx 才撑得开 */
  margin-bottom: 24rpx;
  /* 发丝边 + 投影一起上：只靠投影在户外光线下看不出来，只靠边框又太生硬 */
  border: 2rpx solid #dbe5ee;
  box-shadow: 0 8rpx 24rpx rgba(26, 54, 83, 0.07);
}

/* ---------- 按钮体系（与业主端同一套） ----------
   微信 <button> 自带 margin、::after 边框和 2.55 倍行高，各页面再各写各的高度，
   就会出现「偏一点 / 文字不居中 / 大小不一」。统一用 flex 居中，尺寸只在这里定义。 */
button { margin: 0; }
button::after { border: none; }

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  /* 微信 button 组件基础样式对 width 和左右 margin 用了更高优先级（实测普通类选择器
     压不住：margin-left 仍是 auto，width 仍按内容撑开），这两项只能用 !important 覆盖，
     不加的话按钮左右缩水、被 auto margin 居中，看起来就是「偏、大小不一」。
     纵向 margin 微信没有默认值，所以**不能**写成 margin: 0 !important —— 那会把所有
     加在按钮自己身上的上下间距（.mt / .mt-sm / 页面自定义类）一起吃掉，按钮和上一块
     内容贴死在一起，而 wxss 看上去完全正确（工单池两个报修入口就是这么糊住的）。
     按钮的上下间距优先交给容器（.btn-group / .btn-row / 外层 view）；
     直接写在按钮上的 margin-top / margin-bottom 现在也能生效。 */
  width: 100% !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  margin-top: 0;
  margin-bottom: 0;
  flex-shrink: 0;
  height: 104rpx;
  padding: 0 32rpx;
  font-size: var(--font-2xl);
  font-weight: 500;
  line-height: 1;
  border-radius: 22rpx;
  transition: opacity 200ms ease;
}
.btn::after { border: none; }
.btn:active { opacity: 0.85; }
.btn[disabled] { opacity: 0.5; }

.btn--primary {
  background: linear-gradient(135deg, #236da6, #174f83);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(29, 95, 150, 0.20);
}
.btn--outline {
  background: #f7fbff;
  color: var(--color-brand);
  border: 2rpx solid var(--color-brand);
}
.btn--ghost { background: #edf2f7; color: var(--color-text-secondary); }
/* 小尺寸与并排按钮要把上面的 100% 覆盖回去，同样需要 !important。
   高度仍保持 ≥ 76rpx，戴着手套也点得中 */
.btn--sm { width: auto !important; height: 76rpx; padding: 0 32rpx; font-size: var(--font-md); }

/* ---------- 操作图标 ----------
   主要动作统一使用线性 SVG 图标，不使用 emoji。图标只负责帮助扫读，按钮文字仍完整保留。
   白色版用于实底主按钮，蓝/灰版用于描边或次要按钮。 */
.btn__icon,
.entry-icon__glyph {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  margin-right: 14rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.btn--sm .btn__icon { width: 30rpx; height: 30rpx; margin-right: 10rpx; }
.entry-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #e8f2fa;
}
.entry-icon__glyph { margin-right: 0; width: 38rpx; height: 38rpx; }

