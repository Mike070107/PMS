<!-- 胶囊离底 24rpx + 安全区，那条缝不挡住的话，滚动时卡片会从胶囊和屏幕
     下边缘之间穿过去（2026-08-31 用户反馈）。这一层和页面同色，铺满整个屏幕宽度，
     顶边藏进胶囊后面一截，免得两者之间留一条亚像素缝。 -->
<block wx:if="{{!hidden}}">
<view class="tabbar-shield"></view>
<view class="tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tabbar__item {{selectedKey === item.key ? 'tabbar__item--on' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
    hover-class="tabbar__item--hover"
    hover-stay-time="80"
  >
    <view class="tabbar__icon tabbar__icon--{{item.key}}">
      <text wx:if="{{item.badge}}" class="tabbar__badge">{{item.badge}}</text>
    </view>
    <view class="tabbar__text">{{item.text}}</view>
  </view>
</view>
</block>
