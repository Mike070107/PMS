.stocktake-page { padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
.top-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-bottom: 24rpx; }
.task-tabs { margin-bottom: 24rpx; }
.empty-card { text-align: center; padding: 72rpx 32rpx; }
.empty-card__title { color: var(--color-text-secondary); font-size: var(--font-lg); }
.task-card { padding: 28rpx; }
.task-card__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.task-card__title { flex: 1; min-width: 0; color: var(--color-text); font-size: var(--font-xl); font-weight: 600; }
.task-card__no { margin-top: 8rpx; color: var(--color-text-tertiary); font-size: var(--font-sm); font-variant-numeric: tabular-nums; }
.status-tag { flex-shrink: 0; padding: 8rpx 18rpx; border-radius: 999rpx; font-size: var(--font-sm); }
.status-tag--active { color: var(--color-brand); background: #eaf3fb; }
.status-tag--review { color: #ad6800; background: #fff7e6; }
.status-tag--reject { color: var(--color-danger); background: #fff1f0; }
.status-tag--done { color: var(--color-success); background: #edf8f2; }
.task-card__meta { display: flex; justify-content: space-between; gap: 24rpx; margin-top: 20rpx; color: var(--color-text-secondary); font-size: var(--font-md); }
.task-card__meta text:last-child { color: var(--color-text); text-align: right; }
.progress-row { display: flex; justify-content: space-between; margin-top: 24rpx; color: var(--color-text-secondary); font-size: var(--font-sm); }
.progress { height: 14rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: #e5edf4; }
.progress__bar { height: 100%; min-width: 0; border-radius: 999rpx; background: var(--color-brand); }
.difference-tip { margin-top: 16rpx; color: #ad6800; font-size: var(--font-sm); }
.reject-tip { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: #fff1f0; color: var(--color-danger); font-size: var(--font-sm); line-height: 1.6; }
.task-card__action { display: flex; justify-content: flex-end; align-items: center; gap: 10rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid var(--color-hairline); color: var(--color-brand); font-size: var(--font-md); font-weight: 500; }
.task-card__action text { font-size: 40rpx; line-height: 1; }
.create-sheet { height: 72vh; }
.create-body { padding: 32rpx 24rpx; }
.compact-notice { margin-top: 12rpx; }
