<view class="container library-page">
  <view class="library-head"><view class="library-title">经验本</view><button wx:if="{{canCreate}}" class="library-create" bindtap="onCreate">＋ 新建</button></view>
  <view class="search-row"><input class="input" placeholder="搜索标题和正文" aria-label="搜索标题和正文" value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search"/><button wx:if="{{keyword}}" class="quiet-button" bindtap="onClearKeyword">清空</button></view>
  <view class="library-views"><button wx:for="{{views}}" wx:key="value" class="view-tab {{view === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="onView" aria-label="{{item.label}}，{{view === item.value ? '已选中' : '未选中'}}">{{item.label}}</button></view>
  <view class="library-secondary"><text class="library-count">{{loaded && !error ? total + ' 篇文档' : ''}}</text><button class="quiet-button" bindtap="onToggleFilters">{{filtersOpen ? '收起筛选' : '筛选'}}{{communityId || repairType ? ' · 已选' : ''}}</button></view>
  <view wx:if="{{filtersOpen}}" class="library-filters"><picker range="{{communityNames}}" value="{{communityIndex}}" bindchange="onCommunity"><view class="filter-picker">{{communityNames[communityIndex] || '全部小区'}} ▾</view></picker><picker range="{{repairTypeNames}}" value="{{repairTypeIndex}}" bindchange="onRepairType"><view class="filter-picker">{{repairTypeNames[repairTypeIndex] || '全部工种'}} ▾</view></picker></view>
  <view wx:if="{{optionsError}}" class="library-error">{{optionsError}}<button class="quiet-button" bindtap="loadOptions">重试权限</button></view>
  <view wx:if="{{loading}}" class="library-state" aria-role="status">正在加载文档…</view>
  <view wx:if="{{error}}" class="library-error">{{error}}<button class="quiet-button" bindtap="onRetry">重试</button></view>
  <view wx:for="{{items}}" wx:key="id" class="note-row" data-id="{{item.id}}" bindtap="onOpen" hover-class="note-row--hover">
    <view class="note-row__body"><view class="note-row__title">{{item.title}}</view><view wx:if="{{item.preview}}" class="note-row__preview">{{item.preview}}</view><view class="note-row__scope">{{item.scopeText}}</view><view class="note-row__meta">{{item.authorText}} · {{item.updatedText}}</view></view>
    <button class="note-favorite {{item.favorite ? 'is-active' : ''}}" data-id="{{item.id}}" catchtap="onToggleFavorite" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}{{item.title}}">{{item.favorite ? '已收藏' : '收藏'}}</button>
  </view>
  <view wx:if="{{loaded && !loading && !error && !items.length}}" class="library-state"><view>{{query || communityId || repairType ? '没有找到匹配的文档' : '这里还没有文档'}}</view><view class="library-state__hint">{{query || communityId || repairType ? '试试清空搜索或调整筛选' : '新建文档默认仅自己可见'}}</view></view>
  <button wx:if="{{items.length < total && !loading && !error}}" class="load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="onLoadMore">加载更多</button>
</view>
