<view class="container">
  <view wx:if="{{loading}}" class="meter-read-loading">正在读取仪表档案…</view>

  <block wx:elif="{{meter}}">
    <view class="card meter-head-card">
      <view class="meter-head-card__top">
        <view class="meter-type meter-type--{{meter.meterType}}">{{meter.meterTypeLabel}}</view>
        <view class="meter-head-card__no">{{meter.meterNo}}</view>
        <view wx:if="{{meter.status !== 'active'}}" class="meter-head-card__off">停用</view>
      </view>
      <view class="meter-head-card__name">{{meter.name || '未命名仪表'}}</view>
      <view class="meter-head-card__addr">{{meter.communityName}}{{meter.installAddress ? ' · ' + meter.installAddress : ''}}</view>
      <view class="meter-head-card__last">
        上次读数 <text>{{meter.lastReadingValueText || '—'}} {{meter.unit}}</text>
        <text class="meter-head-card__time">{{lastReadingText}}</text>
      </view>
      <view class="meter-head-card__digits">
        读数位数：{{meter.integerDigits}} 位整数{{meter.decimalDigits ? ' + ' + meter.decimalDigits + ' 位小数' : '，无小数'}}
        <text wx:if="{{meter.unitPriceCents > 0}}"> · 单价 ¥{{meter.unitPriceYuan}}/{{meter.unit}}</text>
      </view>
    </view>

    <!-- 拍照走系统相机：这条链路在真机/体验版最稳；闪光灯用系统相机顶部的控制 -->
    <block wx:if="{{mode === 'camera'}}">
      <view class="card meter-camera-launch">
        <view class="meter-camera-launch__icon">表</view>
        <view class="meter-camera-launch__title">拍一张仪表全景照</view>
        <view class="meter-camera-launch__desc">
          点「拍照」会打开手机系统相机；把整块表拍进去，读数放中间。闪光灯在系统相机界面里开。
        </view>
        <button class="btn btn--primary meter-camera-launch__main" bindtap="takeSystemPhoto">拍照</button>
        <button class="btn btn--outline" bindtap="chooseFromAlbum">从相册选照片</button>
      </view>
      <view class="meter-camera-hint">拍完只在小图里看红框是否套住读数；高清原图会保留，后台可放大人工比对。</view>
    </block>

    <block wx:elif="{{mode === 'preview'}}">
      <view class="card meter-ocr-card {{ocr && ocr.ok ? 'is-ok' : 'is-warn'}}">
        <view class="meter-ocr-head">
          <view class="meter-ocr-title">识别结果</view>
          <view wx:if="{{ocr}}" class="meter-conf {{ocr.confidence >= 75 ? 'is-ok' : 'is-warn'}}">{{ocr.confidence}}%</view>
        </view>
        <view wx:if="{{recognizing}}" class="meter-ocr-hint">正在识别框内读数，约 2~5 秒…</view>
        <view wx:elif="{{ocr && ocr.ok}}" class="meter-ocr-hint">已回填到下面输入框，请对照全景原图核对每个数字</view>
        <view wx:elif="{{ocr}}" class="meter-ocr-hint">框内没有自动读出数字，请调整红框后重试，或对照原图手工输入</view>
        <view wx:if="{{ocr && ocr.orientation}}" class="meter-ocr-hint">照片自动旋转 {{ocr.orientation}}° 后识别，原图方向不变</view>
        <view wx:if="{{ocr && ocr.meterNoMatched === false}}" class="meter-ocr-warn">
          识别到表号 {{ocr.meterNo}}，与档案 {{meter.meterNo}} 不一致，请重点核对
        </view>
        <view wx:if="{{digitWarning}}" class="meter-ocr-warn">{{digitWarning}}</view>
        <view wx:if="{{error}}" class="meter-ocr-error">{{error}}</view>
        <view class="meter-ocr-actions">
          <button wx:if="{{ocr && !ocr.ok}}" class="mini-btn" bindtap="onRetryRecognize">再识别一次</button>
          <button wx:if="{{ocr && ocr.texts}}" class="mini-btn" bindtap="toggleOcrText">{{showOcrText ? '收起原文' : '查看识别原文'}}</button>
        </view>
        <scroll-view wx:if="{{showOcrText}}" scroll-y class="meter-ocr-text">{{ocr.texts}}</scroll-view>
      </view>

      <view class="card meter-input-card">
        <view class="meter-input-label">
          本次读数
          <text class="meter-input-sub">（{{meter.integerDigits}} 位整数{{meter.decimalDigits ? ' + ' + meter.decimalDigits + ' 位小数' : ''}}）</text>
        </view>
        <view class="meter-input-row">
          <input
            class="meter-value-input"
            type="digit"
            value="{{valueText}}"
            bindinput="onValueInput"
            placeholder="请输入读数"
            confirm-type="done"
          />
          <text class="meter-input-unit">{{meter.unit}}</text>
        </view>
        <view class="meter-preview">
          <view class="meter-preview__row">
            <text>上次读数</text>
            <text class="meter-preview__value">{{meter.lastReadingValueText || '无'}} {{meter.unit}}</text>
          </view>
          <view wx:if="{{usageText}}" class="meter-preview__row">
            <text>预计用量</text>
            <text class="meter-preview__value">{{usageText}}</text>
          </view>
          <view wx:if="{{amountText}}" class="meter-preview__row">
            <text>预计金额</text>
            <text class="meter-preview__value is-money">{{amountText}}</text>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="meter-input-label">备注（选填）</view>
        <textarea
          class="meter-note"
          value="{{note}}"
          bindinput="onNote"
          placeholder="如表盘脏、换表、住户不在等情况"
          maxlength="500"
          auto-height
        />
      </view>

      <view wx:if="{{!canSubmit}}" class="meter-readonly">你的角色只有查看权限，不能提交读数。</view>
      <button class="btn btn--primary meter-submit" disabled="{{submitting || !canSubmit}}" bindtap="submit">
        {{submitting ? '提交中…' : '确认提交'}}
      </button>
      <button class="btn btn--ghost meter-retake" bindtap="onRetake">重拍</button>
    </block>

    <!-- 成功 -->
    <block wx:else>
      <view class="card meter-done">
        <view class="meter-done__icon"></view>
        <view class="meter-done__title">抄表已提交</view>
        <view class="meter-done__no">{{meter.meterNo}}</view>
        <view class="meter-done__value">{{result.reading.readingValueText}} <text>{{meter.unit}}</text></view>
        <view class="meter-done__rows">
          <view class="meter-done__row"><text>用量</text><text>{{result.usageLabel}}</text></view>
          <view wx:if="{{result.charge}}" class="meter-done__row">
            <text>本次应收</text><text class="is-money">¥{{resultChargeYuan}}</text>
          </view>
          <view wx:else class="meter-done__row"><text>账单</text><text>待复核通过后自动出账</text></view>
          <view class="meter-done__row"><text>拍照时间</text><text>{{readAtText}}</text></view>
          <view class="meter-done__row"><text>抄表人</text><text>{{result.reading.operatorName || '本人'}}</text></view>
        </view>
        <view class="meter-done__tip">原图与识别记录已保存，后台可在「抄表管理」复核。</view>
      </view>
      <button class="btn btn--primary" bindtap="onContinue">继续抄下一块</button>
      <button class="btn btn--ghost" bindtap="onOpenDetail">查看这块表的历史</button>
    </block>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-state__title">没有读到仪表</view>
    <view class="empty-state__desc">{{error || '请返回重试或联系管理员。'}}</view>
  </view>

  <view wx:if="{{cropOpen}}" class="crop-screen">
    <view class="crop-top">
      <text class="crop-top__btn" bindtap="onRetakeCrop">重拍</text>
      <text class="crop-top__title">把读数放进红框</text>
      <text class="crop-top__btn" bindtap="onResetView">重置</text>
    </view>
    <view class="crop-stage-wrap">
      <view
        class="crop-stage"
        style="width:{{photoDisplayWidth}}px;height:{{photoDisplayHeight}}px"
        bindtouchstart="onPhotoTouchStart"
        catchtouchmove="onPhotoTouchMove"
        bindtouchend="onPhotoTouchEnd"
      >
        <image
          class="crop-image"
          src="{{photoPath}}"
          mode="scaleToFill"
          style="transform: translate({{imgX}}px,{{imgY}}px) scale({{imgScale}}) rotate({{imgRotate}}deg)"
        />
        <view
          class="crop-frame"
          style="left:{{frame.x * 100}}%;top:{{frame.y * 100}}%;width:{{frame.w * 100}}%;height:{{frame.h * 100}}%"
        ></view>
      </view>
    </view>
    <view class="crop-hint">单指拖动 · 双指缩放/旋转 · 框不动</view>
    <view class="crop-sheet">
      <view wx:if="{{recognizing}}" class="crop-sheet__hint">正在识别红框内的读数…</view>
      <block wx:elif="{{ocr && ocr.ok && !imgDirty}}">
        <view class="crop-input-row">
          <input
            class="crop-input"
            type="digit"
            value="{{valueText}}"
            bindinput="onCropValueInput"
            placeholder="识别不对，直接改这里"
            confirm-type="done"
          />
          <text class="crop-unit">{{meter.unit}}</text>
        </view>
        <view wx:if="{{digitWarning}}" class="crop-warn">{{digitWarning}}</view>
        <view wx:else class="crop-sheet__hint">识别不准可以直接改数字，改完点使用</view>
        <view class="crop-actions">
          <button class="btn btn--ghost" bindtap="onRecognizeRoi">重新识别</button>
          <button class="btn btn--primary" disabled="{{!cropCanUse}}" bindtap="onUseCropResult">使用这个读数</button>
        </view>
      </block>
      <block wx:else>
        <view class="crop-input-row">
          <input
            class="crop-input"
            type="digit"
            value="{{valueText}}"
            bindinput="onCropValueInput"
            placeholder="也可以直接手输读数"
            confirm-type="done"
          />
          <text class="crop-unit">{{meter.unit}}</text>
        </view>
        <view class="crop-warn">{{error || (imgDirty ? '画面已调整，请点识别' : '还没读出数字，调整画面后再试')}}</view>
        <view class="crop-actions">
          <button class="btn btn--ghost" bindtap="onRecognizeRoi">{{recognizing ? '识别中…' : '识别'}}</button>
          <button class="btn btn--primary" disabled="{{!cropCanUse}}" bindtap="onUseCropResult">使用这个读数</button>
        </view>
      </block>
    </view>
  </view>
</view>
