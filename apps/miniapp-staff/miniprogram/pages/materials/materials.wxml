<view class="container">
  <view wx:if="{{!canView}}" class="card">
    <view class="card__title">材料 SKU 库</view>
    <view class="muted mt-sm">{{roleHint}}</view>
  </view>

  <block wx:else>
    <view class="toolbar">
      <input
        class="input search"
        placeholder="搜索名称 / 别名 / 型号 / 编码"
        value="{{keyword}}"
        bindinput="onKeyword"
      />
      <button class="btn btn--outline btn--sm" bindtap="onOpenInventory">库存采购</button>
    </view>

    <!-- 「全部」要显式给一枚：不给的话「怎么退回不筛选」全靠再点一次选中项，没人猜得到 -->
    <scroll-view class="chips" scroll-x enable-flex>
      <view class="chip {{categoryIndex < 0 ? 'chip--on' : ''}}" data-index="-1" bindtap="onPickCategory">全部</view>
      <view
        class="chip {{categoryIndex === index ? 'chip--on' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onPickCategory"
      >{{item}}</view>
    </scroll-view>

    <view class="muted count">共 {{list.length}} 条</view>

    <view wx:if="{{loading}}" class="muted center">加载中…</view>
    <view wx:elif="{{list.length === 0}}" class="muted center">没有匹配的材料</view>

    <view
      class="card sku"
      wx:for="{{list}}"
      wx:key="id"
      data-index="{{index}}"
      bindtap="onEdit"
    >
      <image wx:if="{{item.photoUrl}}" class="sku__photo" src="{{item.photoUrl}}" mode="aspectFill" />
      <view wx:else class="sku__photo sku__photo--empty">无图</view>
      <view class="sku__body">
        <view class="sku__title">
          {{item.titleText}}
          <text wx:if="{{!item.enabled}}" class="tag tag--off">停用</text>
        </view>
        <view class="muted sku__meta">{{item.code}} · {{item.category || '未分类'}} · {{item.unit}}</view>
        <view wx:if="{{item.aliasText}}" class="muted sku__meta">别名：{{item.aliasText}}</view>
      </view>
      <view class="sku__cost">{{item.costText}}</view>
    </view>
  </block>

  <button wx:if="{{canEdit}}" class="fab" bindtap="onCreate">+ 新增</button>
</view>

<!-- 新增 / 编辑 -->
<view wx:if="{{editorOpen}}" class="sheet-mask" bindtap="onCloseEditor" catchtouchmove="noop" />
<view wx:if="{{editorOpen}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">{{form.id ? '编辑材料' : '新增材料'}}</text>
    <text class="sheet__close" bindtap="onCloseEditor">关闭</text>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <view class="field">
      <view class="label">名称</view>
      <input class="input" placeholder="如：PVC 管" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
      <view class="field-error" wx:if="{{errors.name}}">{{errors.name}}</view>
    </view>

    <view class="field">
      <view class="label">型号（选填）</view>
      <input class="input" placeholder="如：DN50" value="{{form.spec}}" data-field="spec" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="label">类别</view>
      <picker mode="selector" range="{{categories}}" bindchange="onFormCategory">
        <view class="picker {{formCategoryIndex < 0 ? 'placeholder' : ''}}">
          {{formCategoryIndex < 0 ? '选择类别（决定编码前缀）' : form.category}}
        </view>
      </picker>
    </view>

    <view class="field">
      <view class="label">单位</view>
      <picker mode="selector" range="{{units}}" value="{{unitIndex}}" bindchange="onFormUnit">
        <view class="picker">{{form.unit}}</view>
      </picker>
      <view class="field-error" wx:if="{{errors.unit}}">{{errors.unit}}</view>
    </view>

    <view class="field">
      <view class="label">默认成本（元，选填）</view>
      <input class="input" type="digit" placeholder="0.00" value="{{form.costYuan}}" data-field="costYuan" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="label">别名（同物异名，顿号或空格分隔）</view>
      <input class="input" placeholder="如：胶布、透明胶" value="{{form.aliases}}" data-field="aliases" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="label">详细参数（选填）</view>
      <textarea class="textarea" placeholder="材质 / 尺寸 / 技术参数等" value="{{form.params}}" data-field="params" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="label">实物照片</view>
      <view class="photo-row">
        <image wx:if="{{form.photoUrl}}" class="photo" src="{{form.photoUrl}}" mode="aspectFill" />
        <button class="btn btn--outline btn--sm" loading="{{uploading}}" bindtap="onChoosePhoto">
          {{form.photoUrl ? '重拍 / 重选' : '拍照或从相册选'}}
        </button>
        <button wx:if="{{form.photoUrl}}" class="btn btn--ghost btn--sm" bindtap="onRemovePhoto">移除</button>
      </view>
    </view>

    <view class="field field--row">
      <view class="label">启用</view>
      <switch checked="{{form.enabled}}" bindchange="onToggleEnabled" />
    </view>
  </scroll-view>

  <view class="sheet__foot">
    <button class="btn btn--primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">保存</button>
  </view>
</view>
