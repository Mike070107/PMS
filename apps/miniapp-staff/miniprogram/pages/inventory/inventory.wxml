<view class="container">
  <view wx:if="{{!canView}}" class="card">
    <view class="card__title">库存与采购</view>
    <view class="muted mt-sm">{{roleHint}}</view>
  </view>

  <block wx:else>
    <view class="tabs">
      <view class="tab {{tab === 'stock' ? 'tab--on' : ''}}" data-tab="stock" bindtap="onSwitchTab">库存</view>
      <view class="tab {{tab === 'purchase' ? 'tab--on' : ''}}" data-tab="purchase" bindtap="onSwitchTab">采购申请</view>
    </view>

    <!-- 库存 -->
    <block wx:if="{{tab === 'stock'}}">
      <view class="toolbar">
        <picker class="picker-wrap" mode="selector" range="{{warehouseNames}}" value="{{warehouseIndex}}" bindchange="onPickWarehouse">
          <view class="picker">{{warehouseNames[warehouseIndex] || '全部仓库'}}</view>
        </picker>
        <view class="chip {{onlyLow ? 'chip--on' : ''}}" bindtap="onToggleLow">
          低于安全库存{{lowCount ? ' ' + lowCount : ''}}
        </view>
      </view>
      <input class="input mb" placeholder="搜索名称 / 别名 / 型号 / 编码" value="{{keyword}}" bindinput="onKeyword" />

      <!-- 类别筛选：材料几十上百条，先按类别缩一轮比一直翻快得多。
           和工单里「从库存选」的筛选条是同一套（app.wxss 的 .chips/.chip） -->
      <scroll-view wx:if="{{categories.length > 1}}" class="chips" scroll-x enable-flex>
        <view class="chip {{categoryIndex < 0 ? 'chip--on' : ''}}" data-index="-1" bindtap="onPickCategory">全部</view>
        <view
          class="chip {{categoryIndex === index ? 'chip--on' : ''}}"
          wx:for="{{categories}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onPickCategory"
        >{{item}}</view>
      </scroll-view>

      <!-- 列头常驻：列表一滚起来就不知道右边那个数字是什么了 -->
      <view wx:if="{{stockRows.length}}" class="sku-head sku-head--flat">
        <text class="sku-head__photo">图片</text>
        <text class="sku-head__name">名称</text>
        <text class="sku-head__qty">库存数量</text>
      </view>

      <view wx:if="{{loading}}" class="muted center">加载中…</view>
      <view wx:elif="{{stockRows.length === 0}}" class="muted center">没有匹配的库存记录</view>

      <!-- 一行的样子必须和工单「从库存选」完全一致：同一批材料在两处要长得一样，
           否则办公室在这儿记住的东西，维修工在工单里认不出来 -->
      <view class="card sku" wx:for="{{stockRows}}" wx:key="materialId">
        <image
          wx:if="{{item.photoUrl}}"
          class="sku__photo"
          src="{{item.photoUrl}}"
          mode="aspectFill"
          data-url="{{item.photoUrl}}"
          catchtap="onPreviewPhoto"
        />
        <view wx:else class="sku__photo sku__photo--empty">无图</view>
        <view class="sku__body">
          <view class="sku__title">{{item.name}}</view>
          <view class="meta">{{item.code}} · {{item.category}}<text wx:if="{{item.safetyText}}"> · {{item.safetyText}}</text></view>
        </view>
        <view class="sku__qty {{item.low ? 'sku__qty--low' : ''}}">
          {{item.qtyText}}<text class="qty__unit">{{item.unit}}</text>
        </view>
      </view>
      <view wx:if="{{warehouseIndex === 0 && stockRows.length}}" class="muted center tip">
        「全部仓库」按材料合并显示总量，选具体仓库可看分仓明细
      </view>
    </block>

    <!-- 采购申请 -->
    <block wx:else>
      <view wx:if="{{loading}}" class="muted center">加载中…</view>
      <view wx:elif="{{requests.length === 0}}" class="muted center">暂无采购申请</view>

      <view class="card" wx:for="{{requests}}" wx:key="id">
        <view class="row">
          <text class="muted">{{item.requestNo}}</text>
          <text class="status">{{item.statusLabel}}</text>
        </view>
        <view class="items">{{item.itemsText || '（无明细）'}}</view>
        <view class="row mt-sm">
          <text class="muted">{{item.createdAtText}}</text>
          <text class="amount">{{item.amountText}}</text>
        </view>
        <view wx:if="{{item.rejectReason}}" class="reject">驳回原因：{{item.rejectReason}}</view>
      </view>
      <view class="muted center tip">审批操作在「审批」页；下单、入库请在管理后台完成</view>
    </block>
  </block>
</view>
