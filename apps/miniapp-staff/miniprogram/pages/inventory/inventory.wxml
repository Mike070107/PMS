<!-- 有悬浮「+ 新增」的两个 tab 要多留一档底部留白，否则最后一条被圆角按钮压住 -->
<view class="container container--tabbar {{(canEdit && tab === 'stock') || (canEditSku && tab === 'sku') ? 'container--fab' : ''}}">
  <view wx:if="{{!canView}}" class="card">
    <view class="card__title">材料与库存</view>
    <view class="muted mt-sm">{{roleHint}}</view>
  </view>

  <block wx:else>
    <view class="screen-head">
      <view class="screen-head__title">材料中心</view>
      <view class="screen-head__desc">查库存、维护材料档案和跟进采购申请</view>
    </view>
    <view wx:if="{{canViewStocktake}}" class="stocktake-entry" bindtap="onStocktake" hover-class="stocktake-entry--press">
      <view class="stocktake-entry__icon"><view class="entry-icon__glyph icon-action--scan-white"></view></view>
      <view class="stocktake-entry__body">
        <view class="stocktake-entry__title">库存盘点</view>
        <view class="stocktake-entry__desc">手机扫码，现场逐项核对库存</view>
      </view>
      <view class="stocktake-entry__arrow">›</view>
    </view>
    <!-- 「材料SKU」只给勾了 app:materials 的角色（角色矩阵里配）。
         没勾的人这一格整个不出现 —— 改材料档案会影响全公司的编码和统计，不是人人该有 -->
    <view wx:if="{{canViewStock || canViewSku}}" class="tabs">
      <view wx:if="{{canViewStock}}" class="tab {{tab === 'stock' ? 'tab--on' : ''}}" data-tab="stock" bindtap="onSwitchTab">库存</view>
      <view wx:if="{{canViewSku}}" class="tab {{tab === 'sku' ? 'tab--on' : ''}}" data-tab="sku" bindtap="onSwitchTab">材料SKU</view>
      <view wx:if="{{canViewStock}}" class="tab {{tab === 'purchase' ? 'tab--on' : ''}}" data-tab="purchase" bindtap="onSwitchTab">采购申请</view>
    </view>

    <!-- ============ 库存：这一屏的主体，列的是全部 SKU + 它现在还有几个 ============ -->
    <block wx:if="{{tab === 'stock'}}">
      <!-- 只读账号看不到「编辑 SKU」和「+ 新增」。补照片、补资料正是办公室要干的活，
           静静地不给按钮，人只会以为功能没做 -->
      <view wx:if="{{!canEdit}}" class="notice">
        <view class="notice__body">
          <view class="notice__title">你的账号只能查看，不能改材料资料</view>
          <view class="notice__desc">
            补照片、补类别成本、新增 SKU 都需要操作权限。请管理员在管理后台「业务角色」页，把你的角色在员工端小程序那张表里「材料与库存」这一行的「改材料信息」勾上；改完在这一页下拉刷新即可，不用退出重登。
          </view>
        </view>
      </view>

      <view wx:if="{{noWarehouseHint}}" class="notice">
        <view class="notice__body">
          <view class="notice__title">你所属的管理处还没有仓库</view>
          <view class="notice__desc">{{noWarehouseHint}}</view>
        </view>
      </view>
      <!-- 看哪个仓：原来是原生 picker，它弹出的滚轮是系统 UI（wxss 改不了），
           选中项和其它项几乎一样亮，户外光线不足时认不出现在看的是哪个仓
           （2026-09-01 现场反馈）。改成一排 chip：选中的实底品牌色，扫一眼就知道，
           还省掉「点开 → 滚 → 确定」三步。仓多了横向滑，不换行挤掉下面的列表 -->
      <scroll-view class="chips" scroll-x enable-flex>
        <view
          wx:for="{{warehouseNames}}"
          wx:key="index"
          class="chip {{warehouseIndex === index ? 'chip--on' : ''}}"
          data-index="{{index}}"
          bindtap="onPickWarehouse"
        >{{item}}</view>
      </scroll-view>
      <input class="input mb" placeholder="搜名称 / 别名 / 型号 / 编码" value="{{keyword}}" bindinput="onKeyword" />

      <!-- 两个开关式筛选：要补货的、要补资料的。和下面的类别筛选条分开一行，
           它们不是「类别」，混在一起会被当成又一个类别点 -->
      <view class="switches">
        <view class="chip {{onlyLow ? 'chip--warn' : ''}}" bindtap="onToggleLow">
          低于安全库存{{lowCount ? ' ' + lowCount : ''}}
        </view>
        <view wx:if="{{canEdit && incompleteCount}}" class="chip {{onlyIncomplete ? 'chip--warn' : ''}}" bindtap="onToggleIncomplete">
          待补资料 {{incompleteCount}}
        </view>
        <!-- 仅显示有货：默认勾上，现场要的是「现在能拿到什么」；点「低于安全库存 / 待补资料」时自动放开，
             否则无货又缺资料的 SKU 永远看不到 -->
        <checkbox-group class="stocked" bindchange="onToggleStocked">
          <label class="stocked__label">
            <checkbox class="stocked__box" value="1" checked="{{onlyStocked}}" color="#31558a" />仅显示有货
          </label>
        </checkbox-group>
      </view>

      <!-- 类别筛选：材料几十上百条，先按类别缩一轮比一直翻快得多。
           和工单里「从库存选」是同一套（app.wxss 的 .chips/.chip） -->
      <scroll-view wx:if="{{categories.length > 1}}" class="chips" scroll-x enable-flex>
        <view class="chip {{categoryIndex < 0 ? 'chip--on' : ''}}" data-index="-1" bindtap="onPickCategory">全部</view>
        <view
          class="chip {{categoryIndex === index ? 'chip--on' : ''}}"
          wx:for="{{categories}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onPickCategory"
        >{{item}}</view>
      </scroll-view>

      <!-- 列头常驻：列表一滚起来就不知道右边那个数字是什么了 -->
      <view wx:if="{{rows.length}}" class="sku-head sku-head--flat">
        <text class="sku-head__photo">图片</text>
        <text class="sku-head__name">名称</text>
        <text class="sku-head__qty">库存数量</text>
      </view>

      <view wx:if="{{loading}}" class="muted center">加载中…</view>
      <view wx:elif="{{rows.length === 0}}" class="muted center">
        {{keyword || categoryIndex >= 0 || onlyLow || onlyIncomplete ? '没有匹配的材料' : '还没有材料，点右下角新增'}}
      </view>

      <!-- 建过档但还没入过库的材料会被「仅显示有货」整条藏掉，人会以为系统里没这东西 -->
      <view wx:if="{{!loading && onlyStocked && hiddenByStocked}}" class="hidden-tip" bindtap="onShowHidden">
        还有 {{hiddenByStocked}} 条无货的材料被「仅显示有货」挡住了，点这里一并显示
      </view>

      <!-- 一行的样子和工单「从库存选」完全一致：同一批材料在两处要长得一样，
           否则办公室在这儿记住的东西，维修工在工单里认不出来 -->
      <view
        class="card sku-card"
        wx:for="{{rows}}"
        wx:key="materialId"
        data-index="{{index}}"
        bindtap="onOpenDetail"
        hover-class="wo-card--hover"
        hover-stay-time="80"
      >
        <!-- 上半段：图片 / 名称 / 数量 三列，和工单里「从库存选」逐列对齐，
             编辑按钮不放进这三列 —— 试过，它会把名称挤到折行、数量和它挨在一起分不清 -->
        <view class="sku">
          <!--
            图和张数角标必须包在同一个 view 里：wx:else 只认**紧挨着**的那个兄弟节点，
            中间插进来一个带 wx:if 的角标，wx:else 就改去配对角标了 ——
            只有 1 张图时角标条件为假，「无图」灰块反而被渲染出来，一行冒出两个框
            （2026-09-01 反馈）。角标也顺势改成相对这个框定位，不再靠像素硬凑。
          -->
          <view wx:if="{{item.photoUrl}}" class="sku__photo sku__photo--box">
            <image
              class="sku__photo-img"
              src="{{item.photoUrl}}"
              mode="aspectFill"
              data-url="{{item.photoUrl}}"
              data-urls="{{item.photoUrls}}"
              catchtap="onPreviewPhoto"
            />
            <text wx:if="{{item.photoUrls.length > 1}}" class="sku__photo-count">{{item.photoUrls.length}}</text>
          </view>
          <view wx:else class="sku__photo sku__photo--empty">无图</view>

          <view class="sku__body">
            <view class="sku__title">
              {{item.title}}
              <text wx:if="{{!item.enabled}}" class="tag tag--off">停用</text>
            </view>
            <view class="meta">{{item.metaText}}</view>
            <!-- 缺什么直接写出来，别只给一枚看不懂的角标 -->
            <view wx:if="{{item.missingText}}" class="sku__missing">待补充：{{item.missingText}}</view>
          </view>

          <view class="sku__qty {{item.low ? 'sku__qty--low' : ''}}{{item.qty > 0 ? '' : ' sku__qty--none'}}">
            {{item.qtyText}}<text wx:if="{{item.qty > 0}}" class="qty__unit">{{item.unit}}</text>
          </view>
        </view>

        <!-- 编辑独立成一行、靠右：整卡点开是「看分仓存量」，这个按钮是「改这条 SKU」，
             两个动作必须分得开（catchtap 拦住冒泡，点它不会顺带打开详情） -->
        <view wx:if="{{canEdit}}" class="sku-card__foot">
          <view class="sku__edit" data-index="{{index}}" catchtap="onEdit">编辑 SKU</view>
        </view>
      </view>
    </block>

    <!-- ============ 材料 SKU 库：材料档案，不看库存 ============ -->
    <block wx:elif="{{tab === 'sku'}}">
      <input class="input mb" placeholder="搜名称 / 别名 / 型号 / 编码" value="{{skuKeyword}}" bindinput="onSkuKeyword" />

      <scroll-view wx:if="{{skuCategories.length > 1}}" class="chips" scroll-x enable-flex>
        <view class="chip {{skuCategoryIndex < 0 ? 'chip--on' : ''}}" data-index="-1" bindtap="onPickSkuCategory">全部</view>
        <view
          class="chip {{skuCategoryIndex === index ? 'chip--on' : ''}}"
          wx:for="{{skuCategories}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onPickSkuCategory"
        >{{item}}</view>
      </scroll-view>

      <view class="muted sku-count">共 {{skuRows.length}} 条材料档案（含无货和已停用的）</view>

      <view wx:if="{{loading}}" class="muted center">加载中…</view>
      <view wx:elif="{{skuRows.length === 0}}" class="muted center">
        {{skuKeyword || skuCategoryIndex >= 0 ? '没有匹配的材料' : '还没有材料档案'}}
      </view>

      <view
        class="card sku-card"
        wx:for="{{skuRows}}"
        wx:key="materialId"
        data-index="{{index}}"
        data-from="sku"
        bindtap="onOpenDetail"
        hover-class="wo-card--hover"
        hover-stay-time="80"
      >
        <view class="sku">
          <view wx:if="{{item.photoUrl}}" class="sku__photo sku__photo--box">
            <image
              class="sku__photo-img"
              src="{{item.photoUrl}}"
              mode="aspectFill"
              data-url="{{item.photoUrl}}"
              data-urls="{{item.photoUrls}}"
              catchtap="onPreviewPhoto"
            />
            <text wx:if="{{item.photoUrls.length > 1}}" class="sku__photo-count">{{item.photoUrls.length}}</text>
          </view>
          <view wx:else class="sku__photo sku__photo--empty">无图</view>

          <view class="sku__body">
            <view class="sku__title">
              {{item.title}}
              <text wx:if="{{!item.enabled}}" class="tag tag--off">停用</text>
            </view>
            <view class="meta">{{item.metaText}} · {{item.unit}}</view>
            <view class="meta">参考成本 {{item.costText}}{{item.aliasText ? ' · 别名 ' + item.aliasText : ''}}</view>
            <view wx:if="{{item.missingText}}" class="sku__missing">待补充：{{item.missingText}}</view>
          </view>
        </view>

        <view wx:if="{{canEditSku}}" class="sku-card__foot">
          <view class="sku__edit" data-index="{{index}}" data-from="sku" catchtap="onEdit">编辑 SKU</view>
        </view>
      </view>
    </block>

    <!-- ============ 采购申请 ============ -->
    <block wx:elif="{{tab === 'purchase'}}">
      <view wx:if="{{loading}}" class="muted center">加载中…</view>
      <view wx:elif="{{requests.length === 0}}" class="muted center">暂无采购申请</view>

      <view class="card" wx:for="{{requests}}" wx:key="id">
        <view class="row">
          <text class="muted">{{item.requestNo}}</text>
          <text class="status">{{item.statusLabel}}</text>
        </view>
        <view class="items">{{item.itemsText || '（无明细）'}}</view>
        <view class="row mt-sm">
          <text class="muted">{{item.createdAtText}}</text>
          <text class="amount">{{item.amountText}}</text>
        </view>
        <view wx:if="{{item.rejectReason}}" class="reject">驳回原因：{{item.rejectReason}}</view>
      </view>
      <view class="muted center tip">审批操作在「审批」页；下单、入库请在管理后台完成</view>
    </block>
  </block>

  <view wx:if="{{tab === 'stock' && warehouseIndex === 0 && rows.length}}" class="muted center tip">
    「全部仓库」按材料合并显示总量，选具体仓库可看分仓明细
  </view>
</view>

<!-- 两个 tab 都能新增，走的是同一个「先搜再建、当场入库」向导 -->
<button wx:if="{{canView && ((canEdit && tab === 'stock') || (canEditSku && tab === 'sku'))}}" class="fab" bindtap="onCreate">
  <view class="btn__icon icon-action--plus-white"></view><text>新增</text>
</button>

<!-- ============ 详情：只给列表上没有的东西（分仓存量 / 别名 / 参数 / 成本） ============ -->
<view wx:if="{{detailOpen}}" class="sheet-mask" bindtap="onCloseDetail" catchtouchmove="noop" />
<view wx:if="{{detailOpen}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">{{detail.title}}</text>
    <text class="sheet__close" bindtap="onCloseDetail">关闭</text>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <view wx:if="{{detail.photoUrls.length}}" class="photo-strip">
      <image
        wx:for="{{detail.photoUrls}}"
        wx:key="*this"
        class="photo-strip__item"
        src="{{item}}"
        mode="aspectFill"
        data-url="{{item}}"
        data-urls="{{detail.photoUrls}}"
        catchtap="onPreviewPhoto"
      />
    </view>

    <view class="label">分仓库存</view>
    <view wx:if="{{!detailStocks.length}}" class="muted">公司还没有建仓库</view>
    <view wx:for="{{detailStocks}}" wx:key="name" class="wh-row">
      <text class="wh-row__name">{{item.name}}</text>
      <text class="wh-row__qty {{item.low ? 'wh-row__qty--low' : ''}}">{{item.qtyText}}</text>
    </view>

    <view class="label mt">资料</view>
    <view class="kv"><text class="kv__k">编码</text><text class="kv__v">{{detail.code}}</text></view>
    <view class="kv"><text class="kv__k">类别单位</text><text class="kv__v">{{detail.category}} · {{detail.unit}}</text></view>
    <view class="kv"><text class="kv__k">参考成本</text><text class="kv__v">{{detail.costText}}</text></view>
    <view class="kv"><text class="kv__k">别名</text><text class="kv__v">{{detail.aliasText || '未填'}}</text></view>
    <view class="kv"><text class="kv__k">详细参数</text><text class="kv__v">{{detail.params || '未填'}}</text></view>
  </scroll-view>

  <view class="sheet__foot">
    <button wx:if="{{canEdit}}" class="btn btn--primary" bindtap="onEdit">
      <view class="btn__icon icon-action--wrench-white"></view><text>编辑这条 SKU</text>
    </button>
    <button wx:else class="btn btn--ghost" bindtap="onCloseDetail">知道了</button>
  </view>
</view>

<!-- ============ 新增 / 编辑 SKU ============ -->
<view wx:if="{{editorOpen}}" class="sheet-mask sheet-mask--top" bindtap="onCloseEditor" catchtouchmove="noop" />
<view wx:if="{{editorOpen}}" class="sheet sheet--top" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">{{form.id ? '编辑材料' : '新增材料'}}</text>
    <text class="sheet__close" bindtap="onCloseEditor">关闭</text>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <!-- 照片放第一位：补照片是这一屏最常干的事，别让人划到最底下才看见 -->
    <view class="field">
      <view class="label">实物照片<text class="label__opt">最多 4 张，维修工靠它认货</text></view>
      <view class="photo-grid">
        <view class="photo-grid__cell" wx:for="{{form.photoUrls}}" wx:key="*this">
          <image
            class="photo-grid__img"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            data-urls="{{form.photoUrls}}"
            catchtap="onPreviewPhoto"
          />
          <view class="photo-grid__del" data-index="{{index}}" catchtap="onRemovePhoto">×</view>
          <view wx:if="{{index === 0}}" class="photo-grid__cover">封面</view>
        </view>
        <view
          wx:if="{{form.photoUrls.length < 4}}"
          class="photo-grid__add"
          bindtap="onChoosePhoto"
        >
          <text class="photo-grid__plus">{{uploading ? '…' : '+'}}</text>
          <text class="photo-grid__hint">{{form.photoUrls.length}}/4</text>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="label">名称</view>
      <input class="input" placeholder="如：PVC 管" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
      <view class="field-error" wx:if="{{errors.name}}">{{errors.name}}</view>
    </view>

    <view class="field">
      <view class="label">型号<text class="label__opt">选填</text></view>
      <input class="input" placeholder="如：DN50" value="{{form.spec}}" data-field="spec" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="label">类别</view>
      <!-- 类别在后台「库存与采购 → 基础资料 → 材料类别」维护；拿不到就说清楚去哪儿加。
           注释写在 wx:if 之前：wx:if / wx:else 之间不放任何东西，免得下次又被插断 -->
      <picker wx:if="{{formCategories.length}}" mode="selector" range="{{formCategories}}" bindchange="onFormCategory">
        <view class="picker {{formCategoryIndex < 0 ? 'placeholder' : ''}}">
          {{formCategoryIndex < 0 ? '选择类别（决定编码前缀）' : form.category}}
        </view>
      </picker>
      <view wx:else class="field-error">还没有可选的材料类别，请办公室在管理后台「库存与采购 → 基础资料 → 材料类别」里先添加</view>
    </view>

    <view class="field">
      <view class="label">单位</view>
      <picker mode="selector" range="{{units}}" value="{{unitIndex}}" bindchange="onFormUnit">
        <view class="picker">{{form.unit}}</view>
      </picker>
      <view class="field-error" wx:if="{{errors.unit}}">{{errors.unit}}</view>
    </view>

    <view class="field">
      <view class="label">参考成本（元）<text class="label__opt">采购按它估价，入库后自动按均价刷新</text></view>
      <input class="input" type="digit" placeholder="0.00" value="{{form.costYuan}}" data-field="costYuan" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="label">别名<text class="label__opt">同物异名，顿号分隔</text></view>
      <input class="input" placeholder="如：胶布、透明胶" value="{{form.aliases}}" data-field="aliases" bindinput="onFormInput" />
    </view>

    <view class="field">
      <view class="label">详细参数<text class="label__opt">选填</text></view>
      <textarea class="textarea" placeholder="材质 / 尺寸 / 技术参数等" value="{{form.params}}" data-field="params" bindinput="onFormInput" />
    </view>

    <view class="field field--row">
      <view class="label">启用</view>
      <switch checked="{{form.enabled}}" bindchange="onToggleEnabled" />
    </view>
  </scroll-view>

  <view class="sheet__foot">
    <button class="btn btn--primary" loading="{{saving}}" disabled="{{saving || uploading}}" bindtap="onSave">
      <view class="btn__icon icon-action--check-white"></view><text>保存</text>
    </button>
  </view>
</view>
