.tabs {
  display: flex;
  background: var(--color-card-bg);
  border-radius: var(--radius-md);
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
}
.tab--on { background: var(--color-brand); color: #fff; font-weight: 500; }

.toolbar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.picker-wrap { flex: 1; }
.picker {
  box-sizing: border-box;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  background: var(--color-card-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-lg);
}
.chip {
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: var(--color-card-bg);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  white-space: nowrap;
}
.chip--on { border-color: var(--color-warning); color: var(--color-warning); }

.mb { margin-bottom: 20rpx; }
/* .center 在 app.wxss 里统一定义 */
.tip { padding: 24rpx 16rpx 0; line-height: 1.6; }
.mt-xs { margin-top: 8rpx; }

.row-card { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 24rpx; }
.row-card__body { flex: 1; min-width: 0; }
.row-card__title { font-size: var(--font-xl); font-weight: 500; line-height: 1.5; }
.qty {
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.qty--low { color: var(--color-danger); }
.qty__unit { font-size: var(--font-sm); font-weight: 400; color: var(--color-text-tertiary); margin-left: 6rpx; }

.status { font-size: var(--font-md); color: var(--color-brand); }
.items { font-size: var(--font-lg); margin-top: 16rpx; line-height: 1.6; }
.amount { font-size: var(--font-2xl); font-weight: 600; font-variant-numeric: tabular-nums; }
.reject { margin-top: 12rpx; font-size: var(--font-md); color: var(--color-danger); line-height: 1.6; }
