.count-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.count-head { padding: 24rpx; background: #f7fbff; border-bottom: 2rpx solid #dbe5ee; }
.count-head__row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.count-head__warehouse { color: var(--color-brand-dark); font-size: var(--font-lg); font-weight: 600; }
.count-head__no { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: var(--font-xs); }
.count-head__progress { color: var(--color-brand); font-size: var(--font-xl); font-weight: 600; font-variant-numeric: tabular-nums; }
.progress { height: 12rpx; margin-top: 18rpx; overflow: hidden; border-radius: 999rpx; background: #dfe9f2; }
.progress__bar { height: 100%; border-radius: 999rpx; background: var(--color-brand); }
.search-row { display: flex; gap: 16rpx; padding: 20rpx 24rpx 12rpx; }
.search-input { flex: 1; min-width: 0; height: 88rpx; line-height: 88rpx; font-size: var(--font-md); }
.scan-btn { width: 136rpx !important; height: 88rpx; margin: 0 !important; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: var(--color-brand); color: #fff; font-size: var(--font-md); }
.scan-btn::after { border: none; }
.uncounted { display: flex; justify-content: space-between; align-items: center; padding: 0 28rpx 16rpx; color: var(--color-text-secondary); font-size: var(--font-sm); }
.uncounted text { color: var(--color-brand); padding: 12rpx; }
.result-strip { box-sizing: border-box; width: 100%; padding: 0 24rpx 18rpx; white-space: nowrap; }
.result-chip { display: inline-flex; flex-direction: column; max-width: 300rpx; margin-right: 14rpx; padding: 14rpx 20rpx; border: 2rpx solid var(--color-border); border-radius: 18rpx; background: #fff; color: var(--color-text); font-size: var(--font-sm); overflow: hidden; }
.result-chip--on { border-color: var(--color-brand); background: #edf5fb; color: var(--color-brand-dark); }
.result-chip__state { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: var(--font-xs); }
.count-container { padding-top: 4rpx; }
.page-error { margin: 24rpx; }
.material-card { padding-bottom: 0; overflow: hidden; }
.material-row { display: flex; gap: 22rpx; padding-bottom: 26rpx; }
.material-photo { width: 136rpx; height: 136rpx; flex-shrink: 0; border-radius: 20rpx; background: var(--color-bg); }
.material-photo--empty { display: flex; align-items: center; justify-content: center; color: var(--color-text-tertiary); font-size: var(--font-sm); }
.material-info { flex: 1; min-width: 0; }
.material-title { color: var(--color-text); font-size: var(--font-2xl); font-weight: 600; line-height: 1.4; }
.material-code { margin-top: 8rpx; color: var(--color-text-secondary); font-size: var(--font-sm); }
.location-tag { display: inline-flex; margin-top: 14rpx; padding: 7rpx 15rpx; border-radius: 999rpx; background: #edf3f8; color: var(--color-brand-dark); font-size: var(--font-sm); }
.book-row { display: flex; align-items: center; justify-content: space-between; margin: 0 -28rpx; padding: 22rpx 28rpx; border-top: 2rpx solid var(--color-hairline); background: #f6f9fb; }
.book-row__label { color: var(--color-text-secondary); font-size: var(--font-md); }
.book-row__hint { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: var(--font-xs); }
.book-row__qty { color: var(--color-brand-dark); font-size: 48rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.book-row__qty text { margin-left: 6rpx; font-size: var(--font-md); font-weight: 400; }
.count-card { margin-bottom: 0; }
.stepper { display: grid; grid-template-columns: 112rpx 1fr 112rpx; height: 120rpx; }
.stepper__btn { width: 112rpx !important; height: 120rpx; margin: 0 !important; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #e9f1f8; color: var(--color-brand); font-size: 52rpx; font-weight: 500; }
.stepper__btn::after { border: none; }
.stepper__input { height: 120rpx; margin: 0 14rpx; text-align: center; border: 3rpx solid var(--color-brand); border-radius: 22rpx; background: #fff; color: var(--color-text); font-size: 58rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.quick-row { display: flex; gap: 16rpx; margin-top: 18rpx; }
/* 居中写在类自己身上（同 .field-action：只靠 app.wxss 的 button{} 文字会贴上沿） */
.quick-btn { width: auto !important; height: 72rpx; flex: 1; margin: 0 !important; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; line-height: 1.35; border: 2rpx solid #b8cfe2; border-radius: 18rpx; background: #f7fbff; color: var(--color-brand); font-size: var(--font-sm); }
.quick-btn::after { border: none; }
.difference-box { margin-top: 28rpx; padding: 24rpx; border-radius: 22rpx; border: 2rpx solid transparent; }
.difference-box--same { background: #edf8f2; border-color: #b7dfca; }
.difference-box--plus { background: #fff7e6; border-color: #ffd591; }
.difference-box--minus { background: #fff1f0; border-color: #ffccc7; }
.difference-box__title { font-size: var(--font-xl); font-weight: 600; }
.difference-box--same .difference-box__title { color: var(--color-success); }
.difference-box--plus .difference-box__title { color: #ad6800; }
.difference-box--minus .difference-box__title { color: var(--color-danger); }
.difference-box__desc { margin-top: 8rpx; color: var(--color-text-secondary); font-size: var(--font-sm); }
.difference-field { margin-top: 28rpx; }
.picker--placeholder { color: var(--color-text-tertiary); }
.note-input { box-sizing: border-box; width: 100%; height: 160rpx; padding: 20rpx 24rpx; font-size: var(--font-md); }
.photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-wrap { position: relative; width: 132rpx; height: 132rpx; }
.photo { width: 100%; height: 100%; border-radius: 18rpx; }
.photo-remove { position: absolute; top: -10rpx; right: -10rpx; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: rgba(0,0,0,.62); color: #fff; font-size: var(--font-md); }
.photo-add { width: 132rpx; height: 132rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #aac3d8; border-radius: 18rpx; background: #f7fbff; color: var(--color-brand); font-size: var(--font-sm); }
.count-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 8; display: flex; gap: 18rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--color-hairline); background: rgba(255,255,255,.97); box-shadow: 0 -8rpx 24rpx rgba(20,48,78,.08); }
.count-actions .btn { height: 96rpx; }
.previous-btn { flex: 0 0 190rpx !important; width: 190rpx !important; }
.save-btn { flex: 1 !important; width: auto !important; }
