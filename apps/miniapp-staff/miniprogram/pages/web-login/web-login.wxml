<view class="container">
  <view wx:if="{{loading}}" class="card state">
    <view class="brand-mark brand-mark--loading"></view>
    <view class="state__title">正在验证授权请求</view>
    <view class="state__text">请稍候，不要重复扫描二维码</view>
  </view>

  <!-- 失败/过期：说清原因，别只给一句「失败」 -->
  <block wx:elif="{{errorMsg}}">
    <view class="card state">
      <view class="state__icon state__icon--warn"></view>
      <view class="state__title">无法确认登录</view>
      <view class="state__text">{{errorMsg}}</view>
    </view>
    <view class="result-actions">
      <button class="btn btn--primary" bindtap="onCloseMiniProgram">关闭小程序</button>
    </view>
    <view wx:if="{{closeHint}}" class="close-hint">{{closeHint}}</view>
  </block>

  <!-- 已处理完 -->
  <block wx:elif="{{done}}">
    <view class="card state">
      <view class="state__icon {{done === 'confirmed' ? 'state__icon--ok' : 'state__icon--warn'}}"></view>
      <view class="state__title">{{done === 'confirmed' ? '授权成功' : '已拒绝这次登录'}}</view>
      <view class="state__text">
        {{done === 'confirmed'
          ? '电脑正在进入目标系统。本页会自动关闭。'
          : '网页那边不会登录。如果这次登录不是你发起的，建议把后台密码改一下。'}}
      </view>
    </view>
    <view class="result-actions">
      <button class="btn btn--primary" bindtap="onCloseMiniProgram">关闭小程序</button>
    </view>
    <view wx:if="{{closeHint}}" class="close-hint">{{closeHint}}</view>
  </block>

  <!-- 确认 -->
  <block wx:else>
    <view class="auth-hero">
      <view class="brand-mark"></view>
      <view class="eyebrow">内网应用 · 安全授权</view>
      <view class="lead__title">{{bindingRequired ? '首次绑定' : '允许登录'}}{{info.applicationName}}？</view>
      <view class="lead__sub">{{bindingRequired ? '验证一次原系统账号，后续扫码确认即可进入。' : '确认后，这台电脑会使用你的授权进入应用。'}}</view>
    </view>

    <view class="card auth-card">
      <view class="app-chip">
        <view class="app-chip__icon"></view>
        <view class="app-chip__body">
          <view class="app-chip__name">{{info.applicationName}}</view>
          <view wx:if="{{info.applicationHostname}}" class="app-chip__host">{{info.applicationHostname}}</view>
        </view>
      </view>
      <view class="auth-meta">
        <view class="auth-meta__item">
          <view class="auth-meta__label">授权身份</view>
          <view class="auth-meta__value">{{info.me.name || '本人'}}<text wx:if="{{info.me.roleLabel}}"> · {{info.me.roleLabel}}</text></view>
        </view>
        <view class="auth-meta__item">
          <view class="auth-meta__label">登录设备</view>
          <view class="auth-meta__value">{{deviceText}}</view>
        </view>
        <view class="auth-meta__item">
          <view class="auth-meta__label">发起时间</view>
          <view class="auth-meta__value">{{timeText}}</view>
        </view>
      </view>
      <view wx:if="{{bindingRequired}}" class="binding-form">
        <view class="binding-form__intro">账号密码只用于代你登录此应用，并会加密保存。</view>
        <view class="form-field">
          <label class="form-label" for="binding-username">公寓系统用户名</label>
          <input id="binding-username" class="form-input" value="{{bindingUsername}}" maxlength="120" placeholder="请输入用户名" bindinput="onUsernameInput" />
        </view>
        <view class="form-field">
          <label class="form-label" for="binding-password">公寓系统密码</label>
          <view class="password-field">
            <input id="binding-password" class="form-input password-field__input" value="{{bindingPassword}}" password="{{!showPassword}}" maxlength="200" placeholder="请输入密码" confirm-type="done" bindinput="onPasswordInput" bindconfirm="onBindAndConfirm" />
            <button class="password-toggle" disabled="{{submitting}}" bindtap="onTogglePassword">{{showPassword ? '隐藏' : '显示'}}</button>
          </view>
        </view>
        <view wx:if="{{bindingError}}" class="form-error" role="alert">{{bindingError}}</view>
      </view>
    </view>

    <view class="security-note"><view class="security-note__icon"></view><text>请确认这是你正在使用的应用与域名；不是本人操作请立即拒绝。</text></view>

    <view class="btn-group">
      <button wx:if="{{bindingRequired}}" class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onBindAndConfirm">
        <view class="btn__icon icon-action--check-white"></view><text>验证并绑定</text>
      </button>
      <button wx:else class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onConfirm">
        <view class="btn__icon icon-action--check-white"></view><text>确认并进入</text>
      </button>
      <button class="btn btn--outline" disabled="{{submitting}}" bindtap="onCancel">
        <view class="btn__icon icon-action--close-gray"></view><text>不是我</text>
      </button>
    </view>
  </block>
</view>
