.note-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.note-scope { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 72rpx; margin-bottom: 24rpx; color: #527096; font-size: var(--font-sm); }
.note-scope__text { flex: 1; min-width: 0; }
.note-scope__dot { margin: 0 12rpx; }
.editor-card, .block-editor { padding: 28rpx; }
.field-label, .add-tools__title { font-size: var(--font-sm); font-weight: 700; color: var(--color-text-secondary); }
.title-input { margin-top: 18rpx; min-height: 86rpx; font-size: var(--font-xl); font-weight: 650; border-bottom: 2rpx solid #dce6ef; }
.block-editor__top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.block-kind { padding: 4rpx 14rpx; border-radius: 999rpx; background: #eaf1f8; color: #31558a; font-size: var(--font-xs); }
.block-actions { display: flex; gap: 24rpx; color: #527096; font-size: var(--font-xs); }
.block-actions .danger { color: var(--color-danger); }
.block-text { width: 100%; min-height: 140rpx; box-sizing: border-box; padding: 20rpx; border-radius: 14rpx; background: #f6f8fa; font-size: var(--font-lg); line-height: 1.75; }
.block-text--heading { font-weight: 700; }
.block-text--warning { background: #fff7e6; border-left: 8rpx solid #faad14; }
.voice-btn { margin-top: 18rpx; border: 2rpx solid #9db1c6; border-radius: 999rpx; background: #fff; color: #31558a; font-size: var(--font-sm); }
.voice-btn--on { background: #31558a; color: #fff; }
.editor-image, .reader-image { width: 100%; border-radius: 16rpx; background: #edf1f5; }
.editor-image { height: 360rpx; }
.caption-input { margin-top: 14rpx; min-height: 70rpx; border-bottom: 2rpx solid #dce6ef; }
.add-tools { margin: 30rpx 0; }
.add-tools__buttons { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.add-tools__buttons button { margin: 0; padding: 0 22rpx; min-height: 74rpx; line-height: 74rpx; border-radius: 999rpx; background: #fff; border: 2rpx solid #b9cada; color: #31558a; font-size: var(--font-sm); }
.add-tools__buttons button::after { border: none; }
.save-btn, .edit-btn { margin-top: 30rpx; min-height: 92rpx; line-height: 92rpx; border: none; border-radius: 18rpx; background: #31558a; color: #fff; font-size: var(--font-lg); font-weight: 700; }
.reader-title { margin: 20rpx 0 36rpx; font-size: 46rpx; font-weight: 750; line-height: 1.35; color: var(--color-text); }
.reader-block { margin: 24rpx 0; font-size: var(--font-lg); line-height: 1.85; color: var(--color-text); }
.reader-block--heading { margin-top: 40rpx; font-size: var(--font-2xl); font-weight: 750; }
.reader-block--bullet { padding-left: 12rpx; }
.reader-block--warning { padding: 24rpx; border-left: 8rpx solid #faad14; border-radius: 12rpx; background: #fff7e6; }
.reader-caption { margin-top: 8rpx; text-align: center; color: var(--color-text-tertiary); font-size: var(--font-sm); }
