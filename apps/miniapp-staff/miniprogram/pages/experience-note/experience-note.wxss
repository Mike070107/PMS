.note-page { padding-bottom:calc(36rpx + env(safe-area-inset-bottom)); }
.note-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; min-height:88rpx; }
.note-head__meta { flex:1; min-width:0; font-size:26rpx; line-height:1.6; color:var(--color-text-tertiary); word-break:break-all; }
.note-head__actions { display:flex; flex:none; gap:4rpx; }
.quiet-button { min-height:88rpx; margin:0; padding:0 16rpx; background:transparent; color:var(--color-brand,#31558a); font-size:28rpx; }
.title-input { min-height:112rpx; height:112rpx; margin:16rpx 0; width:100%; box-sizing:border-box; font-size:42rpx; font-weight:650; color:var(--color-text); }
.document-editor { overflow:hidden; border:2rpx solid #dce5ef; border-radius:16rpx; background:#fff; }
.document-toolbar { width:100%; white-space:nowrap; border-bottom:2rpx solid #dce5ef; background:#f3f6fa; }
.document-toolbar__inner { display:flex; width:max-content; gap:8rpx; padding:8rpx; }
.document-toolbar button { flex:none; min-width:88rpx; min-height:88rpx; margin:0; padding:0 18rpx; border-radius:10rpx; background:transparent; color:var(--color-brand,#31558a); font-size:28rpx; }
.format-bold { font-weight:800; }.format-italic { font-style:italic; }
.document-editor__body { box-sizing:border-box; min-height:660rpx; padding:28rpx; color:var(--color-text); font-size:32rpx; line-height:1.8; }
.voice-btn { min-height:88rpx; margin-top:20rpx; border:2rpx solid #a7bbd1; border-radius:16rpx; background:#fff; color:var(--color-brand,#31558a); font-size:32rpx; }
.voice-btn--on { background:var(--color-brand,#31558a); color:#fff; }
.save-bar { position:sticky; bottom:0; display:flex; align-items:center; gap:20rpx; padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background:var(--color-bg,#f5f7fa); }
.save-status { flex:1; min-width:0; color:var(--color-text-tertiary); font-size:26rpx; line-height:1.5; }
.save-btn,.edit-btn,.share-save { min-height:96rpx; margin:0; padding:0 36rpx; border-radius:16rpx; background:var(--color-brand,#31558a); color:#fff; font-size:34rpx; font-weight:650; }
.reader-title { margin:30rpx 0 14rpx; color:var(--color-text); font-size:46rpx; font-weight:700; line-height:1.4; word-break:break-all; }
.reader-author { color:var(--color-text-tertiary); font-size:26rpx; }
.reader-block { margin:28rpx 0; color:var(--color-text); font-size:32rpx; line-height:1.85; word-break:break-all; }
.reader-document { display:block; font-size:32rpx; line-height:1.85; overflow:hidden; }
.table-notice { margin-top:24rpx; padding:20rpx; border-radius:12rpx; background:#edf4fa; color:var(--color-brand,#31558a); font-size:14px; line-height:1.7; }
.table-notice text { display:block; }
.reader-table-scroll { display:block; width:100%; min-width:0; }
.reader-document--table { overflow:visible; padding-bottom:12rpx; }
.reader-document img,.reader-image { max-width:100%; width:100%; border-radius:14rpx; background:#eaf0f7; }
.reader-caption { font-size:26rpx; color:var(--color-text-tertiary); }
.reader-block--heading { font-size:40rpx; font-weight:650; }
.reader-block--quote,.reader-block--warning { padding:20rpx; border-left:6rpx solid #9ab1ca; background:#f2f6fa; }
.reader-line { display:flex; align-items:flex-start; gap:14rpx; }
.reader-rich { flex:1; min-width:0; }.reader-marker { color:var(--color-brand,#31558a); }
.reader-check { flex:none; width:30rpx; height:30rpx; border:2rpx solid #8b9fb6; border-radius:6rpx; margin-top:14rpx; }.reader-check.is-checked { background:var(--color-brand,#31558a); }
.reader-divider { margin:32rpx 0; border-top:2rpx solid #dce5ef; }
.reader-actions { display:flex; gap:16rpx; margin:32rpx 0; }.reader-actions button { flex:1; min-width:0; }
.delete-btn { min-height:96rpx; margin:0; background:#fff; border:2rpx solid #d6a5a9; border-radius:16rpx; color:#a8323b; font-size:32rpx; }
.asset-tip { display:flex; align-items:center; justify-content:space-between; gap:12rpx; color:var(--color-text-tertiary); font-size:26rpx; }.asset-tip text { flex:1; min-width:0; }
.note-state { padding:56rpx 0; color:var(--color-text-secondary); text-align:center; font-size:32rpx; }
.inline-error,.image-warning { margin:16rpx 0; padding:20rpx; border-radius:12rpx; background:#fff3f3; color:#a8323b; font-size:28rpx; line-height:1.65; word-break:break-all; }
.share-overlay { position:fixed; z-index:200; inset:0; display:flex; align-items:flex-end; background:rgba(20,36,57,.45); }
.share-sheet { width:100%; max-height:88vh; display:flex; flex-direction:column; overflow:hidden; border-radius:28rpx 28rpx 0 0; background:#fff; box-sizing:border-box; }
.share-head { display:flex; justify-content:space-between; align-items:center; gap:16rpx; padding:12rpx 28rpx; border-bottom:2rpx solid #e1e8ef; }
.share-title { font-size:36rpx; font-weight:650; }
.share-body { height:52vh; min-height:0; box-sizing:border-box; padding:24rpx 28rpx; }
.visibility-options { display:flex; gap:16rpx; }.visibility-options button { flex:1; min-width:0; }
.share-choice { min-height:88rpx; max-width:100%; margin:0; padding:14rpx 22rpx; box-sizing:border-box; border:2rpx solid #d4e0ec; border-radius:14rpx; background:#fff; color:var(--color-text-secondary); font-size:30rpx; word-break:break-all; white-space:normal; }
.share-choice.is-selected { border-color:var(--color-brand,#31558a); background:#edf3fa; color:var(--color-brand,#31558a); }
.share-label { margin:30rpx 0 16rpx; font-size:32rpx; font-weight:650; }
.share-choices { display:flex; flex-wrap:wrap; gap:14rpx; }
.share-hint { margin:18rpx 0; font-size:26rpx; line-height:1.65; color:var(--color-text-tertiary); }
.share-switch { min-height:104rpx; display:flex; align-items:center; justify-content:space-between; gap:16rpx; border-top:2rpx solid #e1e8ef; font-size:32rpx; }.share-switch text { flex:1; min-width:0; }.share-switch switch { flex:none; }
.share-footer { padding:20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); border-top:2rpx solid #e1e8ef; }.share-save { width:100%; }
.note-page button,.share-sheet button { display:flex; align-items:center; justify-content:center; box-sizing:border-box; line-height:1.2; }
.note-page button::after,.share-sheet button::after { border:0; }
/* 小屏不以rpx缩小实际点击区，仍保证44 CSS px。 */
@media (max-width:374px) {
  .note-page button,.share-sheet button { min-height:44px; min-width:44px; }
  .note-page .title-input,.share-switch { min-height:44px; }
}
