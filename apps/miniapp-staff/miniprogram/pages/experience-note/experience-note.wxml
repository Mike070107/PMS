<view class="container note-page">
  <view class="note-scope">
    <view class="note-scope__text"><text>{{officeName || '所属管理处'}}</text><text class="note-scope__dot">·</text><text>{{repairTypeLabel || repairType}}</text></view>
    <!-- 收藏：列表页默认只摊开收藏过的帖子 -->
    <view wx:if="{{noteId && !editing}}" class="star {{favorite ? 'star--on' : ''}}" bindtap="onToggleFavorite"></view>
  </view>

  <block wx:if="{{editing}}">
    <view class="card editor-card">
      <view class="field-label">笔记标题</view>
      <input class="title-input" maxlength="160" placeholder="例如：单元门门禁无响应的排查方法" value="{{title}}" bindinput="onTitleInput" />
    </view>

    <view class="editor-mode" aria-label="编辑方式">
      <view class="editor-mode__option {{editorMode === 'visual' ? 'is-active' : ''}}" data-mode="visual" bindtap="onSwitchEditorMode">可视化</view>
      <view class="editor-mode__option {{editorMode === 'markdown' ? 'is-active' : ''}}" data-mode="markdown" bindtap="onSwitchEditorMode">Markdown</view>
    </view>

    <block wx:if="{{editorMode === 'visual'}}">
      <view class="add-tools add-tools--top">
        <view class="add-tools__title">添加内容</view>
        <scroll-view class="add-tools__scroll" scroll-x enable-flex>
          <view class="add-tools__buttons add-tools__buttons--row">
            <button data-type="paragraph" bindtap="onAddBlock">正文</button>
            <button data-type="heading" bindtap="onAddBlock">小标题</button>
            <button data-type="bullet" bindtap="onAddBlock">项目符号</button>
            <button data-type="ordered" bindtap="onAddBlock">编号步骤</button>
            <button data-type="checklist" bindtap="onAddBlock">待办项</button>
            <button data-type="quote" bindtap="onAddBlock">引用</button>
            <button data-type="warning" bindtap="onAddBlock">注意事项</button>
            <button bindtap="onAddImage">图片</button>
            <button data-type="divider" bindtap="onAddBlock">分隔线</button>
          </view>
        </scroll-view>
      </view>

      <view wx:for="{{blocks}}" wx:key="id" class="card block-editor block-editor--{{item.type}}">
        <view class="block-editor__top">
          <text class="block-kind">{{item.type === 'heading' ? '小标题' : item.type === 'bullet' ? '项目符号' : item.type === 'ordered' ? '编号步骤' : item.type === 'checklist' ? '待办项' : item.type === 'quote' ? '引用' : item.type === 'warning' ? '注意事项' : item.type === 'divider' ? '分隔线' : item.type === 'image' ? '图片' : '正文'}}</text>
          <view class="block-actions">
            <text data-index="{{index}}" data-delta="-1" bindtap="onMoveBlock">上移</text>
            <text data-index="{{index}}" data-delta="1" bindtap="onMoveBlock">下移</text>
            <text class="danger" data-index="{{index}}" bindtap="onRemoveBlock">删除</text>
          </view>
        </view>
        <block wx:if="{{item.type === 'image'}}">
          <image class="editor-image" src="{{item.url}}" mode="aspectFit" data-url="{{item.url}}" bindtap="onPreview" />
          <input class="caption-input" placeholder="图片说明（可不填）" value="{{item.caption}}" data-index="{{index}}" bindinput="onCaptionInput" />
        </block>
        <view wx:elif="{{item.type === 'divider'}}" class="divider-preview"><text>分隔线</text></view>
        <block wx:else>
          <view wx:if="{{item.type === 'checklist'}}" class="check-toggle" data-index="{{index}}" bindtap="onToggleCheck"><view class="check-toggle__box {{item.checked ? 'is-checked' : ''}}"></view><text>{{item.checked ? '已完成' : '未完成'}}</text></view>
          <textarea class="block-text block-text--{{item.type}}" auto-height maxlength="4000" placeholder="{{item.type === 'warning' ? '写容易忽略、安全风险或返工点' : item.type === 'ordered' ? '写一个操作步骤' : item.type === 'checklist' ? '写需要确认的事项' : item.type === 'quote' ? '写引用或现场原话' : '写维修经验'}}" value="{{item.text}}" data-index="{{index}}" bindinput="onTextInput"></textarea>
          <view class="inline-hint">支持 **加粗**、*斜体*、`代码` 和网页链接</view>
          <button wx:if="{{hasSpeech}}" class="voice-btn {{(recording || pressing) && speechIndex === index ? 'voice-btn--on' : ''}}" data-index="{{index}}" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord" catchtouchmove="onHoldMove">{{recording && speechIndex === index ? '松开结束' : (pressing && speechIndex === index ? '正在准备…' : '按住说话，自动转文字')}}</button>
        </block>
      </view>
    </block>

    <view wx:else class="markdown-editor">
      <view class="markdown-editor__tip">可以粘贴 Markdown；支持标题、编号、项目符号、待办、引用、警示块、图片和分隔线。切回“可视化”即可查看排版。</view>
      <textarea class="markdown-source" maxlength="60000" placeholder="## 排查方法&#10;&#10;1. 检查电源&#10;2. 检查线路&#10;&#10;> [!WARNING]&#10;> 操作前先断电" value="{{markdownSource}}" bindinput="onMarkdownInput"></textarea>
    </view>
    <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">保存维修经验</button>
  </block>

  <block wx:else>
    <view class="reader-title">{{title}}</view>
    <view wx:for="{{readerBlocks}}" wx:key="id" class="reader-block reader-block--{{item.type}}">
      <block wx:if="{{item.type === 'image'}}">
        <image class="reader-image" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bindtap="onPreview" />
        <view wx:if="{{item.caption}}" class="reader-caption">{{item.caption}}</view>
      </block>
      <view wx:elif="{{item.type === 'divider'}}" class="reader-divider"></view>
      <view wx:else class="reader-line">
        <text wx:if="{{item.type === 'bullet'}}" class="reader-marker">•</text>
        <text wx:if="{{item.type === 'ordered'}}" class="reader-marker">{{item.order}}.</text>
        <view wx:if="{{item.type === 'checklist'}}" class="reader-check {{item.checked ? 'is-checked' : ''}}"></view>
        <rich-text class="reader-rich" nodes="{{item.html}}"></rich-text>
      </view>
    </view>
    <view class="reader-actions">
      <button class="copy-btn" bindtap="onCopyMarkdown">复制 Markdown</button>
      <button wx:if="{{canEdit}}" class="edit-btn" bindtap="onEdit">编辑这篇经验</button>
    </view>
  </block>
</view>
