<!--
  公寓收费工作台（员工端）。绑定名一律对应 apartment-cashier.ts 的 data / 方法。
  手机上只做「收一笔、出一张、看这间房交过什么」；补打和红冲在网站后台办。
-->
<view class="container {{activeTab === 'charge' && placeText ? 'container--with-bar' : ''}}">
  <view wx:if="{{loading}}" class="muted center">加载中…</view>

  <!-- 没有这一格权限就把原因说清楚，不要静默空白 -->
  <view wx:elif="{{!canSeeCashier}}" class="card">
    <view class="card__title">公寓收费工作台</view>
    <view class="muted mt-sm">
      你的角色还没有「公寓收费工作台」这一格权限，所以看不到房间和收费。需要的话请办公室在管理后台
      「系统设置 → 角色权限」里给你的角色勾上它。
    </view>
  </view>

  <block wx:else>
    <view class="screen-head screen-head--help">
      <view class="screen-head__title">公寓收费工作台</view>
      <view wx:if="{{guide}}" class="screen-head__desc">所属公寓默认带入 → 选房间 → 点项目自动带价 → 核对收款</view>
      <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
    </view>

    <view wx:if="{{error}}" class="card"><view class="field-error">{{error}}</view></view>

    <!-- ============ 1 选房间 ============ -->
    <view class="card">
      <view class="field">
        <view class="label address-label"><text class="address-label__name">公寓</text><text class="label__opt">唯一所属自动选择，多公寓记住本人上次选择</text></view>
        <picker mode="selector" range="{{communityNames}}" value="{{communityIndex}}" bindchange="onPickCommunity">
          <view class="picker {{communityIndex < 0 ? 'placeholder' : ''}}">
            {{communityIndex < 0 ? '选择小区' : communityNames[communityIndex]}}
          </view>
        </picker>
      </view>

      <view class="field">
        <view class="label">楼栋</view>
        <picker
          wx:if="{{buildingNames.length}}"
          mode="selector"
          range="{{buildingNames}}"
          value="{{buildingIndex}}"
          bindchange="onPickBuilding"
        >
          <view class="picker {{buildingIndex < 0 ? 'placeholder' : ''}}">
            {{buildingIndex < 0 ? '选择楼栋' : buildingNames[buildingIndex]}}
          </view>
        </picker>
        <view wx:elif="{{loadingBuildings}}" class="picker placeholder">加载中…</view>
        <view wx:elif="{{communityIndex >= 0}}" class="muted">这个小区下还没有楼栋档案</view>
        <view wx:else class="picker placeholder">先选小区</view>
      </view>

      <view class="field">
        <view class="label">房号</view>
        <picker
          wx:if="{{houseNames.length}}"
          mode="selector"
          range="{{houseNames}}"
          value="{{houseIndex}}"
          bindchange="onPickHouse"
        >
          <view class="picker {{houseIndex < 0 ? 'placeholder' : ''}}">
            {{houseIndex < 0 ? '选择房号' : houseNames[houseIndex]}}
          </view>
        </picker>
        <view wx:elif="{{loadingHouses}}" class="picker placeholder">加载中…</view>
        <view wx:elif="{{buildingIndex >= 0}}" class="muted">这栋楼下还没有房间档案</view>
        <view wx:else class="picker placeholder">先选楼栋</view>
      </view>
    </view>

    <view class="card cashier-workspace">
      <view class="cashier-tabs" role="tablist" aria-label="公寓收费功能">
        <view class="cashier-tab {{activeTab === 'charge' ? 'cashier-tab--on' : ''}}" role="tab" aria-selected="{{activeTab === 'charge'}}" data-tab="charge" bindtap="onSwitchTab">住户收费</view>
        <view class="cashier-tab {{activeTab === 'history' ? 'cashier-tab--on' : ''}}" role="tab" aria-selected="{{activeTab === 'history'}}" data-tab="history" bindtap="onSwitchTab">本户缴费记录</view>
        <view class="cashier-tab {{activeTab === 'today' ? 'cashier-tab--on' : ''}}" role="tab" aria-selected="{{activeTab === 'today'}}" data-tab="today" bindtap="onSwitchTab">今日收费汇总</view>
      </view>
      <block wx:if="{{activeTab === 'charge'}}">
        <block wx:if="{{placeText}}">
      <!-- 收费对象：楼栋补「号」、和房号用「-」隔开，跟小票、后台一字不差 -->
      <view class="cashier-section cashier-place">
        <view class="cashier-place__title">{{fullPlaceText}}</view>
        <view class="field">
          <view class="label">姓名<text class="label__opt">房产档案里有就自动带出，可改</text></view>
          <input class="input" placeholder="住户姓名" maxlength="60" value="{{ownerName}}" disabled="{{!canCharge || submitting || contactSaving}}" bindinput="onInputOwnerName" bindblur="onBlurContact" />
        </view>
        <view class="field">
          <view class="label">手机号<text class="label__opt">选填</text></view>
          <input class="input" type="text" maxlength="30" placeholder="住户联系电话" value="{{ownerPhone}}" disabled="{{!canCharge || submitting || contactSaving}}" bindinput="onInputOwnerPhone" bindblur="onBlurContact" />
        </view>
        <view class="muted contact-status">{{canCharge ? (contactStatus || '修改姓名、手机号后，离开输入框自动保存') : '仅查看，不能修改住户资料'}}</view>
        <view wx:if="{{contactError}}" class="field-error">{{contactError}}，输入已保留。</view>
        <button wx:if="{{contactError}}" class="btn btn--ghost mt-sm" disabled="{{contactSaving || submitting}}" bindtap="onBlurContact">重试保存资料</button>
      </view>

      <!-- ============ 2 点要收的项目 ============ -->
      <view class="cashier-section">
        <view class="label">收什么<text class="label__opt">点一下加一项，再点取消</text></view>
        <view wx:if="{{ratesLoading}}" class="muted">正在读取本房间收费标准…</view>
        <view wx:if="{{ratesError}}" class="field-error">{{ratesError}}</view>
        <button wx:if="{{ratesError}}" class="btn" disabled="{{submitting || ratesLoading}}" bindtap="onRetryRates">重新读取标准</button>
        <view class="fee-grid">
          <view
            wx:for="{{feeTypes}}"
            wx:key="code"
            class="fee-tile {{item.active ? 'fee-tile--on' : ''}}"
            role="checkbox"
            aria-label="{{item.name}}，按{{item.unit}}，{{item.active ? '已选择' : '未选择'}}"
            aria-checked="{{item.active}}"
            data-code="{{item.code}}"
            bindtap="onToggleFee"
          >
            <view class="fee-icon fee-icon--{{item.code}}" aria-hidden="true"></view>
            <text class="fee-tile__name">{{item.name}}</text>
            <text class="fee-tile__selected">{{item.active ? '✓ 已选择' : '点击添加'}}</text>
            <text class="fee-tile__unit">按{{item.unit}}</text>
          </view>
        </view>
      </view>

      <!-- ============ 3 填数量单价 ============ -->
      <view wx:if="{{rows.length}}" class="cashier-section">
        <view class="label">这一单</view>
        <view wx:for="{{rows}}" wx:key="feeCode" class="fee-row">
          <view class="fee-row__head">
            <text class="fee-row__name">{{item.feeName}}</text>
            <text class="fee-row__del" data-code="{{item.feeCode}}" catchtap="onRemoveFee">删除</text>
          </view>
          <view wx:if="{{item.feeCode === 'parking'}}" class="parking-details">
            <view class="field"><view class="label">车牌号</view><input class="input" placeholder="请输入完整车牌号" maxlength="30" value="{{item.vehiclePlate}}" disabled="{{submitting}}" data-code="{{item.feeCode}}" data-field="vehiclePlate" bindinput="onRowInput" /></view>
            <view class="field"><view class="label">开始日期</view><picker mode="date" data-field="serviceFrom" data-code="{{item.feeCode}}" value="{{item.serviceFrom}}" disabled="{{submitting}}" bindchange="onRowInput"><view class="picker">{{item.serviceFrom || '选择开始日期'}}</view></picker></view>
            <view class="field"><view class="label">结束日期</view><picker mode="date" data-field="serviceTo" data-code="{{item.feeCode}}" value="{{item.serviceTo}}" start="{{item.serviceFrom}}" disabled="{{submitting}}" bindchange="onRowInput"><view class="picker">{{item.serviceTo || '选择结束日期'}}</view></picker></view>
          </view>
          <view class="fee-row__inputs">
            <view class="fee-row__field">
              <text class="fee-row__label">数量（{{item.unit}}）</text>
              <input
                class="input"
                type="digit"
                value="{{item.quantityText}}"
                data-code="{{item.feeCode}}"
                data-field="quantityText"
                bindinput="onRowInput"
              />
            </view>
            <view class="fee-row__field">
              <text class="fee-row__label">{{item.priceHint || '单价（元）'}}</text>
              <view class="standard-price" aria-label="Web配置的标准单价，不可修改">{{item.unitPriceYuan}}</view>
              <text class="fee-row__readonly">Web标准 · 不可修改</text>
            </view>
            <view class="fee-row__field">
              <text class="fee-row__label">金额（元）</text>
              <input
                class="input"
                type="digit"
                placeholder="0.00"
                value="{{item.amountYuan}}"
                data-code="{{item.feeCode}}"
                data-field="amountYuan"
                bindinput="onRowInput"
              />
            </view>
          </view>
        </view>
        <view wx:if="{{guide}}" class="muted mt-sm">金额会按数量×单价自动算；要抹零头直接改金额，改过就以你填的为准。</view>
      </view>

      <!-- ============ 4 收款方式 ============ -->
      <view wx:if="{{rows.length}}" class="cashier-section">
        <view class="field">
          <view class="label">收款方式</view>
          <view class="payment-grid">
            <view
              wx:for="{{paymentMethods}}"
              wx:key="value"
              class="payment-tile {{paymentMethod === item.value ? 'payment-tile--on' : ''}}"
              role="radio" aria-checked="{{paymentMethod === item.value}}" aria-label="{{item.label}}"
              data-value="{{item.value}}"
              bindtap="onPickMethod"
            ><view class="payment-icon payment-icon--{{item.value}}" aria-hidden="true"></view><text>{{item.label}}</text></view>
          </view>
        </view>
        <view class="field">
          <view class="label">备注<text class="label__opt">选填，会打在小票上</text></view>
          <input class="input" placeholder="如：抄表到 10 月 8 日" value="{{remark}}" bindinput="onInputRemark" />
        </view>
      </view>

        </block>
        <pms-empty wx:else text="先选房间，再收费" />
      </block>
      <block wx:elif="{{activeTab === 'history'}}">
        <block wx:if="{{placeText}}">
        <view class="cashier-section">
          <view class="cashier-place__title">{{fullPlaceText}}</view>
        </view>
      <!-- ============ 这间房交过什么 ============ -->
      <view class="cashier-section">
        <view class="label">本户历史缴费记录</view>
        <button wx:if="{{printListError}}" class="btn btn--ghost" bindtap="onRetryPrinters">{{printListError}} · 重试</button>
        <view wx:if="{{historyLoading}}" class="muted">加载中…</view>
        <view wx:if="{{historyError}}" class="field-error">{{historyError}}（下方如有记录为上次读取结果）</view>
        <button wx:if="{{historyError}}" class="btn btn--ghost" disabled="{{historyLoading}}" bindtap="onRetryHistory">重新读取历史记录</button>
        <pms-empty wx:if="{{!historyLoading && !historyError && !history.length}}" text="这间房还没有缴费记录" />
        <block wx:else>
          <view wx:for="{{history}}" wx:key="receiptNo" class="his-row">
            <button wx:if="{{printAvailable}}" class="btn btn--ghost" disabled="{{printBusy}}" data-receipt="{{item.receiptNo}}" bindtap="onPrintRow">补打小票</button>
            <view class="his-row__main">
              <text class="his-row__items">{{item.itemsText || '—'}}</text>
              <text class="his-row__amount {{item.refunded ? 'his-row__amount--off' : ''}}">{{item.amountText}}</text>
            </view>
            <view class="meta">
              {{item.timeText}} · {{item.methodText}}{{item.statusText ? ' · ' + item.statusText : ''}}
            </view>
          </view>
        </block>
        <view wx:if="{{history.length}}" class="muted mt-sm">已显示 {{history.length}} / {{historyTotal}} 笔</view>
        <button wx:if="{{history.length < historyTotal}}" class="btn btn--ghost mt-sm" loading="{{historyLoading}}" disabled="{{historyLoading}}" bindtap="onMoreHistory">查看更多历史记录</button>
        <view wx:if="{{guide}}" class="muted mt-sm">要补打小票或红冲，请在网站后台「收费业务 → 公寓收费工作台」里办。</view>
      </view>
        </block>
        <pms-empty wx:else text="先选择房间，查看本户缴费记录" />
      </block>

    <!-- 今日收费：独立于选房，展示本人权限范围内全部公寓，不随当前房间筛选 -->
    <view wx:elif="{{activeTab === 'today'}}" class="cashier-section daily-card">
      <view class="daily-head">
        <view class="label">今日收费汇总</view>
        <button class="daily-refresh" disabled="{{todaySummaryLoading}}" loading="{{todaySummaryLoading}}" bindtap="onRefreshToday">刷新</button>
      </view>
      <view class="muted">{{todayDate}} 北京时间 · 本人可见公寓范围，不随选房切换</view>
      <view wx:if="{{todaySummaryLoading}}" class="muted mt-sm">正在读取今日统计…</view>
      <view wx:if="{{todaySummaryError}}" class="field-error mt-sm">{{todaySummaryError}}。请点刷新重试。</view>
      <block wx:if="{{todayLoaded}}">
        <view class="daily-summary">
          <view class="muted">今日净收款</view>
          <view class="daily-summary__amount">{{todayAmountText}}</view>
          <view class="muted">共 {{todayTotal}} 笔流水 · 净额含红冲负数</view>
        </view>
      </block>
        <button class="daily-details-toggle" aria-expanded="{{todayDetailsExpanded}}" disabled="{{todaySummaryLoading}}" bindtap="onToggleTodayDetails"><text>今日收费明细</text><text class="daily-details-toggle__state">{{todayDetailsExpanded ? '收起 −' : '展开 ＋'}}</text></button>
      <block wx:if="{{todayDetailsExpanded}}">
        <view wx:if="{{todayLoading}}" class="muted mt-sm">正在读取今日明细…</view>
        <view wx:if="{{todayError}}" class="field-error mt-sm">{{todayError}}，请点刷新重试。</view>
        <pms-empty wx:if="{{!todayRows.length && !todayLoading && !todayError}}" text="今日暂无收费记录" />
        <button wx:if="{{printListError}}" class="btn btn--ghost" bindtap="onRetryPrinters">{{printListError}} · 重试</button>
        <view wx:for="{{todayRows}}" wx:key="key" class="his-row">
            <button wx:if="{{printAvailable}}" class="btn btn--ghost" disabled="{{printBusy}}" data-receipt="{{item.receiptNo}}" bindtap="onPrintRow">补打小票</button>
          <view class="daily-place">{{item.placeText}}</view>
          <view class="his-row__main">
            <text class="his-row__items">{{item.itemsText || '—'}}</text>
            <text class="his-row__amount {{item.refunded ? 'his-row__amount--off' : ''}}">{{item.amountText}}</text>
          </view>
          <view class="meta">{{item.timeText}} · {{item.methodText}}{{item.statusText ? ' · ' + item.statusText : ''}}</view>
        </view>
        <view wx:if="{{todayRows.length}}" class="muted mt-sm">已显示 {{todayRows.length}} / {{todayTotal}} 笔，汇总为全部流水净额</view>
        <button wx:if="{{todayRows.length < todayTotal}}" class="btn btn--ghost mt-sm" loading="{{todayLoading}}" disabled="{{todayLoading}}" bindtap="onMoreToday">查看更多今日明细</button>
      </block>
    </view>
    </view>
  </block>
</view>

<!-- 底部操作条：固定不滚，让开安全区 -->
<staff-tabbar id="cashier-tabbar" wx:if="{{!receiptOpen}}" />
<view wx:if="{{!loading && canSeeCashier && activeTab === 'charge' && placeText}}" class="action-bar">
  <view wx:if="{{submitError}}" class="field-error action-bar__error">{{submitError}}</view>
  <view class="action-bar__row">
    <view class="action-bar__total">合计 {{totalText}}</view>
    <button
      wx:if="{{canCharge}}"
      class="btn btn--primary"
      loading="{{submitting}}"
      disabled="{{submitting || ratesLoading || !rows.length}}"
      bindtap="onSubmit"
    >
      <view class="btn__icon icon-action--check-white"></view><text>收款</text>
    </button>
    <view wx:else class="muted">你只有查看权限，收不了款</view>
  </view>
</view>

<!-- ============ 收完款的小票 ============ -->
<view wx:if="{{receiptOpen}}" class="sheet-mask" bindtap="onCloseReceipt" catchtouchmove="noop" />
<view wx:if="{{receiptOpen}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">收款成功</text>
    <text class="sheet__close" bindtap="onCloseReceipt">关闭</text>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <view class="receipt__amount">{{receiptAmountText}}</view>
    <view class="kv"><text class="kv__k">小票号</text><text class="kv__v">{{receiptNo}}</text></view>
    <view class="kv"><text class="kv__k">收费对象</text><text class="kv__v">{{communityText}} {{placeText}}</text></view>
    <view class="kv"><text class="kv__k">住户</text><text class="kv__v">{{ownerName || '未填'}}</text></view>
    <view class="label mt">明细</view>
    <view wx:for="{{receiptItems}}" wx:key="feeName">
      <view class="kv"><text class="kv__k">{{item.feeName}} {{item.qtyText}}</text><text class="kv__v">{{item.amountText}}</text></view>
      <view wx:if="{{item.vehiclePlate}}" class="receipt-parking"><view>车牌：{{item.vehiclePlate}}</view><view>开始：{{item.serviceFrom}}</view><view>结束：{{item.serviceTo}}</view></view>
    </view>
  </scroll-view>

  <view class="sheet__foot">
    <button class="btn btn--primary" bindtap="onCloseReceipt">
      <view class="btn__icon icon-action--check-white"></view><text>知道了</text>
    </button>
  </view>
</view>
