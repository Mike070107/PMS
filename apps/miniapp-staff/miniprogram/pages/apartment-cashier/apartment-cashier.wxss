/* 卡片、字段、chip、底部操作条（.action-bar / .container--with-bar）、只读信息行（.kv）、
   弹层（.sheet）都在 app.wxss / tokens.wxss 里，这里只写这一屏独有的东西。 */

/* 行内次要信息（时间 · 方式 · 小票号），和入库页那份同一个观感 */
.meta { color: var(--color-text-tertiary); font-size: var(--font-sm); margin-top: 14rpx; line-height: 1.6; }

/* 原生 picker 没选过时字要浅，让人看得出这是待选不是已填 */
.picker.placeholder { color: var(--color-text-tertiary); }

/* ---------- 收费对象 ---------- */
.cashier-place__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #203e5c;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

/* ---------- 费用项目按钮：一行三个，点中实底品牌色 ---------- */
.fee-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.fee-tile {
  flex: 0 0 calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  padding: 20rpx 10rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fff;
  text-align: center;
}
.fee-tile--on { border-color: var(--color-brand); background: var(--color-brand); }
.fee-tile__name { display: block; font-size: var(--font-md); font-weight: 600; color: #203e5c; line-height: 1.4; }
.fee-tile--on .fee-tile__name { color: #fff; }
.fee-tile__unit { display: block; margin-top: 6rpx; font-size: var(--font-xs); color: var(--color-text-tertiary); }
.fee-tile--on .fee-tile__unit { color: rgba(255, 255, 255, 0.85); }

/* ---------- 这一单的明细行：数量 / 单价 / 金额三个输入并排 ---------- */
.fee-row { margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx dashed var(--color-border); }
.fee-row:first-of-type { border-top: 0; padding-top: 8rpx; }
.fee-row__head { display: flex; align-items: center; justify-content: space-between; }
.fee-row__name { font-size: var(--font-lg); font-weight: 600; color: #203e5c; }
.fee-row__del { font-size: var(--font-sm); color: #b4453c; padding: 8rpx 12rpx; }
.fee-row__inputs { display: flex; gap: 12rpx; margin-top: 14rpx; }
.fee-row__field { flex: 1 1 0; min-width: 0; }
.fee-row__label { display: block; margin-bottom: 8rpx; font-size: var(--font-xs); color: var(--color-text-tertiary); }

/* ---------- 历史缴费 ---------- */
.his-row { margin-top: 22rpx; padding-top: 22rpx; border-top: 2rpx solid var(--color-border); }
.his-row:first-of-type { border-top: 0; padding-top: 10rpx; }
.his-row__main { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.his-row__items { flex: 1 1 auto; font-size: var(--font-md); color: #203e5c; line-height: 1.5; }
.his-row__amount { flex: 0 0 auto; font-size: var(--font-lg); font-weight: 700; color: #203e5c; }
/* 红冲过的那笔钱并没有收到，划掉它，别让人把它当成当日收入 */
.his-row__amount--off { color: var(--color-text-tertiary); text-decoration: line-through; }

/* ---------- 底部操作条：合计 + 收款，错误提示摆按钮上方 ---------- */
.action-bar { flex-direction: column; align-items: stretch; gap: 12rpx; }
.action-bar__error { margin: 0; }
.action-bar__row { display: flex; align-items: center; gap: 20rpx; }
.action-bar__total { flex: 1 1 auto; font-size: 38rpx; font-weight: 700; color: #203e5c; }
.action-bar__row .btn { flex: 0 0 auto; width: auto !important; min-width: 240rpx; }

/* ---------- 小票 ---------- */
.receipt__amount {
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-brand);
}
