/* ---------- 这一单的明细行：数量 / 单价 / 金额三个输入并排 ---------- */
.fee-row { margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx dashed var(--color-border); }
.fee-row:first-of-type { border-top: 0; padding-top: 8rpx; }
.fee-row__head { display: flex; align-items: center; justify-content: space-between; }
.fee-row__name { font-size: var(--font-lg); font-weight: 600; color: #203e5c; }
.fee-row__del { font-size: var(--font-sm); color: #b4453c; padding: 8rpx 12rpx; }
.fee-row__inputs { display: flex; gap: 12rpx; margin-top: 14rpx; }
.fee-row__field { flex: 1 1 0; min-width: 0; }
.fee-row__label { display: block; margin-bottom: 8rpx; font-size: var(--font-xs); color: var(--color-text-tertiary); }

/* ---------- 历史缴费 ---------- */
.his-row { margin-top: 22rpx; padding-top: 22rpx; border-top: 2rpx solid var(--color-border); }
.his-row:first-of-type { border-top: 0; padding-top: 10rpx; }
.his-row__main { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.his-row__items { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; font-size: var(--font-md); color: #203e5c; line-height: 1.6; }
.his-row__amount { flex: 0 0 auto; font-size: var(--font-lg); font-weight: 700; color: #203e5c; }
/* 红冲过的那笔钱并没有收到，划掉它，别让人把它当成当日收入 */
.his-row__amount--off { color: var(--color-text-tertiary); text-decoration: line-through; }

/* ---------- 底部操作条：合计 + 收款，错误提示摆按钮上方 ---------- */
.action-bar { flex-direction: column; align-items: stretch; gap: 12rpx; bottom: calc(152rpx + env(safe-area-inset-bottom)); }
/* 两类特异度要匹配共享令牌，否则底部卡片会被浮动收款条盖住。 */
.container.container--with-bar { padding-bottom: calc(340rpx + env(safe-area-inset-bottom)); }
.action-bar__error { margin: 0; }
.action-bar__row { display: flex; align-items: center; gap: 20rpx; }
.action-bar__total { flex: 1 1 auto; font-size: 38rpx; font-weight: 700; color: #203e5c; }
.action-bar__row .btn { flex: 0 0 auto; width: auto !important; min-width: 240rpx; }

/* ---------- 今日收费：净额是唯一数值锚点，列表位于页面末尾 ---------- */
.daily-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.daily-head .label { margin-bottom: 0; }
.daily-refresh { flex: 0 0 auto; min-height: 88rpx; min-width: 144rpx; padding: 0 24rpx; color: var(--color-brand); background: var(--color-bg); font-size: 30rpx; border-radius: 16rpx; }
.daily-summary { margin-top: 24rpx; padding: 24rpx; background: #f2f6fb; border-radius: 20rpx; }
.daily-summary__amount { margin: 8rpx 0; font-size: 52rpx; font-weight: 700; line-height: 1.4; color: var(--color-brand); overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.daily-details-title { margin-top: 32rpx; }
.daily-place { margin-bottom: 8rpx; color: var(--color-text-secondary); font-size: 28rpx; line-height: 1.6; overflow-wrap: anywhere; }
.daily-card .field-error { overflow-wrap: anywhere; }
@media (max-width: 360px) { .his-row__main { flex-wrap: wrap; } .his-row__amount { margin-left: auto; } }

/* ---------- 小票 ---------- */
.receipt__amount {
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-brand);
}

