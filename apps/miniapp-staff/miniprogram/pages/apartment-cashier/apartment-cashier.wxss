.record-actions { display:flex; align-items:center; justify-content:flex-end; gap:12rpx; }
.record-chevron { color:#586a80; font-size:40rpx; }
.record-print { margin:0; min-height:72rpx; padding:0 22rpx; font-size:26rpx; line-height:72rpx; background:#eff4fa; color:#294d73; }

.print-icon { width:38rpx; height:38rpx; display:block; }
.record-print { display:flex; gap:6rpx; align-items:center; justify-content:center; min-width:80rpx; min-height:80rpx; }
.record-close { min-width:80rpx; line-height:80rpx; text-align:center; font-size:44rpx; }
.refund-color { color:#a62e36; }
.refund-confirm { background:#a62e36; color:#fff; }

.record-row { display:grid; grid-template-columns:minmax(0,1fr) auto; column-gap:12rpx; align-items:center; }
.record-row > .daily-place,.record-row > .his-row__main,.record-row > .meta { grid-column:1; }
.record-row > .record-actions { grid-column:2; grid-row:1 / span 3; }
.record-row .his-row__items { min-width:0; overflow-wrap:anywhere; }
