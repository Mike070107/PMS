/* 卡片、字段、chip、底部操作条（.action-bar / .container--with-bar）、只读信息行（.kv）、
   弹层（.sheet）都在 app.wxss / tokens.wxss 里，这里只写这一屏独有的东西。 */

/* 行内次要信息仅时间、收款方式及必要红冲状态，不展示订单号。 */
.meta { color: var(--color-text-tertiary); font-size: var(--font-sm); margin-top: 14rpx; line-height: 1.6; }

/* 原生 picker 没选过时字要浅，让人看得出这是待选不是已填 */
.picker.placeholder { color: var(--color-text-tertiary); }
.address-label { flex-wrap: wrap; }
.address-label__name { flex-shrink: 0; white-space: nowrap; }

/* ---------- 单卡三Tab：表单、历史、今日统计互斥 ---------- */
.cashier-workspace { padding-top: 0; }
.cashier-tabs { display: flex; gap: 8rpx; border-bottom: 2rpx solid var(--color-border); }
.cashier-tab { flex: 1; min-width: 0; min-height: 104rpx; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 28rpx; line-height: 1.5; color: var(--color-text-secondary); border-bottom: 6rpx solid transparent; box-sizing: border-box; }
.cashier-tab--on { color: var(--color-brand); border-bottom-color: var(--color-brand); font-weight: 700; }
.cashier-section { padding-top: 32rpx; }
.cashier-section + .cashier-section { margin-top: 32rpx; border-top: 2rpx solid var(--color-border); }
.contact-status { margin-top: 16rpx; line-height: 1.6; }
.standard-price { box-sizing: border-box; min-height: 88rpx; display: flex; align-items: center; padding: 16rpx; border-radius: 12rpx; background: #f2f5f8; color: var(--color-text-secondary); font-size: 32rpx; overflow-wrap: anywhere; }
.fee-row__readonly { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--color-text-tertiary); line-height: 1.6; }
.payment-grid { display: flex; gap: 16rpx; }
.payment-tile { flex: 1; min-width: 0; box-sizing: border-box; padding: 24rpx 8rpx; min-height: 160rpx; border: 2rpx solid var(--color-border); border-radius: 16rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; font-size: 28rpx; }
.payment-tile--on { border-color: var(--color-brand); background: #edf4fa; color: var(--color-brand); font-weight: 700; }
.payment-icon { width: 80rpx; height: 64rpx; background-repeat: no-repeat; background-size: contain; background-position: center; }
.daily-details-toggle { margin-top: 32rpx; width: 100%; min-height: 104rpx; padding: 16rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #f2f6fb; color: var(--color-text); border-radius: 16rpx; font-size: 30rpx; }
.daily-details-toggle__state { color: var(--color-brand); font-size: 26rpx; }

/* ---------- 收费对象 ---------- */
.cashier-place__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #203e5c;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

/* ---------- 费用项目按钮：一行三个，点中实底品牌色 ---------- */
.fee-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.fee-tile {
  flex: 0 0 calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  padding: 20rpx 10rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #fff;
  text-align: center;
}
.fee-tile--on { border-color: var(--color-brand); background: var(--color-brand); }
.fee-tile__name { display: block; font-size: var(--font-md); font-weight: 600; color: #203e5c; line-height: 1.4; }
.fee-tile--on .fee-tile__name { color: #fff; }
.fee-tile__unit { display: block; margin-top: 6rpx; font-size: var(--font-xs); color: var(--color-text-tertiary); }
.fee-tile--on .fee-tile__unit { color: rgba(255, 255, 255, 0.85); }
.fee-tile__selected { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--color-text-secondary); }
.fee-tile--on .fee-tile__selected { color: #fff; }
/* 费用图示只装饰，不替代名称；沿用小程序内联SVG背景方式，无网络图标依赖。 */
.fee-icon { width: 72rpx; height: 72rpx; margin: 0 auto 16rpx; border-radius: 20rpx; background-repeat: no-repeat; background-position: center; background-size: 48rpx 48rpx; }
