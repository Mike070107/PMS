<view class="repair-page" bindtouchstart="onSwipeBackStart" bindtouchmove="onSwipeBackMove" bindtouchend="onSwipeBackEnd" bindtouchcancel="onSwipeBackCancel">
  <view class="repair-nav">
    <view class="repair-nav__safe"></view>
    <view class="repair-nav__bar">
      <view class="repair-nav__back" bindtap="onBack">‹</view>
      <view class="repair-nav__center">
        <view class="repair-nav__title">新建报修</view>
        <view wx:if="{{guide}}" class="repair-nav__subtitle">按提示填写，提交前还能修改</view>
      </view>
      <!-- 「?」= 指导层开关，见 utils/guide.ts -->
      <view class="repair-nav__side"><view class="nav-help {{guide ? 'nav-help--on' : ''}}" bindtap="onToggleGuide">?</view></view>
    </view>
  </view>

  <view class="repair-body">
    <view class="step-progress">
      <view class="step-progress__item step-progress__item--on"><text>1</text><view>位置</view></view>
      <view class="step-progress__line"></view>
      <view class="step-progress__item"><text>2</text><view>故障</view></view>
      <view class="step-progress__line"></view>
      <view class="step-progress__item"><text>3</text><view>联系</view></view>
    </view>

    <view class="form-card">
      <view class="section-head">
        <view class="section-head__num">1</view>
        <view><view class="section-head__title">修哪里</view><view wx:if="{{guide}}" class="section-head__desc">先确认位置，避免维修工跑错</view></view>
      </view>

      <view class="form-field">
        <view class="form-label">报修位置 <text class="required">必填</text></view>
        <block wx:if="{{detected && detected.matched}}">
          <view class="detected-location">
            <view class="detected-location__pin"></view>
            <view class="detected-location__text">{{detected.addressText}}</view>
            <view class="detected-location__close" catchtap="onDismissDetected">×</view>
          </view>
          <view class="place-success"><text>✓</text> 已自动识别对应位置，点 × 可重新选择</view>
        </block>
        <block wx:else>
          <place-picker id="placePicker" compact="{{true}}" valueText="{{placeText}}" loading="{{bookLoading}}" bind:picked="onPlacePicked" />
          <view wx:if="{{placeText}}" class="place-success"><text>✓</text> 已找到对应房屋</view>
          <view class="field-error" wx:if="{{errors.place}}">{{errors.place}}</view>
          <view class="scope-hint" wx:if="{{scopeHint}}">{{scopeHint}}</view>
        </block>
      </view>

      <view class="form-field form-field--spot" wx:if="{{detected && detected.matched ? (detected.level !== 'house' && !detected.spotName) : showSpot}}">
        <view class="form-label">具体位置</view>
        <input class="large-input" placeholder="例如：大门、4楼电梯口" maxlength="40" value="{{spotText}}" bindinput="onSpotText" />
        <view class="quick-tags"><text wx:for="{{spotSuggestions}}" wx:key="*this" class="quick-tag" data-text="{{item}}" bindtap="onPickSpot">{{item}}</text></view>
      </view>
    </view>

    <view class="form-card">
      <view class="section-head">
        <view class="section-head__num">2</view>
        <view><view class="section-head__title">什么问题</view><view wx:if="{{guide}}" class="section-head__desc">可以打字，也可以按住说话</view></view>
      </view>

      <view class="form-field">
        <view class="form-label">故障描述 <text class="required">必填</text></view>
        <textarea class="fault-input" placeholder="例如：门铃按了以后，楼下单元门打不开" value="{{content}}" bindinput="onContent" />
        <view wx:if="{{recording}}" class="listening">正在听…{{partial ? ' ' + partial : ''}}</view>
        <button wx:if="{{hasSpeech}}" class="speech-button {{recording ? 'speech-button--on' : ''}}" bindtouchstart="onSpeechStart" bindtouchend="onSpeechEnd" bindtouchcancel="onSpeechEnd">
          <view class="speech-button__mic"></view>
          <view class="speech-button__body"><view class="speech-button__title">{{recording ? '松开结束' : '按住说话'}}</view><view wx:if="{{guide}}" class="speech-button__desc">普通话即可，会自动填写</view></view>
        </button>
        <view class="suggest-title">常见问题，点一下就能填</view>
        <view class="quick-tags"><text wx:for="{{contentSuggestions}}" wx:key="*this" class="quick-tag" data-text="{{item}}" bindtap="onPickContentTag">{{item}}</text></view>
        <view class="field-error" wx:if="{{errors.content}}">{{errors.content}}</view>
      </view>

      <view wx:if="{{content || typeIndex >= 0}}" class="form-field type-field">
        <view class="form-label">报修类型 <text class="required">必填</text></view>
        <picker mode="selector" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onPickType">
          <view class="large-picker {{typeIndex < 0 ? 'large-picker--placeholder' : ''}}">{{typeIndex < 0 ? 'AI未识别，请点这里选择' : typeOptions[typeIndex].label}}</view>
        </picker>
        <view class="field-error" wx:if="{{errors.type}}">{{errors.type}}</view>
        <view class="auto-hint" wx:if="{{autoTypeHint}}">{{autoTypeHint}}</view>
      </view>

      <view class="urgency-block">
        <view class="urgency-block__head"><view class="form-label">紧急程度</view><view wx:if="{{guide}}" class="urgency-block__tip">一般情况保持“普通”即可</view></view>
        <view class="urgency-choice">
          <view class="urgency-choice__item {{!urgent ? 'urgency-choice__item--on' : ''}}" data-urgent="0" bindtap="onPickUrgency"><view class="urgency-choice__symbol">✓</view><view>普通</view></view>
          <view class="urgency-choice__item urgency-choice__item--danger {{urgent ? 'urgency-choice__item--on' : ''}}" data-urgent="1" bindtap="onPickUrgency"><view class="urgency-choice__symbol">△</view><view>紧急</view></view>
        </view>
        <view wx:if="{{urgent && urgentReasonText}}" class="urgency-reason">AI 判断依据：{{urgentReasonText}}</view>
      </view>
    </view>

    <view class="form-card">
      <view class="section-head">
        <view class="section-head__num">3</view>
        <view><view class="section-head__title">怎么联系</view><view wx:if="{{guide}}" class="section-head__desc">维修工上门前会先打电话</view></view>
      </view>
      <view class="auto-hint auto-hint--block" wx:if="{{autoContactHint}}">{{autoContactHint}}</view>
      <view class="form-field"><view class="form-label">联系人</view><input class="large-input" placeholder="姓名" maxlength="20" value="{{contactName}}" bindinput="onContactName" /></view>
      <view class="form-field"><view class="form-label">联系电话</view><input class="large-input" type="number" placeholder="请输入手机号码" value="{{contactPhone}}" bindinput="onPhone" /><view class="field-error" wx:if="{{errors.phone}}">{{errors.phone}}</view></view>

      <view class="media-entry" data-type="image" bindtap="onChooseMedia">
        <view class="media-entry__camera"></view>
        <view class="media-entry__body"><view class="media-entry__title">{{attachments.length ? '继续添加现场照片' : '添加现场照片'}}</view><view class="media-entry__desc">{{guide ? '选填，有照片更容易判断问题' : '选填'}}</view></view>
        <view class="media-entry__plus">＋</view>
      </view>
      <view wx:if="{{mediaList.length}}" class="media-list">
        <view wx:for="{{mediaList}}" wx:key="url" class="thumb-wrap">
          <video wx:if="{{item.video}}" class="thumb" src="{{item.url}}" object-fit="cover" show-center-play-btn="{{true}}" />
          <image wx:else class="thumb" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="onPreviewMedia" />
          <view class="thumb-remove" data-index="{{index}}" catchtap="onRemoveMedia"><view class="icon icon--close"></view></view>
        </view>
        <view wx:if="{{!videoCount}}" class="video-add" data-type="video" bindtap="onChooseMedia">＋ 15秒视频</view>
      </view>
    </view>
  </view>
</view>

<view class="review-bar">
  <button class="review-button" loading="{{submitting}}" disabled="{{submitting || uploading}}" bindtap="onReview"><view class="review-button__send"></view><text>下一步：确认信息</text></button>
</view>
