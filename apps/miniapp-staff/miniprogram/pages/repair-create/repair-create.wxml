<!-- 表单按「一次问一件事」分成三组：在哪 → 什么问题 → 怎么联系（与业主端一键报修同构） -->
<view class="container has-submit-bar">
  <view class="screen-head">
    <view class="screen-head__title">新建报修</view>
    <view class="screen-head__desc">按位置、问题和联系人三步填写，提交前可随时修改</view>
  </view>

  <!-- ① 在哪 -->
  <view class="card section">
    <view class="section__head">
      <text class="section__title">修哪里</text>
      <text class="section__hint">可停在小区或楼栋（公共区域）</text>
    </view>

    <!-- 描述里识别到了地址：替换手选的位置展示，点 × 恢复 -->
    <block wx:if="{{detected && detected.matched}}">
      <view class="detected">
        <view class="detected__row">
          <view class="detected__text">{{detected.addressText}}</view>
          <view class="detected__close" catchtap="onDismissDetected" hover-class="detected__close--tap">
            <view class="icon icon--close-dark"></view>
          </view>
        </view>
        <view class="detected__hint">按描述里的「{{detected.matchedText}}」自动识别，点 × 用下面选的位置</view>
      </view>
    </block>

    <block wx:else>
      <place-picker
        valueText="{{placeText}}"
        loading="{{bookLoading}}"
        bind:picked="onPlacePicked"
        id="placePicker"
      />
      <view class="field-error" wx:if="{{errors.place}}">{{errors.place}}</view>
      <view class="scope-hint" wx:if="{{scopeHint}}">{{scopeHint}}</view>
    </block>

    <!-- 具体位置：公共区域才补一句「在哪」；识别到的地址没到房号级同理 -->
    <!-- 认到公区点位（监控室、水泵房）时地址里已经写清在哪了，不必再追问一遍 -->
    <view class="field mt-lg" wx:if="{{detected && detected.matched ? (detected.level !== 'house' && !detected.spotName) : showSpot}}">
      <view class="label">具体位置</view>
      <input
        class="input"
        placeholder="例如：大门，4楼电梯口，3楼楼梯"
        maxlength="40"
        value="{{spotText}}"
        bindinput="onSpotText"
      />
      <view class="tags">
        <text wx:for="{{spotSuggestions}}" wx:key="*this" class="tag" data-text="{{item}}" bindtap="onPickSpot">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- ② 什么问题 -->
  <view class="card section">
    <view class="section__head">
      <text class="section__title">什么问题</text>
    </view>

    <view class="field">
      <view class="label">报修类型</view>
      <picker mode="selector" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onPickType">
        <view class="picker {{typeIndex < 0 ? 'placeholder' : ''}}">
          {{typeIndex < 0 ? '请选择报修类型' : typeOptions[typeIndex].label}}
        </view>
      </picker>
      <view class="field-error" wx:if="{{errors.type}}">{{errors.type}}</view>
      <!-- 自动判定要写清「按哪个词判的」，判错时人一眼知道该怎么改描述 -->
      <view class="auto-hint" wx:if="{{autoTypeHint}}">{{autoTypeHint}}</view>
    </view>

    <view class="field">
      <view class="label">问题描述</view>
      <textarea
        placeholder="在哪、什么坏了；写上「一期24号」这类地址会自动定位"
        value="{{content}}"
        bindinput="onContent"
      />

      <view wx:if="{{recording}}" class="listening">
        正在听…{{partial ? ' ' + partial : ''}}
      </view>

      <button
        wx:if="{{hasSpeech}}"
        class="btn btn--outline mt-sm speech {{recording ? 'speech--on' : ''}}"
        bindtouchstart="onSpeechStart"
        bindtouchend="onSpeechEnd"
        bindtouchcancel="onSpeechEnd"
      >
        <view class="icon {{recording ? 'icon--mic-on' : 'icon--mic'}}"></view>
        <text class="speech__text">{{recording ? '松开结束' : '按住说话（普通话），自动识别'}}</text>
      </button>
      <view class="tags">
        <text wx:for="{{contentSuggestions}}" wx:key="*this" class="tag" data-text="{{item}}" bindtap="onPickContentTag">{{item}}</text>
      </view>

      <!-- 说了「急修」就标紧急。整行可点：取消 / 标回来都在这一下 -->
      <view
        wx:if="{{urgentMatched || urgent}}"
        class="urgency {{urgent ? 'urgency--on' : ''}}"
        bindtap="onToggleUrgent"
      >
        <text class="urgency__badge">{{urgent ? '紧急' : '普通'}}</text>
        <view class="urgency__body">
          <view class="urgency__text">{{urgent ? '这单按紧急处理' : '这单不按紧急处理'}}</view>
          <view class="urgency__hint">{{urgent ? urgentReasonText + '，点这行取消' : '点这行标回紧急'}}</view>
        </view>
      </view>

      <view class="field-error" wx:if="{{errors.content}}">{{errors.content}}</view>
    </view>

    <view class="field">
      <view class="label">现场照片 / 视频<text class="label__opt">选填，照片最多 6 张、视频 1 段 15 秒</text></view>
      <view class="thumbs">
        <view wx:for="{{mediaList}}" wx:key="url" class="thumb-wrap">
          <!-- 视频不能丢进 image，渲染出来是一片黑；点开也走各自的播放/预览 -->
          <video
            wx:if="{{item.video}}"
            class="thumb"
            src="{{item.url}}"
            object-fit="cover"
            show-center-play-btn="{{true}}"
          />
          <image
            wx:else
            class="thumb"
            src="{{item.url}}"
            mode="aspectFill"
            data-url="{{item.url}}"
            bindtap="onPreviewMedia"
          />
          <view class="thumb-remove" data-index="{{index}}" catchtap="onRemoveMedia">
            <view class="icon icon--close"></view>
          </view>
        </view>
        <view
          wx:if="{{attachments.length - videoCount < 6}}"
          class="thumb-add"
          data-type="image"
          bindtap="onChooseMedia"
        >
          <view class="icon icon--camera"></view>
          <text class="add-text">{{uploading ? '上传中' : '拍照'}}</text>
        </view>
        <view wx:if="{{!videoCount}}" class="thumb-add" data-type="video" bindtap="onChooseMedia">
          <view class="icon icon--camera"></view>
          <text class="add-text">{{uploading ? '上传中' : '拍视频'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ③ 怎么联系 -->
  <view class="card section">
    <view class="section__head">
      <text class="section__title">怎么联系</text>
      <text class="section__hint">默认是你本人，替住户报的可以改成住户</text>
    </view>
    <view class="auto-hint auto-hint--block" wx:if="{{autoContactHint}}">{{autoContactHint}}</view>
    <view class="field">
      <view class="label">联系人</view>
      <input class="input" placeholder="姓名" maxlength="20" value="{{contactName}}" bindinput="onContactName"/>
    </view>
    <view class="field">
      <view class="label">联系电话</view>
      <input class="input" type="number" placeholder="维修工上门前会先打这个号" value="{{contactPhone}}" bindinput="onPhone"/>
      <view class="field-error" wx:if="{{errors.phone}}">{{errors.phone}}</view>
    </view>
  </view>
</view>

<view class="submit-bar">
  <button class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting || uploading}}" bindtap="onSubmit">
    <view class="btn__icon icon-action--send-white"></view><text>提交报修</text>
  </button>
</view>
