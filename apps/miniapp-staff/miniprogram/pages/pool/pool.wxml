<import src="/templates/wo-card.wxml"/>

<!-- 现场工作页头：标题、当前范围和三个关键数字放在同一张浅蓝工作卡里。 -->
<view class="work-hero">
  <view class="work-hero__top">
    <view>
      <view class="work-hero__eyebrow">邻修现场工作台</view>
      <view class="work-hero__title">{{screenTitle}}</view>
    </view>
    <view class="work-hero__right">
      <view class="work-hero__count">{{list.length}} {{leadText}}</view>
      <!-- 指导层开关：说明文字默认收起，点亮才显示，见 utils/guide.ts -->
      <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
    </view>
  </view>
  <view wx:if="{{guide}}" class="work-hero__hint">{{dispatcher ? '把待办准确派给合适的维修人员' : '紧急优先；同组按报修时间从早到晚'}}</view>
  <!-- 三个数字可点：点了就在这一屏里只看那一类，再点一次取消（见 pool.ts onTapMetric） -->
  <view class="work-metrics">
    <view
      class="work-metric work-metric--danger {{metricFilter === 'urgent' ? 'work-metric--on' : ''}}"
      data-metric="urgent"
      bindtap="onTapMetric"
    >
      <view class="work-metric__value">{{urgentCount}}</view>
      <view class="work-metric__label">紧急{{metricFilter === 'urgent' ? ' · 只看这些' : ''}}</view>
    </view>
    <view
      class="work-metric work-metric--warning {{metricFilter === 'overdue' ? 'work-metric--on' : ''}}"
      data-metric="overdue"
      bindtap="onTapMetric"
    >
      <view class="work-metric__value">{{overdueCount}}</view>
      <view class="work-metric__label">压 3 天以上{{metricFilter === 'overdue' ? ' · 只看这些' : ''}}</view>
    </view>
    <view
      class="work-metric {{metricFilter === 'normal' ? 'work-metric--on' : ''}}"
      data-metric="normal"
      bindtap="onTapMetric"
    >
      <view class="work-metric__value">{{normalCount}}</view>
      <view class="work-metric__label">普通{{metricFilter === 'normal' ? ' · 只看这些' : ''}}</view>
    </view>
  </view>
</view>

<view class="hero-sheet hero-sheet--tabbar">

  <!-- 巡查发现问题：只留一个入口「语音报修」。2026-09-04 Mike：去掉「填表报修」按钮，
       要填表的人在语音页里点「不方便说话，改用填表报修」。
       按钮比全局规格再大一档（pool.wxss .report-entry--row）：这一屏里报修是唯一的「录入」
       动作，其余都是浏览和筛选，2026-08-30 用户反馈小一档的版本「看不见」，别再往回调小。 -->
  <view wx:if="{{canReport}}" class="btn-row report-entry report-entry--row">
    <button class="btn btn--primary" bindtap="onGoQuickRepair">
      <view class="btn__icon icon-action--mic-white"></view>
      <text>语音报修</text>
    </button>
  </view>

  <!-- 三档：这一屏看哪一批单。只有工单池这一侧有 —— 派单台自己就有 7 档状态筛选，
       再叠一层会变成两排筛选条，人分不清该点哪一排（2026-08-31 要求把「我报的」
       「已完结」从「在手工单」搬过来，那一页只留手上真正要干的活）。 -->
  <view wx:if="{{!dispatcher}}" class="tabs">
    <view wx:if="{{canSeePool}}" class="tab {{mainTab === 'pool' ? 'tab--on' : ''}}" data-tab="pool" bindtap="onSwitchMainTab">工单池</view>
    <view wx:if="{{canSeeMyRepairs}}" class="tab {{mainTab === 'reported' ? 'tab--on' : ''}}" data-tab="reported" bindtap="onSwitchMainTab">我报的</view>
    <view wx:if="{{canSeeDone}}" class="tab {{mainTab === 'done' ? 'tab--on' : ''}}" data-tab="done" bindtap="onSwitchMainTab">已完结</view>
  </view>

  <!-- 维修工侧同理：卡片上不出现「接单」时，必须写清是权限收着，不是没活干 -->
  <view wx:if="{{!dispatcher && mainTab === 'pool' && canSeePool && !canAccept}}" class="notice">
    <view class="notice__body">
      <view class="notice__title">你的账号只能查看工单，不能接单</view>
      <view class="notice__desc">
        请管理员在管理后台「业务角色」页找到你的角色，在「邻修小程序页面权限」里把「工单池」这一行的「接单」勾上；改完在这一页下拉刷新即可，不用退出重登。
      </view>
    </view>
  </view>

  <!-- 只给了查看权限时，卡片上不会有派单按钮。必须说清为什么、去哪儿开，
       不能让人对着一屏「待派单」找不到入口 -->
  <view wx:if="{{dispatcher && !canDispatch}}" class="notice">
    <view class="notice__body">
      <view class="notice__title">你的账号只能查看工单，不能派单</view>
      <view class="notice__desc">
        请管理员在管理后台「业务角色」页找到你的角色，在「邻修小程序页面权限」里把「派单台」这一行的「派单」勾上；改完在这一页下拉刷新即可，不用退出重登。
      </view>
    </view>
  </view>

  <!-- ===== 状态筛选 + 搜索：两种模式都有，只是档位不同（见 pool.ts 的两组 FILTERS）。
       工单池原来没有这两样，池子里堆到几十条时，维修工要找「等待材料那单到料没有」
       只能一路往下翻 —— 和派单台是同一个问题，用同一套控件解决 ===== -->
  <!-- 已完结那一档不给筛选条：它本身就是终态，再按状态分没有意义 -->
  <scroll-view wx:if="{{mainTab !== 'done'}}" class="chips" scroll-x enable-flex>
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="chip {{filterIndex === index ? 'chip--on' : ''}}"
      data-index="{{index}}"
      bindtap="onPickFilter"
    >{{item.label}}</view>
  </scroll-view>

  <view class="search-row">
    <input
      class="input"
      placeholder="搜单号 / 地址 / 故障描述"
      value="{{keyword}}"
      confirm-type="search"
      bindconfirm="onSearch"
      bindinput="onKeyword"
    />
    <button class="btn btn--outline btn--sm" bindtap="onSearch">
      <view class="btn__icon icon-action--search-blue"></view>
      <text>搜索</text>
    </button>
    <button wx:if="{{keyword}}" class="btn btn--ghost btn--sm" bindtap="onClearKeyword">清空</button>
  </view>

  <view wx:if="{{loading && !loaded}}" class="center muted">加载中…</view>
  <view wx:elif="{{!list.length && loaded}}">
    <pms-empty text="{{emptyText}}"/>
  </view>

  <block
    wx:for="{{list}}"
    wx:key="id"
  >
    <view wx:if="{{showPriorityGroups && item.groupStart}}" class="priority-group {{item.urgent ? 'priority-group--urgent' : ''}}">
      <view class="priority-group__title">{{item.groupLabel}}</view>
      <view wx:if="{{guide}}" class="priority-group__hint">紧急先处理；其余按报修时间，越早报的越靠前</view>
    </view>
    <view
    id="pool-order-{{item.id}}"
    class="order-slot {{collectingId === item.id ? 'order-slot--collecting' : ''}} {{closingId === item.id ? 'order-slot--closing' : ''}} {{settling && index > collectingIndex ? 'order-slot--following' : ''}}"
    style="{{collectingId === item.id || closingId === item.id ? 'height:' + collectingHeight + 'px' : ''}}"
  >
    <view
      wx:if="{{item.waitingCollapsed}}"
      class="card order-card waiting-fold"
      hover-class="waiting-fold--hover"
      hover-stay-time="80"
      bindtap="onExpandWaiting"
      data-id="{{item.id}}"
    >
      <view class="waiting-fold__head">
        <view class="waiting-fold__title">
          <text wx:if="{{item.urgent}}" class="badge--urgent">紧急</text>
          <text>等待材料</text>
        </view>
        <pms-tag status="{{item.status}}" label="{{item.statusText}}"/>
      </view>
      <view class="waiting-fold__addr">
        <view class="icon icon--pin"></view>
        <text>{{item.summaryAddress || '未填地址'}}</text>
      </view>
      <view class="waiting-fold__material">{{item.missingText || '待补充缺料明细'}}</view>
      <view class="waiting-fold__foot">
        <text>{{item.orderNo}} · {{item.timeText}}</text>
        <text class="waiting-fold__expand">展开详情⌄</text>
      </view>
    </view>
    <view
      wx:else
      class="card wo-card wo-card--data order-card"
      hover-class="wo-card--hover"
      hover-stay-time="80"
      bindtap="onTapItem"
      data-id="{{item.id}}"
    >
      <!-- 卡片正文（地址一行 + 报修内容一行 + 数据网格）在 /templates/wo-card.wxml，
           和在手工单共用一份。第三格的含义每一档不同，由 pool.ts 一并算好塞进 row -->
      <template is="wo-card-body" data="{{item: item, thirdLabel: item.thirdLabel, thirdValue: item.thirdValue, thirdHint: item.thirdHint}}"/>

      <view class="wo-card__foot">
        <text
          wx:if="{{!dispatcher && mainTab === 'pool' && item.status === 'waiting_material'}}"
          class="waiting-collapse"
          catchtap="onCollapseWaiting"
          data-id="{{item.id}}"
        >收起⌃</text>
        <!-- 派单台 -->
        <block wx:if="{{dispatcher}}">
          <button
            wx:if="{{canDispatch && item.dispatchable}}"
            class="btn btn--primary btn--sm"
            catchtap="onOpenAssign"
            data-id="{{item.id}}"
          ><view class="btn__icon icon-action--send-white"></view><text>{{item.actionText}}</text></button>
          <text wx:else class="wo-card__more">查看详情 ›</text>
        </block>
        <!-- 维修工：未派单或等待材料可主动接，接完才进“在手工单” -->
        <block wx:else>
          <button
            wx:if="{{canAccept && item.claimable}}"
            class="btn btn--primary btn--sm"
            catchtap="onAccept"
            data-id="{{item.id}}"
            loading="{{acceptingId === item.id}}"
            disabled="{{acceptingId !== 0 || collectingId !== 0}}"
          ><view class="btn__icon icon-action--check-white"></view><text>{{item.actionText}}</text></button>
          <text wx:else class="wo-card__more">查看详情 ›</text>
        </block>
      </view>
    </view>
    </view>
  </block>

  <!-- 我报的 / 已完结不搜索时只展示最近 30 条（2026-09-06 Mike）：更早的靠搜索，必须说清，不然像丢了单 -->
  <view wx:if="{{recentHiddenCount}}" class="muted center cap-tip">
    只显示最近 {{recentLimit}} 条，还有 {{recentHiddenCount}} 条更早的没列出来；要找更早的，用上面的搜索（单号 / 地址 / 描述）
  </view>
  <!-- 服务端一次最多给 100 条：到顶了必须说明，否则看着就是「搜索漏了单」 -->
  <view wx:elif="{{capped}}" class="muted center cap-tip">
    只显示最近 100 条，用上面的搜索或状态筛选缩小范围
  </view>
</view>

<!-- 动画落点：与卡片同时出现，让人明确知道这单收到哪里去了 -->
<view wx:if="{{collectingId}}" class="mine-receiver">
  <view class="mine-receiver__dot"></view>
  <text>已收入在手工单</text>
</view>

<!-- ============ 派单面板 ============ -->
<view wx:if="{{assignOpen}}" class="sheet-mask" bindtap="onCloseAssign" catchtouchmove="noop"/>
<view wx:if="{{assignOpen}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">派单</text>
    <text class="sheet__close" bindtap="onCloseAssign">关闭</text>
  </view>

  <view class="assign-order">
    <view class="assign-order__text">{{assignOrderText}}</view>
    <view wx:if="{{assignCurrent}}" class="assign-order__now">{{assignCurrent}}</view>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <view class="label">工单类型<text wx:if="{{guide}}" class="label__opt">先定类型，再选该类型维修工</text></view>
    <picker mode="selector" range="{{repairTypeNames}}" value="{{repairTypeIndex}}" bindchange="onPickRepairType">
      <view class="picker">{{repairTypeNames[repairTypeIndex] || '请选择工单类型'}}</view>
    </picker>

    <view class="label mt">选择维修工<text wx:if="{{guide}}" class="label__opt">只显示该类型可接单人员，手上单少的排前面</text></view>

    <view wx:if="{{techLoading}}" class="center muted">加载中…</view>
    <block wx:elif="{{techError}}">
      <view class="error">{{techError}}</view>
      <button class="btn btn--outline mt" bindtap="onRetryTechnicians">重试</button>
    </block>
    <block wx:else>
      <view wx:if="{{!technicians.length}}" class="muted">
        该类型还没有配置可用维修工，请先到后台“报修类型配置”补充默认维修工或员工工种。
      </view>
      <view
        wx:for="{{technicians}}"
        wx:key="id"
        class="tech {{pickedTechId === item.id ? 'tech--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickTech"
      >
        <view class="tech__body">
          <view class="tech__name">{{item.name}}</view>
          <view class="tech__meta">{{item.phone || '未留电话'}}</view>
        </view>
        <!-- 一律写「在手 N 单」，0 单也照写，不再写「当前空闲」：
             派单的人要比的是数字（谁手上少派给谁），两种句式混排还得先换算一下；
             而且「空闲」是对人的断言 —— 他手上没这个系统里的单，不等于他闲着。
             0 单仍用绿色标出来，颜色只做「最闲的那个」的视觉提示，不再下结论 -->
        <view class="tech__load {{item.openCount ? '' : 'tech__load--free'}}">
          在手 {{item.openCount}} 单
        </view>
      </view>
    </block>

    <view class="label mt">要求完成时限</view>
    <picker mode="selector" range="{{slaOptions}}" value="{{slaIndex}}" bindchange="onPickSla">
      <view class="picker">{{slaOptions[slaIndex]}}</view>
    </picker>

    <view class="label mt">派单备注<text class="label__opt">选填，维修工能看到</text></view>
    <button wx:if="{{hasSpeech}}" class="assign-speech {{assignRecording ? 'assign-speech--on' : ''}}" bindtouchstart="onAssignSpeechStart" bindtouchend="onAssignSpeechEnd" bindtouchcancel="onAssignSpeechEnd">
      <view class="assign-speech__mic"></view>
      <view><view class="assign-speech__title">{{assignRecording ? '松开结束' : '按住说派单备注'}}</view><view wx:if="{{guide}}" class="assign-speech__desc">说完自动变成文字，还可以修改</view></view>
    </button>
    <view wx:if="{{assignRecording}}" class="assign-speech__listening">正在听：{{assignSpeechPartial || '请继续说…'}}</view>
    <textarea
      class="assign-note"
      maxlength="500"
      placeholder="如：业主下午在家，优先处理"
      value="{{assignNote}}"
      bindinput="onAssignNote"
    />

    <view class="error" wx:if="{{assignError}}">{{assignError}}</view>
  </scroll-view>

  <view class="sheet__foot">
    <button
      class="btn btn--primary"
      loading="{{assigning}}"
      disabled="{{assigning}}"
      bindtap="onSubmitAssign"
    ><view class="btn__icon icon-action--send-white"></view><text>确认派单</text></button>
  </view>
</view>
