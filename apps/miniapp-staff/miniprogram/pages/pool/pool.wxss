/* 卡片结构（.wo-card / .kv）、筛选条（.chips / .chip）、底部面板（.sheet）
   都在 app.wxss / tokens.wxss 里统一定义，这里只写这一屏独有的东西 */

/* 等待材料的单：缺什么料要在池子里就看得见，否则接了也干不了 */
.wait-mat {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  background: rgba(250, 173, 20, 0.1);
  color: #ad6800;
  font-size: var(--font-md);
  line-height: 1.6;
}

/* 页头下的两个报修入口。
   工单池和派单台用同一套：等宽并成一行、矮一档，明确「这不是本屏的主按钮」——
   这一屏的主线是看单和接/派单，报修只是巡查时顺手提一单。
   间距写在容器上，写在 .btn 上会被 app.wxss 的 margin-left/right !important 那条规则带偏。
   .btn-row .btn 在 app.wxss 里已经是 flex:1，这里只需要把高度提回可点的下限 */
.report-entry { gap: var(--space-md); }
.report-entry--row { margin-bottom: var(--space-lg); }
.report-entry--row .btn { height: 88rpx; }

/* ---------- 筛选与搜索（两种模式共用） ---------- */

/* 搜索行：输入框吃掉剩余宽度，按钮按自身内容宽（.btn 的 width:100% 在 app.wxss
   里带 !important，只能靠 .btn--sm 的 width:auto 覆盖，所以这里不再写 width） */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: var(--space-lg);
}
.search-row .input { flex: 1; min-width: 0; }

/* 列表到 100 条上限时的说明，和列表之间留出一整档 */
.cap-tip { padding-top: var(--space-lg); line-height: 1.6; }

/* 派单面板里被派的那一单：写清「在给哪张单派人」，否则面板一拉出来就脱离上下文 */
.assign-order {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
}
.assign-order__text { font-size: var(--font-lg); line-height: 1.5; }
.assign-order__now {
  margin-top: 8rpx;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

/* 维修工一行：整行可点，选中用品牌色描边 + 左侧色条，不填底
   （填底在户外强光下反光，看不清上面的字） */
.tech {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-card-bg);
}
.tech--on {
  border-color: var(--color-brand);
  border-left-width: 10rpx;
}
.tech__body { flex: 1; min-width: 0; }
.tech__name { font-size: var(--font-xl); font-weight: 500; line-height: 1.5; }
.tech__meta {
  margin-top: 6rpx;
  font-size: var(--font-md);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}
/* 「在手 N 单」是派单时唯一的判断依据，右侧单独一列，别混进上面那行小字 */
.tech__load {
  flex-shrink: 0;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  white-space: nowrap;
}
.tech__load--free { color: var(--color-success); }

/* 工单池卡片正文加大加粗（2026-08-27 要求）：标题（类型）保持 36rpx 不动，
   信息行的值从正文 32rpx 提到 34rpx 并加粗 —— 维修工站在楼道里单手看，地址和描述才是要认的字。
   标签（.kv__k）不动，仍是浅灰 32rpx，主次才拉得开；「已等 N 天」小标保持原字重，别抢戏 */
.wo-card .kv__v {
  font-size: var(--font-xl);
  font-weight: 600;
}
.wo-card .kv__v .kv__tag { font-weight: 500; }
.wo-card .kv__tag--danger { font-weight: 600; }
