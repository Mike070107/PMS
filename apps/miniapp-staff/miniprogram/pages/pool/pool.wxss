/* 卡片结构（.wo-card / .kv）、筛选条（.chips / .chip）、底部面板（.sheet）
   都在 app.wxss / tokens.wxss 里统一定义，这里只写这一屏独有的东西 */

/* 页头下的两个报修入口。
   工单池和派单台用同一套：等宽并成一行，用图标和 116rpx 高度突出巡查报修入口。
   间距写在容器上，写在 .btn 上会被 app.wxss 的 margin-left/right !important 那条规则带偏。
   .btn-row .btn 在 app.wxss 里已经是 flex:1，这里只定义本屏的加强规格。 */
.report-entry { gap: 16rpx; }
.report-entry--row { margin-bottom: var(--space-lg); }
/* 比全局按钮（104rpx / --font-2xl 36rpx）再大一档：这一屏里报修是唯一的「录入」动作，
   其余都是浏览和筛选，做大一档才找得到。2026-08-30 用户反馈原来那版（88rpx / 30rpx）
   看不见 —— 别再往回调小，要调先问。 */
.report-entry--row .btn {
  height: 116rpx;
  padding: 0 22rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 26rpx;
}
.report-entry--row .btn__icon { width: 44rpx; height: 44rpx; margin-right: 12rpx; }

/* ---------- 筛选与搜索（两种模式共用） ---------- */

/* 搜索行：输入框吃掉剩余宽度，按钮按自身内容宽（.btn 的 width:100% 在 app.wxss
   里带 !important，只能靠 .btn--sm 的 width:auto 覆盖，所以这里不再写 width） */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx;
  margin-bottom: var(--space-lg);
  border: 2rpx solid #d8e3ec;
  border-radius: 24rpx;
  background: #ffffff;
}
.search-row .input { flex: 1; min-width: 0; border: none; background: transparent; }

/* 列表到 100 条上限时的说明，和列表之间留出一整档 */
.cap-tip { padding-top: var(--space-lg); line-height: 1.6; }

/* 等待材料默认收成摘要卡：现场先扫地点和缺什么，确实要处理时再展开。 */
.waiting-fold {
  padding: 26rpx 28rpx 22rpx;
  border-left: 8rpx solid #6f9bc0;
  transition: transform 120ms ease, background-color 120ms ease;
}
.waiting-fold--hover { transform: scale(.992); background: #f7fbff; }
.waiting-fold__head,
.waiting-fold__foot,
.waiting-fold__addr {
  display: flex;
  align-items: center;
}
.waiting-fold__head { justify-content: space-between; gap: 20rpx; }
.waiting-fold__title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}
.waiting-fold__addr {
  gap: 10rpx;
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #394b5d;
}
.waiting-fold__addr text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.waiting-fold__material {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #edf4fa;
  color: #315b80;
  font-size: 27rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.waiting-fold__foot {
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
}
.waiting-fold__expand,
.waiting-collapse {
  flex-shrink: 0;
  color: var(--color-brand);
  font-weight: 600;
}
.waiting-collapse { margin-right: auto; font-size: var(--font-md); }

/* ---------- 接单收纳动画 ---------- */
.order-slot {
  position: relative;
  margin-bottom: var(--space-lg);
  overflow: visible;
}
.order-slot > .order-card { margin-bottom: 0; }
.order-slot--collecting { z-index: 80; pointer-events: none; }
.order-slot--collecting .order-card {
  transform-origin: 88% 100%;
  animation: collect-to-mine 580ms cubic-bezier(.22, .82, .25, 1) both;
  box-shadow: 0 18rpx 48rpx rgba(24, 88, 139, .28);
}
.order-slot--closing {
  overflow: hidden;
  animation: close-order-slot 300ms cubic-bezier(.45, 0, .2, 1) both;
}
.order-slot--following {
  animation: fill-gap-bounce 300ms cubic-bezier(.2, .85, .25, 1) both;
}

.mine-receiver {
  position: fixed;
  right: 22rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  z-index: 1200;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #3d6598, #31558a);
  box-shadow: 0 12rpx 34rpx rgba(23, 79, 131, .32);
  font-size: 24rpx;
  animation: receiver-pop 580ms ease both;
}
.mine-receiver__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b9f6ca;
  box-shadow: 0 0 0 8rpx rgba(185, 246, 202, .16);
}

@keyframes collect-to-mine {
  0% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  16% { opacity: 1; transform: translate3d(0, -12rpx, 0) scale(1.025); }
  62% { opacity: .88; transform: translate3d(90rpx, 24vh, 0) scale(.58) rotate(1.5deg); }
  100% { opacity: 0; transform: translate3d(230rpx, 48vh, 0) scale(.12) rotate(4deg); }
}
@keyframes close-order-slot {
  from { margin-bottom: var(--space-lg); opacity: 1; }
  to { height: 0; margin-bottom: 0; opacity: 0; }
}
@keyframes fill-gap-bounce {
  0% { transform: translateY(10rpx); }
  62% { transform: translateY(-5rpx); }
  100% { transform: translateY(0); }
}
@keyframes receiver-pop {
  0% { opacity: 0; transform: translateY(26rpx) scale(.86); }
  34% { opacity: 1; transform: translateY(0) scale(1.05); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* 派单面板里被派的那一单：写清「在给哪张单派人」，否则面板一拉出来就脱离上下文 */
.assign-order {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  background: #edf4fa;
}
.assign-order__text { font-size: var(--font-lg); line-height: 1.5; }
.assign-order__now {
  margin-top: 8rpx;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

/* 派单备注给大号按压区：办公室人员不需要先点输入框再找系统语音键。 */
.assign-speech {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 18rpx 24rpx;
  margin-top: 14rpx;
  border: 2rpx solid #bfd2e4;
  border-radius: 22rpx;
  color: var(--color-brand);
  background: #edf5fc;
}
.assign-speech::after { border: none; }
.assign-speech--on { color: #fff; border-color: var(--color-brand); background: var(--color-brand); }
.assign-speech__mic {
  position: relative;
  width: 26rpx;
  height: 36rpx;
  flex-shrink: 0;
  border: 5rpx solid currentColor;
  border-radius: 16rpx;
}
.assign-speech__mic::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -15rpx;
  width: 28rpx;
  height: 16rpx;
  border: 5rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
  transform: translateX(-50%);
}
.assign-speech__title { font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.assign-speech__desc { margin-top: 4rpx; font-size: 24rpx; opacity: .78; line-height: 1.35; }
.assign-speech__listening {
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  color: #9a5d00;
  background: #fff5dd;
  font-size: 26rpx;
  line-height: 1.5;
}
.assign-note {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 18rpx;
  background: var(--color-card-bg);
  font-size: var(--font-lg);
  line-height: 1.6;
}

/* 维修工一行：整行可点。选中 = 品牌色实底 + 白字。
   原来是「描边 + 左侧色条、不填底」，理由写的是「填底在户外强光下反光」——
   2026-09-01 现场反馈正相反：户外屏幕不够亮时，描边式的选中和未选中几乎一样，
   根本看不出派给了谁。整站选中态统一成实底白字（见 app.wxss 的 .chip--on 注释）。 */
.tech {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-card-bg);
}
.tech--on {
  border-color: var(--color-brand);
  background: linear-gradient(135deg, #3d6598, #31558a);
}
/* 实底之后卡片里三行字都要跟着翻白，否则灰字压在深蓝上更看不清 */
.tech--on .tech__name,
.tech--on .tech__meta,
.tech--on .tech__load { color: #fff; }
/* 「在手 0 单」的绿在海军蓝上发闷，提亮一档才看得出是「最闲的那个」
   （同 app.wxss 深色页头里对 --color-danger 的处理） */
.tech--on .tech__load--free { color: #b7f5c8; }
.tech__body { flex: 1; min-width: 0; }
.tech__name { font-size: var(--font-xl); font-weight: 500; line-height: 1.5; }
.tech__meta {
  margin-top: 6rpx;
  font-size: var(--font-md);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}
/* 「在手 N 单」是派单时唯一的判断依据，右侧单独一列，别混进上面那行小字 */
.tech__load {
  flex-shrink: 0;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  white-space: nowrap;
}
.tech__load--free { color: var(--color-success); }

/* 页头三个数字可点：选中的那个加实底描边 + 勾。
   写在页面样式里而不是 app.wxss —— 那个文件另一个会话正在改，避免撞车；
   页面 wxss 在 app.wxss 之后加载，同特异度这边赢。 */
.work-metric { position: relative; }
.work-metric--on {
  border-color: #31558a !important;
  background: #e8f1fb !important;
  box-shadow: 0 0 0 2rpx rgba(49,85,138,.25);
}
.work-metric--on .work-metric__label { color: #26527f; font-weight: 700; }
.work-metric--on::after {
  content: '';
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #31558a;
}
