<view class="container">
  <view class="page-lead">
    <view class="page-lead__title">
      <block wx:if="{{canApprove}}">待我审批 {{list.length}} 条</block>
      <block wx:else>采购审批</block>
    </view>
    <view class="page-lead__sub">
      <block wx:if="{{canApprove}}">当前环节：{{roleHint}}。通过后进入下一环节，驳回要写清原因。</block>
      <block wx:else>{{roleHint}}</block>
    </view>
  </view>

  <view wx:if="{{canApprove && !list.length && loaded}}">
    <pms-empty text="没有待你审批的采购申请"/>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="wo-card__head">
      <view class="wo-card__type">{{item.amountText}}</view>
      <view class="pr-no">{{item.requestNo}}</view>
    </view>

    <view class="items">{{item.itemsText}}</view>

    <view class="wo-card__foot">
      <view class="wo-card__meta">
        <view wx:if="{{item.workOrderId}}">来自工单 #{{item.workOrderId}}</view>
        <view>提交 {{item.createdAtText}}</view>
      </view>
    </view>

    <view class="btn-row mt">
      <button
        class="btn btn--ghost"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onReject"
      >驳回</button>
      <button
        class="btn btn--primary"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onApprove"
      >通过</button>
    </view>
  </view>
</view>
