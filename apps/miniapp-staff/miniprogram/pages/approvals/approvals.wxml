<view class="container container--tabbar">
  <view class="screen-head">
    <view class="screen-head__title">
      <block wx:if="{{canApprove}}">待我审批 {{list.length}} 条</block>
      <block wx:else>采购审批</block>
    </view>
    <view class="screen-head__desc">核对材料、数量和金额后完成审批</view>
  </view>

  <!-- 没权限时才需要解释「为什么这一屏是空的」；有权限的人不用被告知怎么审批 -->
  <view wx:if="{{!canApprove}}" class="card">
    <view class="muted">{{roleHint}}</view>
  </view>

  <view wx:if="{{canApprove && !list.length && loaded}}">
    <pms-empty text="没有待你审批的采购申请"/>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card wo-card">
    <view class="wo-card__head">
      <view class="wo-card__title">
        <text class="wo-card__type">{{item.amountText}}</text>
      </view>
    </view>

    <view class="kv"><text class="kv__k">申请编号</text><text class="kv__v">{{item.requestNo}}</text></view>
    <view class="kv"><text class="kv__k">采购明细</text><text class="kv__v">{{item.itemsText}}</text></view>
    <view class="kv"><text class="kv__k">申请人</text><text class="kv__v">{{item.applicantText}}</text></view>
    <view wx:if="{{item.sourceText}}" class="kv">
      <text class="kv__k">来自工单</text><text class="kv__v">{{item.sourceText}}</text>
    </view>
    <view class="kv"><text class="kv__k">提交时间</text><text class="kv__v">{{item.createdAtText}}</text></view>

    <view class="btn-row mt">
      <button
        class="btn btn--ghost"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onReject"
      >驳回</button>
      <button
        class="btn btn--primary"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onApprove"
      >通过</button>
    </view>
  </view>
</view>
