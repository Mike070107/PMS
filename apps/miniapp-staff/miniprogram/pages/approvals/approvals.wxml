<!-- 采购申请明细行：待汇总和待审批共用。缩略图 / 名称 型号 / 备注 / 数量·金额 / 来源工单（可点进工单）
     （2026-09-05 Mike：申请单要看得到图、型号、备注、来源工单） -->
<template name="pr-line">
  <view class="pr-line">
    <image wx:if="{{line.photoUrl}}" class="pr-line__thumb" src="{{line.photoUrl}}" mode="aspectFill" data-url="{{line.photoUrl}}" data-urls="{{line.photoUrls}}" catchtap="onPreviewPhoto"/>
    <view wx:else class="pr-line__thumb pr-line__thumb--empty">无图</view>
    <view class="pr-line__body">
      <view class="pr-line__name">{{line.name}}<text wx:if="{{line.spec}}" class="pr-line__spec">{{line.spec}}</text></view>
      <view wx:if="{{line.note}}" class="pr-line__note">{{line.note}}</view>
      <view class="pr-line__meta">
        <text>×{{line.qty}}{{line.unit || ''}} · {{line.amountText}}</text>
        <text wx:if="{{line.sourceWorkOrderId}}" class="pr-line__src" data-order-id="{{line.sourceWorkOrderId}}" catchtap="onOpenSourceOrder">{{line.sourceText}} ›</text>
        <text wx:else class="pr-line__src pr-line__src--plain">{{line.sourceText}}</text>
      </view>
    </view>
  </view>
</template>

<view class="container container--tabbar">
  <block wx:if="{{mode === 'maintenance'}}">
    <view class="screen-head screen-head--help">
      <view class="screen-head__title">待我签字 {{maintenanceList.length}} 张</view>
      <view wx:if="{{guide}}" class="screen-head__desc">只显示当前轮到你的单据，小程序内任务不过期</view>
      <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
    </view>
    <view wx:if="{{!maintenanceList.length && loaded}}"><pms-empty text="没有待你签字的养护单"/></view>
    <view wx:for="{{maintenanceList}}" wx:key="id" class="card wo-card maintenance-card" data-id="{{item.id}}" bindtap="onOpenMaintenance">
      <view class="wo-card__head"><view class="wo-card__title"><text class="wo-card__type">{{item.addressText || '地址待补充'}}</text></view><text class="maintenance-card__status">待{{item.slotLabel || '签字'}}</text></view>
      <view class="kv"><text class="kv__k">养护单号</text><text class="kv__v">{{item.paperNo || item.orderNo}}</text></view>
      <view class="kv"><text class="kv__k">修理项目</text><text class="kv__v">{{item.repairItem || '未填写'}}</text></view>
      <view class="kv"><text class="kv__k">修理人</text><text class="kv__v">{{item.repairerName || '未签名'}}</text></view>
      <view class="kv"><text class="kv__k">工料费</text><text class="kv__v">{{item.amountText}}</text></view>
      <view class="maintenance-card__foot"><text>{{item.createdAtText}}</text><button loading="{{busyId === item.id}}" disabled="{{busyId !== 0}}">查看并签字 ›</button></view>
    </view>
  </block>

  <block wx:else>
  <view class="screen-head screen-head--help">
    <view class="screen-head__title">
      <block wx:if="{{stage === 'summary' && canSummarize}}">待汇总 {{summaryList.length}} 张</block>
      <block wx:elif="{{canApprove}}">待我审批 {{list.length}} 条</block>
      <block wx:else>采购审批</block>
    </view>
    <view wx:if="{{guide}}" class="screen-head__desc">{{stage === 'summary' ? '勾选几张合并成一张提交经理；不同管理处的不能合并' : '核对材料、数量和金额后完成审批'}}</view>
    <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
  </view>

  <!-- 两档都有权限才出现切换；只有一档的直接落到那档 -->
  <view wx:if="{{canApprove && canSummarize}}" class="tabs">
    <view class="tab {{stage === 'review' ? 'tab--on' : ''}}" data-stage="review" bindtap="onSwitchStage">待我审批 {{list.length}}</view>
    <view class="tab {{stage === 'summary' ? 'tab--on' : ''}}" data-stage="summary" bindtap="onSwitchStage">待汇总 {{summaryList.length}}</view>
  </view>

  <!-- 没权限时才需要解释「为什么这一屏是空的」；有权限的人不用被告知怎么审批 -->
  <view wx:if="{{!canApprove && !canSummarize}}" class="card">
    <view class="muted">{{roleHint}}</view>
  </view>

  <!-- ===== 办公室汇总：勾选合并提交经理 ===== -->
  <block wx:if="{{stage === 'summary' && canSummarize}}">
    <view wx:if="{{summaryList.length}}" class="summary-bar">
      <text class="summary-bar__text">{{selectedCount > 1 ? '已勾选 ' + selectedCount + ' 张：可先合并成一张（在后台改名称、型号、照片），或直接提交到「' + (summaryList[0].nextStepLabel || '物业经理审批') + '」' : selectedCount ? '已勾选 1 张，提交到「' + (summaryList[0].nextStepLabel || '物业经理审批') + '」' : '点卡片勾选；采购按批次走，多张可合并成一张'}}</text>
      <view class="summary-bar__btns">
        <button wx:if="{{selectedCount > 1}}" class="btn btn--outline btn--sm summary-bar__btn" disabled="{{summarizing}}" loading="{{summarizing}}" bindtap="onMergeSummary">合并成一张</button>
        <button class="btn btn--primary btn--sm summary-bar__btn" disabled="{{!selectedCount || summarizing}}" loading="{{summarizing}}" bindtap="onSubmitSummary">提交{{selectedCount ? '（' + selectedCount + '）' : ''}}</button>
      </view>
    </view>
    <view wx:if="{{summaryEmpty}}"><pms-empty text="没有待汇总的采购申请"/></view>
    <view wx:for="{{summaryList}}" wx:key="id" class="card wo-card summary-card {{selectedMap[item.id] ? 'summary-card--on' : ''}}" data-id="{{item.id}}" bindtap="onToggleSelect">
      <view class="wo-card__head summary-card__head">
        <view class="pick-box {{selectedMap[item.id] ? 'pick-box--on' : ''}}"></view>
        <view class="wo-card__title"><text class="wo-card__type">{{item.amountText}}</text></view>
        <text class="summary-card__no">{{item.requestNo}}</text>
        <text class="pr-detail-link" data-id="{{item.id}}" catchtap="onOpenDetail">详情 / 编辑 ›</text>
      </view>
      <block wx:for="{{item.reviewItems}}" wx:for-item="line" wx:key="lineId"><template is="pr-line" data="{{line: line}}"/></block>
      <view wx:if="{{item.reason}}" class="kv"><text class="kv__k">申请原因</text><text class="kv__v">{{item.reason}}</text></view>
      <view class="kv"><text class="kv__k">申请人</text><text class="kv__v">{{item.applicantText}} · {{item.createdAtText}}</text></view>
    </view>
  </block>

  <!-- ===== 待我审批 ===== -->
  <block wx:if="{{stage === 'review' && canApprove}}">
  <view wx:if="{{reviewEmpty}}">
    <pms-empty text="没有待你审批的采购申请"/>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card wo-card">
    <view class="wo-card__head">
      <view class="wo-card__title">
        <text class="wo-card__type">{{item.amountText}}</text>
      </view>
    </view>

    <view class="kv"><text class="kv__k">申请编号</text><text class="kv__v">{{item.requestNo}}<text class="pr-detail-link" data-id="{{item.id}}" catchtap="onOpenDetail">详情 ›</text></text></view>
    <view class="label mt">采购明细<text class="label__opt">可单项驳回</text></view>
    <view wx:for="{{item.reviewItems}}" wx:for-item="line" wx:key="lineId" class="approval-line">
      <view class="approval-line__body"><template is="pr-line" data="{{line: line}}"/></view>
      <button
        class="btn btn--ghost btn--sm"
        data-id="{{item.id}}"
        data-line="{{line.lineId}}"
        data-name="{{line.name}}"
        disabled="{{busyId !== 0}}"
        bindtap="onRejectItem"
      >驳回此项</button>
    </view>
    <view wx:if="{{item.reason}}" class="kv"><text class="kv__k">申请原因</text><text class="kv__v">{{item.reason}}</text></view>
    <view class="kv"><text class="kv__k">申请人</text><text class="kv__v">{{item.applicantText}}</text></view>
    <view class="kv"><text class="kv__k">提交时间</text><text class="kv__v">{{item.createdAtText}}</text></view>

    <view class="btn-row mt">
      <button
        class="btn btn--ghost"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onReject"
      ><view class="btn__icon icon-action--close-gray"></view><text>整单驳回</text></button>
      <button
        class="btn btn--primary"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onApprove"
      ><view class="btn__icon icon-action--check-white"></view><text>通过</text></button>
    </view>
  </view>
  </block>
  </block>
</view>
