<!-- 采购申请明细行：待汇总和待审批共用。缩略图 / 名称 型号 / 备注 / 数量·金额 / 来源工单（可点进工单）
     （2026-09-05 Mike：申请单要看得到图、型号、备注、来源工单） -->
<template name="pr-line">
  <view class="pr-line">
    <image wx:if="{{line.photoUrl}}" class="pr-line__thumb" src="{{line.photoUrl}}" mode="aspectFill" data-url="{{line.photoUrl}}" data-urls="{{line.photoUrls}}" catchtap="onPreviewPhoto"/>
    <view wx:else class="pr-line__thumb pr-line__thumb--empty">无图</view>
    <view class="pr-line__body">
      <view class="pr-line__name">{{line.name}}<text wx:if="{{line.spec}}" class="pr-line__spec">{{line.spec}}</text></view>
      <view wx:if="{{line.note}}" class="pr-line__note">{{line.note}}</view>
      <view class="pr-line__meta">
        <text>×{{line.qty}}{{line.unit || ''}} · {{line.amountText}}</text>
        <text wx:if="{{line.sourceWorkOrderId}}" class="pr-line__src" data-order-id="{{line.sourceWorkOrderId}}" catchtap="onOpenSourceOrder">{{line.sourceText}} ›</text>
        <text wx:else class="pr-line__src pr-line__src--plain">{{line.sourceText}}</text>
      </view>
    </view>
  </view>
</template>

<view class="container container--tabbar">
  <block wx:if="{{mode === 'maintenance'}}">
    <view class="screen-head screen-head--help">
      <view class="screen-head__title">待我签字 {{maintenanceList.length}} 张</view>
      <view wx:if="{{guide}}" class="screen-head__desc">只显示当前轮到你的单据，小程序内任务不过期</view>
      <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
    </view>
    <view wx:if="{{!maintenanceList.length && loaded}}"><pms-empty text="没有待你签字的养护单"/></view>
    <view wx:for="{{maintenanceList}}" wx:key="id" class="card wo-card maintenance-card" data-id="{{item.id}}" bindtap="onOpenMaintenance">
      <view class="wo-card__head"><view class="wo-card__title"><text class="wo-card__type">{{item.addressText || '地址待补充'}}</text></view><text class="maintenance-card__status">待{{item.slotLabel || '签字'}}</text></view>
      <view class="kv"><text class="kv__k">养护单号</text><text class="kv__v">{{item.paperNo || item.orderNo}}</text></view>
      <view class="kv"><text class="kv__k">修理项目</text><text class="kv__v">{{item.repairItem || '未填写'}}</text></view>
      <view class="kv"><text class="kv__k">修理人</text><text class="kv__v">{{item.repairerName || '未签名'}}</text></view>
      <view class="kv"><text class="kv__k">工料费</text><text class="kv__v">{{item.amountText}}</text></view>
      <view class="maintenance-card__foot"><text>{{item.createdAtText}}</text><button loading="{{busyId === item.id}}" disabled="{{busyId !== 0}}">查看并签字 ›</button></view>
    </view>
  </block>

  <block wx:else>
  <view class="screen-head screen-head--help">
    <view class="screen-head__title">审批中心</view>
    <view class="screen-head__desc">所有待办统一处理，已审批仅记录你本人的处理</view>
    <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
    <view wx:if="{{guide}}" class="screen-head__desc">按当前权限与管理范围显示；数量不受分页影响。调拨通过后进入在途，收货仍由接收仓确认。</view>
  </view>
  <view class="tabs center-tabs">
    <view class="tab {{centerTab === 'pending' ? 'tab--on' : ''}}" data-tab="pending" bindtap="onCenterTab">待审批 {{centerTabs.pending}}</view>
    <view class="tab {{centerTab === 'done' ? 'tab--on' : ''}}" data-tab="done" bindtap="onCenterTab">已审批 {{centerTabs.done}}</view>
  </view>
  <view class="center-search">
    <input value="{{keyword}}" placeholder="搜索单号、车牌、材料或申请人" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchCenter"/>
    <button bindtap="onSearchCenter">搜索</button>
  </view>
  <scroll-view class="center-filter" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="center-chip {{category === 'all' ? 'center-chip--on' : ''}}" data-category="all" bindtap="onCenterCategory">全部 {{allCount}}</view>
    <view wx:for="{{categories}}" wx:key="key" class="center-chip {{category === item.key ? 'center-chip--on' : ''}}" data-category="{{item.key}}" bindtap="onCenterCategory">{{item.label}} {{item.count}}</view>
  </scroll-view>
  <view wx:if="{{loadingCenter}}" class="card center-state">正在加载审批记录…</view>
  <view wx:elif="{{centerError}}" class="card center-state"><text>{{centerError}}</text><button class="btn btn--outline" bindtap="onRetryCenter">重新加载</button></view>
  <block wx:else>
  <view wx:if="{{loaded && !centerTotal}}"><pms-empty text="{{centerTab === 'done' ? '暂无你处理过的审批记录' : '暂无符合条件的待审批'}}"/></view>

  <!-- ===== 亲情车待经理审批 ===== -->
  <block wx:if="{{centerTab === 'pending' && familyList.length}}">
    <view wx:if="{{familyEmpty}}"><pms-empty text="没有待你审批的亲情车"/></view>
    <view wx:for="{{familyList}}" wx:key="id" class="card wo-card family-card">
      <view class="wo-card__head family-card__head">
        <text class="family-card__plate">{{item.plate}}</text>
        <text class="family-card__room">{{item.roomText}}</text>
      </view>
      <view class="kv"><text class="kv__k">业主</text><text class="kv__v">{{item.ownerName || '未登记'}}</text></view>
      <view class="kv"><text class="kv__k">车主</text><text class="kv__v">{{item.carOwnerText}}</text></view>
      <view wx:if="{{item.carOwnerPhone}}" class="kv"><text class="kv__k">车主电话</text><text class="kv__v">{{item.carOwnerPhone}}</text></view>
      <view class="kv"><text class="kv__k">开通车库</text><text class="kv__v">{{item.garageText || '未选择'}}</text></view>
      <view wx:if="{{item.remark}}" class="kv"><text class="kv__k">备注</text><text class="kv__v">{{item.remark}}</text></view>
      <view class="kv"><text class="kv__k">办公室</text><text class="kv__v">{{item.officeNote || '资料齐全'}}</text></view>

      <view class="label mt">资料 {{item.files.length}} 份<text class="label__opt">点图可放大</text></view>
      <view wx:if="{{item.files.length}}" class="family-photos">
        <block wx:for="{{item.files}}" wx:for-item="file" wx:key="index">
          <image wx:if="{{file.photo}}" class="family-photos__item" mode="aspectFill" src="{{file.photo}}" data-url="{{file.photo}}" data-urls="{{item.photos}}" bindtap="onPreviewFamilyPhoto"/>
          <view wx:else class="family-photos__pdf" data-url="{{file.fileUrl}}" bindtap="onOpenApprovalFile">{{file.fileName}} · 打开</view>
        </block>
      </view>
      <view wx:else class="muted">没有资料，不能通过；请退回让办公室上传</view>
      <view class="family-file-src">资料 {{item.files.length}} 份，{{item.files[0].source === 'owner' ? '由业主扫码上传' : '由办公室上传'}}</view>

      <view class="kv"><text class="kv__k">提交时间</text><text class="kv__v">{{item.createdAtText}}</text></view>
      <view class="btn-row mt">
        <button class="btn btn--ghost" data-id="{{item.id}}" data-plate="{{item.plate}}" loading="{{familyBusyId === item.id}}" disabled="{{familyBusyId !== 0}}" bindtap="onReturnFamily"><text>退回办公室</text></button>
        <button class="btn btn--primary" data-id="{{item.id}}" data-plate="{{item.plate}}" loading="{{familyBusyId === item.id}}" disabled="{{familyBusyId !== 0 || !item.files.length}}" bindtap="onApproveFamily"><text>通过并开通</text></button>
      </view>
    </view>
  </block>



  <!-- ===== 办公室汇总：勾选合并提交经理 ===== -->
  <block wx:if="{{centerTab === 'pending' && summaryList.length}}">
    <view wx:if="{{summaryList.length}}" class="summary-bar">
      <text class="summary-bar__text">{{selectedCount > 1 ? '已勾选 ' + selectedCount + ' 张：可先合并成一张（在后台改名称、型号、照片），或直接提交到「' + (summaryList[0].nextStepLabel || '物业经理审批') + '」' : selectedCount ? '已勾选 1 张，提交到「' + (summaryList[0].nextStepLabel || '物业经理审批') + '」' : '点卡片勾选；采购按批次走，多张可合并成一张'}}</text>
      <view class="summary-bar__btns">
        <button wx:if="{{selectedCount > 1}}" class="btn btn--outline btn--sm summary-bar__btn" disabled="{{summarizing}}" loading="{{summarizing}}" bindtap="onMergeSummary">合并成一张</button>
        <button class="btn btn--primary btn--sm summary-bar__btn" disabled="{{!selectedCount || summarizing}}" loading="{{summarizing}}" bindtap="onSubmitSummary">提交{{selectedCount ? '（' + selectedCount + '）' : ''}}</button>
      </view>
    </view>
    <view wx:if="{{summaryEmpty}}"><pms-empty text="没有待汇总的采购申请"/></view>
    <view wx:for="{{summaryList}}" wx:key="id" class="card wo-card summary-card {{selectedMap[item.id] ? 'summary-card--on' : ''}}" data-id="{{item.id}}" bindtap="onToggleSelect">
      <view class="wo-card__head summary-card__head">
        <view class="pick-box {{selectedMap[item.id] ? 'pick-box--on' : ''}}"></view>
        <view class="wo-card__title"><text class="wo-card__type">{{item.amountText}}</text></view>
        <text class="summary-card__no">{{item.requestNo}}</text>
        <text class="pr-detail-link" data-id="{{item.id}}" catchtap="onOpenDetail">详情 / 编辑 ›</text>
      </view>
      <block wx:for="{{item.reviewItems}}" wx:for-item="line" wx:key="lineId"><template is="pr-line" data="{{line: line}}"/></block>
      <view wx:if="{{item.reason}}" class="kv"><text class="kv__k">申请原因</text><text class="kv__v">{{item.reason}}</text></view>
      <view class="kv"><text class="kv__k">申请人</text><text class="kv__v">{{item.applicantText}} · {{item.createdAtText}}</text></view>
    </view>
  </block>

  <!-- ===== 待我审批 ===== -->
  <block wx:if="{{centerTab === 'pending' && list.length}}">
  <view wx:if="{{reviewEmpty}}">
    <pms-empty text="没有待你审批的采购申请"/>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card wo-card">
    <view class="wo-card__head">
      <view class="wo-card__title">
        <text class="wo-card__type">{{item.amountText}}</text>
      </view>
    </view>

    <view class="kv"><text class="kv__k">申请编号</text><text class="kv__v">{{item.requestNo}}<text class="pr-detail-link" data-id="{{item.id}}" catchtap="onOpenDetail">详情 ›</text></text></view>
    <view class="label mt">采购明细<text class="label__opt">可单项驳回</text></view>
    <view wx:for="{{item.reviewItems}}" wx:for-item="line" wx:key="lineId" class="approval-line">
      <view class="approval-line__body"><template is="pr-line" data="{{line: line}}"/></view>
      <button
        class="btn btn--ghost btn--sm"
        data-id="{{item.id}}"
        data-line="{{line.lineId}}"
        data-name="{{line.name}}"
        disabled="{{busyId !== 0}}"
        bindtap="onRejectItem"
      >驳回此项</button>
    </view>
    <view wx:if="{{item.reason}}" class="kv"><text class="kv__k">申请原因</text><text class="kv__v">{{item.reason}}</text></view>
    <view class="kv"><text class="kv__k">申请人</text><text class="kv__v">{{item.applicantText}}</text></view>
    <view class="kv"><text class="kv__k">提交时间</text><text class="kv__v">{{item.createdAtText}}</text></view>

    <view class="btn-row mt">
      <button
        class="btn btn--ghost"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onReject"
      ><view class="btn__icon icon-action--close-gray"></view><text>整单驳回</text></button>
      <button
        class="btn btn--primary"
        data-id="{{item.id}}"
        loading="{{busyId === item.id}}"
        disabled="{{busyId !== 0}}"
        bindtap="onApprove"
      ><view class="btn__icon icon-action--check-white"></view><text>通过</text></button>
    </view>
  </view>
  </block>
  <view wx:for="{{genericRows}}" wx:key="key" class="card center-card">
    <view class="center-card__head"><text class="center-card__category">{{item.label}}</text><text class="center-card__result">{{centerTab === 'done' ? item.result : '待处理'}}</text></view>
    <view class="center-card__title">{{item.title}}</view>
    <view class="center-card__subtitle">{{item.subtitle}}</view>
    <view wx:if="{{item.lines}}" class="center-card__lines">{{item.lines}}</view>
    <view wx:if="{{item.note}}" class="center-card__lines">处理备注：{{item.note}}</view>
    <view wx:if="{{item.detail.note}}" class="center-card__lines">备注：{{item.detail.note}}</view>
    <view wx:if="{{item.files.length}}" class="family-photos">
      <block wx:for="{{item.files}}" wx:for-item="file" wx:key="index">
        <image wx:if="{{file.photo}}" class="family-photos__item" src="{{file.url}}" mode="aspectFill" data-url="{{file.url}}" data-urls="{{item.photos}}" bindtap="onPreviewFamilyPhoto"/>
        <view wx:else class="family-photos__pdf" data-url="{{file.url}}" bindtap="onOpenApprovalFile">{{file.fileName}} · 打开</view>
      </block>
    </view>
    <view class="center-card__time">{{centerTab === 'done' ? '处理时间' : '提交时间'}} · {{item.atText}}</view>
    <view wx:if="{{centerTab === 'pending' && item.actionable}}" class="btn-row mt">
      <button class="btn btn--ghost" data-id="{{item.id}}" data-category="{{item.category}}" data-approved="false" disabled="{{!!centerBusyKey}}" bindtap="onCenterDecision">退回</button>
      <button class="btn btn--primary" data-id="{{item.id}}" data-category="{{item.category}}" data-approved="true" disabled="{{!!centerBusyKey}}" loading="{{centerBusyKey === item.key}}" bindtap="onCenterDecision">通过</button>
    </view>
    <button wx:if="{{item.category === 'stocktake' || item.category === 'maintenance' || (centerTab === 'done' && (item.category === 'purchase' || item.category === 'summary'))}}" class="btn btn--outline mt" data-id="{{item.id}}" data-category="{{item.category}}" bindtap="onOpenCenterDetail">{{centerTab === 'done' ? '查看单据' : item.category === 'maintenance' ? '查看并签字' : '查看差异并复核'}} ›</button>
  </view>
  <view wx:if="{{centerTab === 'done'}}" class="center-history-note">按本人实际处理时间倒序。历史系统未保留的签字时间、被覆盖的审批记录不补造。</view>
  <button wx:if="{{centerHasMore}}" class="btn btn--outline" bindtap="onLoadMoreCenter" disabled="{{loadingCenter}}">加载更多</button>
  <view wx:elif="{{centerTotal}}" class="center-end">已显示全部 {{centerTotal}} 条</view>
  </block>
  </block>
</view>
