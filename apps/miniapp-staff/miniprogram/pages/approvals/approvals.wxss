/* 卡片骨架（.wo-card__head / __foot / __meta、.page-lead）在 app.wxss 里统一定义 */

/* 金额是审批时第一眼要看的，所以占了主标题的位置；单号退到右上角 */
.pr-no {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
  font-variant-numeric: tabular-nums;
}
.items { font-size: var(--font-lg); margin-top: 16rpx; line-height: 1.7; }
