/* 卡片骨架（.wo-card__head / __foot / __meta、.page-lead）在 app.wxss 里统一定义 */

/* 金额是审批时第一眼要看的，所以占了主标题的位置；单号退到右上角 */
.wo-card { border-left: 8rpx solid #d4a04b; }
.wo-card__head { padding-bottom: 20rpx; border-bottom: 2rpx solid #e5ecf2; }
.wo-card__type { color: #a5630b; font-size: 42rpx; }
.btn--ghost { color: var(--color-danger); background: #fff3f3; }
.approval-line { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 2rpx solid #edf1f5; }
.approval-line__body { flex: 1; min-width: 0; }
.approval-line__name { color: #243b4f; font-weight: 600; line-height: 1.5; }
.maintenance-card { border-left: 8rpx solid #d59a37; }
.maintenance-card__status { flex-shrink: 0; padding: 8rpx 16rpx; border-radius: 999rpx; background: #fff3d8; color: #9a650d; font-size: 25rpx; font-weight: 700; }
.maintenance-card__foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 2rpx solid #e5ebf1; color: #73869a; font-size: 25rpx; }
.maintenance-card__foot button { min-width: 220rpx; min-height: 76rpx; margin: 0; border: 0; border-radius: 999rpx; background: #31558a; color: #fff; font-size: 28rpx; font-weight: 700; }
.maintenance-card__foot button::after { border: 0; }
