.meter-detail-loading { padding: 80rpx 0; text-align: center; color: #718499; }
.meter-detail-head { padding: 26rpx 24rpx; }
.meter-detail-head__line { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.meter-detail-head__no { font-family: Consolas, 'SF Mono', monospace; font-size: 38rpx; font-weight: 700; color: #1f334a; }
.meter-detail-head__off { margin-left: auto; font-size: 24rpx; color: #8194a8; }
.meter-detail-head__name { margin-top: 12rpx; font-size: 32rpx; font-weight: 600; color: #1f334a; }
.meter-detail-head__addr { margin-top: 6rpx; font-size: 26rpx; color: #536a80; line-height: 1.5; }
.meter-detail-actions { display: flex; gap: 14rpx; margin-top: 20rpx; flex-wrap: wrap; }
.meter-detail-actions .btn { width: auto !important; flex: 1 1 0; min-width: 180rpx; }

.meter-detail-info { padding: 10rpx 24rpx; }
.meter-detail-info__row { display: flex; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 2rpx solid #f0f4f8; font-size: 27rpx; }
.meter-detail-info__row:last-child { border-bottom: none; }
.meter-detail-info__row text:first-child { flex-shrink: 0; color: #718499; }
.meter-detail-info__row text:last-child { text-align: right; color: #1f334a; word-break: break-all; }
.meter-detail-info__row .is-mono { font-family: Consolas, 'SF Mono', monospace; font-weight: 600; }

.meter-detail-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin-bottom: 24rpx; }
.meter-detail-stat { background: #fff; border: 2rpx solid #e1e9f1; border-radius: 20rpx; padding: 20rpx 10rpx; text-align: center; }
.meter-detail-stat__value { font-family: Consolas, 'SF Mono', monospace; font-size: 38rpx; font-weight: 700; color: #1f334a; }
.meter-detail-stat__value.is-danger { color: #c53d45; }
.meter-detail-stat__label { margin-top: 4rpx; font-size: 23rpx; color: #8194a8; }

.meter-section-title { font-size: 30rpx; font-weight: 600; color: #1f334a; margin-bottom: 16rpx; }
.meter-section-empty { padding: 26rpx 0; text-align: center; font-size: 25rpx; color: #8194a8; }

.meter-history-row { display: flex; gap: 18rpx; padding: 18rpx 0; border-bottom: 2rpx solid #f0f4f8; }
.meter-history-row:last-child { border-bottom: none; padding-bottom: 0; }
.meter-history-photo { width: 108rpx; height: 108rpx; border-radius: 12rpx; flex-shrink: 0; background: #eef3f8; }
.meter-history-photo--none { display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #a5b4c3; }
.meter-history-body { flex: 1; min-width: 0; }
.meter-history-top { display: flex; align-items: baseline; gap: 8rpx; flex-wrap: wrap; }
.meter-history-value { font-family: Consolas, 'SF Mono', monospace; font-size: 38rpx; font-weight: 700; color: #1f334a; }
.meter-history-unit { font-size: 23rpx; color: #8194a8; }
.meter-history-void { margin-left: auto; font-size: 22rpx; color: #c53d45; }
.meter-history-meta { margin-top: 4rpx; font-size: 24rpx; color: #718499; line-height: 1.5; }
.meter-history-tags { margin-top: 8rpx; display: flex; gap: 8rpx; flex-wrap: wrap; }
.meter-history-tag { padding: 2rpx 10rpx; background: #fff1f0; color: #c53d45; font-size: 21rpx; border-radius: 6rpx; }

.meter-charge-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; border-bottom: 2rpx solid #f0f4f8; }
.meter-charge-row:last-child { border-bottom: none; padding-bottom: 0; }
.meter-charge-period { font-size: 29rpx; font-weight: 600; color: #1f334a; }
.meter-charge-meta { margin-top: 4rpx; font-size: 23rpx; color: #8194a8; }
.meter-charge-side { text-align: right; }
.meter-charge-money { font-family: Consolas, 'SF Mono', monospace; font-size: 32rpx; font-weight: 700; color: #1f334a; }
.meter-charge-status { margin-top: 4rpx; font-size: 23rpx; }
.meter-charge-status.is-ok { color: #2f7a54; }
.meter-charge-status.is-warn { color: #ad6800; }
.meter-charge-status.is-void { color: #a5b4c3; }
