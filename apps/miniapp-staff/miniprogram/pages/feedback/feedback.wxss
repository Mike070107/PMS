.feedback-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.feedback-card { padding-bottom: 30rpx; }
.feedback-input {
  box-sizing: border-box;
  width: 100%;
  height: 260rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  background: #f8fafc;
  font-size: var(--font-md);
  line-height: 1.65;
}
.word-count { margin-top: 8rpx; text-align: right; color: var(--color-text-tertiary); font-size: var(--font-xs); }
.media-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin-top: 30rpx; }
.media-hint { margin-top: 5rpx; color: var(--color-text-tertiary); font-size: var(--font-xs); line-height: 1.5; }
.media-count { flex-shrink: 0; color: var(--color-brand); font-size: var(--font-sm); font-variant-numeric: tabular-nums; }
.photos { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.photo-wrap, .media-add { position: relative; width: 140rpx; height: 140rpx; }
.photo { width: 100%; height: 100%; border-radius: 18rpx; background: var(--color-bg); }
.media-remove { position: absolute; top: -10rpx; right: -10rpx; z-index: 2; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(20, 35, 50, .76); color: #fff; font-size: 30rpx; line-height: 1; }
.media-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #aac3d8; border-radius: 18rpx; background: #f5f9fc; color: var(--color-brand); font-size: var(--font-xs); }
.media-add__plus { margin-bottom: 4rpx; font-size: 44rpx; font-weight: 300; line-height: 1; }
.video-section { margin-top: 34rpx; }
.video-wrap { position: relative; width: 100%; height: 310rpx; margin-top: 16rpx; overflow: hidden; border-radius: 20rpx; background: #13283c; }
.video { width: 100%; height: 100%; }
.video-meta { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 4rpx 0; color: var(--color-text-tertiary); font-size: var(--font-xs); }
.video-delete { padding: 10rpx 0 10rpx 24rpx; color: var(--color-danger); }
.video-add { display: flex; align-items: center; gap: 20rpx; min-height: 116rpx; margin-top: 16rpx; padding: 18rpx 22rpx; border: 2rpx dashed #aac3d8; border-radius: 20rpx; background: #f5f9fc; }
.video-add__icon { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; background: var(--color-brand); color: #fff; font-size: 24rpx; text-indent: 4rpx; }
.video-add__title { color: var(--color-brand-dark); font-size: var(--font-md); font-weight: 600; }
.feedback-error { margin-top: 24rpx; }
.submit-btn { margin-top: 28rpx; }
.privacy-hint { padding: 14rpx 22rpx 0; color: var(--color-text-tertiary); font-size: var(--font-xs); line-height: 1.6; text-align: center; }
