/* 字号一律引 tokens.wxss 的 --font-* 阶梯；卡片/图标/停留徽标在 app.wxss 里统一定义 */

page { background: #f1f6fb; }
.detail-page { min-height: 100vh; background: #f1f6fb; color: #17314d; }
.detail-nav { background: #355f96; color: #fff; }
.detail-nav__safe { height: calc(env(safe-area-inset-top) + 16rpx); }
.detail-nav__bar { min-height: 172rpx; display: flex; align-items: center; padding: 0 34rpx 12rpx; }
.detail-nav__back, .detail-nav__side { flex-shrink: 0; width: 68rpx; }
.detail-nav__back { font-size: 56rpx; font-weight: 300; }
.detail-nav__center { flex: 1; min-width: 0; text-align: center; }
.detail-nav__title { font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.detail-nav__desc { margin-top: 5rpx; color: rgba(255,255,255,.9); font-size: 30rpx; line-height: 1.45; }
.detail-body { padding: 26rpx 24rpx 42rpx; }
.detail-body--with-bar { padding-bottom: 190rpx; }

.site-card { overflow: hidden; border-top: 8rpx solid #5b8fb8; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(34,67,101,.09); }
.site-card--urgent { border-top-color: #bd3c42; }
.site-card__head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 24rpx 26rpx 12rpx; }
.site-card__tags { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.site-card__type { color: #315f98; font-size: 33rpx; font-weight: 700; line-height: 1.4; }
.site-card__number { padding: 0 26rpx 22rpx; color: #667d93; font-size: 28rpx; line-height: 1.5; }
.site-block { padding: 24rpx 26rpx; border-top: 2rpx solid #e3ebf2; }
.site-block__label { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; color: #5d748b; font-size: 29rpx; font-weight: 600; }
.site-block__label text { width: 40rpx; height: 40rpx; border-radius: 50%; background: #e5eff8; color: #315f98; font-size: 26rpx; line-height: 40rpx; text-align: center; }
.site-block__address { display: flex; align-items: flex-start; gap: 13rpx; color: #173a57; font-size: 40rpx; font-weight: 700; line-height: 1.5; }
.site-block__address .icon { flex-shrink: 0; margin-top: 12rpx; }
.site-block__problem { color: #263f58; font-size: 35rpx; font-weight: 600; line-height: 1.65; }
.site-block--contact { background: #f8fbfe; }
.contact-row { display: flex; align-items: center; gap: 20rpx; }
.contact-row__body { flex: 1; min-width: 0; }
.contact-row__name { color: #203d58; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.contact-row__phone { margin-top: 5rpx; color: #5e758b; font-size: 31rpx; line-height: 1.45; }
.contact-call { flex-shrink: 0; min-width: 168rpx; min-height: 82rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; padding: 0 20rpx; border: 2rpx solid #90afd0; border-radius: 999rpx; background: #eaf3fb; color: #315f98; font-size: 31rpx; font-weight: 600; }
.site-photos { padding: 22rpx 26rpx 26rpx; border-top: 2rpx solid #e3ebf2; }
.site-photos__title { margin-bottom: 14rpx; color: #5d748b; font-size: 29rpx; font-weight: 600; }
.site-photos__list { width: 100%; white-space: nowrap; }
.site-photo { display: inline-block; width: 170rpx; height: 140rpx; margin-right: 14rpx; border-radius: 16rpx; background: #e7edf3; }

.work-card, .content-card, .detail-meta-card { margin-top: 24rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(39,72,108,.055); }
.work-card { padding: 28rpx; }
.work-card__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.work-card__title, .content-card__title { color: #17314d; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.work-card__desc { margin-top: 3rpx; color: #5e758c; font-size: 29rpx; line-height: 1.5; }
.work-card__assignee { flex-shrink: 0; max-width: 220rpx; padding: 9rpx 16rpx; overflow: hidden; border-radius: 999rpx; background: #edf4fa; color: #315f98; font-size: 28rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.work-steps { display: flex; align-items: flex-start; margin-top: 30rpx; }
.work-step { flex-shrink: 0; width: 126rpx; color: #71869a; font-size: 27rpx; line-height: 1.45; text-align: center; }
.work-step text { display: block; width: 52rpx; height: 52rpx; margin: 0 auto 8rpx; border-radius: 50%; background: #dfe8f0; color: #71869a; font-size: 28rpx; line-height: 52rpx; }
.work-step--on { color: #315f98; font-weight: 600; }
.work-step--on text { background: #315f98; color: #fff; }
.work-step--done { color: #39815d; font-weight: 600; }
.work-step--done text { background: #dff0e7; color: #39815d; }
.work-step__line { flex: 1; height: 4rpx; margin-top: 25rpx; background: #dce6ee; }
.material-summary { min-height: 82rpx; margin-top: 26rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 0 20rpx; border-radius: 16rpx; background: #f3f8fc; }
.material-summary__label { color: #536b82; font-size: 29rpx; }
.material-summary__value { color: #315f98; font-size: 31rpx; font-weight: 700; text-align: right; }
.material-wait { margin-top: 16rpx; padding: 20rpx; border: 2rpx solid #ecd1a3; border-radius: 16rpx; background: #fff6e9; color: #7c521b; font-size: 29rpx; line-height: 1.55; }
.material-wait text { display: block; margin-bottom: 6rpx; font-weight: 700; }

.detail-meta-card { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rpx; overflow: hidden; background: #dfe8f0; }
.detail-meta { min-width: 0; padding: 22rpx 18rpx; background: #fff; }
.detail-meta__label { color: #687e93; font-size: 28rpx; }
.detail-meta__value { margin-top: 6rpx; overflow: hidden; color: #203d58; font-size: 30rpx; font-weight: 700; line-height: 1.5; text-overflow: ellipsis; }
.detail-meta__hint { margin-top: 4rpx; color: #6b8094; font-size: 27rpx; }
.detail-meta__hint--warning { color: #a7640e; }
.detail-meta__hint--danger { color: #bd3c42; }

.content-card { padding: 28rpx; }
.result-row { display: grid; grid-template-columns: 180rpx 1fr; gap: 20rpx; padding: 22rpx 0; border-bottom: 2rpx solid #e8eef3; }
.result-row:last-child { border-bottom: 0; }
.result-row > text { color: #647a8f; font-size: 29rpx; }
.result-row > view { color: #203d58; font-size: 31rpx; font-weight: 600; line-height: 1.55; }
.result-material + .result-material { margin-top: 8rpx; }
.result-photos { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.progress-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 58rpx; }
.progress-head__action { color: #315f98; font-size: 29rpx; font-weight: 600; }
.content-card .timeline-item { margin-top: 24rpx; margin-bottom: 0; }
.content-card .timeline-label { font-size: 32rpx; font-weight: 700; }
.content-card .timeline-at { font-size: 27rpx; }
.content-card .timeline-stay, .content-card .timeline-note { font-size: 29rpx; line-height: 1.55; }
.timeline-photos { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.timeline-photo { width: 136rpx; height: 112rpx; border-radius: 14rpx; background: #e5ecf2; }
.field-actions { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16rpx; margin-top: 24rpx; padding: 18rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(39,72,108,.055); }
.field-actions--split { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.field-action { width: 100% !important; min-height: 88rpx; margin: 0; padding: 0 20rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 700; }
.field-action::after { border: 0; }
.field-action--progress { border: 2rpx solid #88a9c9; background: #edf5fb; color: #315f98; }
.field-action--transfer { border: 2rpx solid #e3b5b5; background: #fff7f7; color: #a7383e; }
.rollback-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #d9e2ea;
  border-radius: 22rpx;
  background: #fff;
}
.rollback-entry > view { flex: 1; min-width: 0; }
.rollback-entry__title { color: #3f5368; font-size: 29rpx; font-weight: 700; }
.rollback-entry__desc { margin-top: 6rpx; color: var(--color-text-tertiary); font-size: 24rpx; line-height: 1.5; }
.rollback-entry__button {
  width: auto !important;
  min-width: 174rpx;
  min-height: 78rpx;
  margin: 0 !important;
  padding: 0 22rpx;
  border: 2rpx solid #b7c9d9;
  border-radius: 18rpx;
  color: #315f98;
  background: #f4f8fc;
  font-size: 28rpx;
  font-weight: 700;
}
.rollback-entry__button::after { border: 0; }
.rollback-warning {
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  color: #72510a;
  background: #fff7df;
  font-size: 27rpx;
  line-height: 1.65;
}
.rollback-warning__title { margin-bottom: 6rpx; color: #694600; font-size: 31rpx; font-weight: 700; }
/* 撤回后果逐条列出：办公室点确认前就该看见「要退哪几样料」 */
.rollback-warning__impact { margin-top: 6rpx; }
/* 被拦下时用告警色，别和「即将执行」的黄色提示混在一起 */
.rollback-warning--blocked { color: #8c2f2f; background: #fdeeee; }
.rollback-warning--blocked .rollback-warning__title { color: #8c2f2f; }
/* 返工提示：上一次完工已撤回，下面是原草稿 */
.complete-draft-note {
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  color: #1f4a7a;
  background: #eef5fd;
  font-size: 28rpx;
  line-height: 1.65;
}
.complete-draft-note__title { font-size: 30rpx; font-weight: 700; }
.complete-draft-note__desc { margin-top: 6rpx; color: #4a6b8c; font-size: 26rpx; }
.field-actions__hint { grid-column: 1 / -1; color: #74879a; font-size: 25rpx; line-height: 1.5; text-align: center; }
.progress-photo-add { min-height: 94rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #8cabc8; border-radius: 18rpx; background: #f5f9fc; color: #315f98; font-size: 30rpx; font-weight: 600; }
.transfer-warning { padding: 22rpx; border: 2rpx solid #ecd1a3; border-radius: 18rpx; background: #fff8ec; color: #715127; font-size: 28rpx; line-height: 1.75; }
.transfer-warning__title { margin-bottom: 6rpx; color: #8f5d18; font-size: 31rpx; font-weight: 700; }
.transfer-submit { width: 100%; min-height: 96rpx; border: 0; border-radius: 18rpx; background: #a63b42; color: #fff; font-size: 33rpx; font-weight: 700; }
.detail-error { margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #fff0f0; color: #bd3f47; font-size: 30rpx; line-height: 1.55; }

.site-action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; gap: 16rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #d9e5ee; background: rgba(255,255,255,.98); box-shadow: 0 -8rpx 28rpx rgba(23,59,99,.1); }
.site-action { width: auto !important; height: 110rpx; margin: 0 !important; flex: 1 1 0; display: flex; align-items: center; justify-content: center; gap: 12rpx; border-radius: 20rpx; font-size: 35rpx; font-weight: 700; }
.site-action::after { border: 0; }
.site-action--secondary { border: 2rpx solid #7fa4c8; background: #f4f8fc; color: #315f98; }
.site-action--primary { background: #355f96; color: #fff; box-shadow: 0 10rpx 22rpx rgba(49,95,152,.18); }


/* 工单详情首屏：地址和故障做视觉锚点，编号、时间、负责人收成三格。 */
.detail-summary {
  padding: 0;
  overflow: hidden;
  border-top: 8rpx solid #5a8fb8;
  box-shadow: 0 12rpx 30rpx rgba(26,54,83,.10);
}
.detail-summary--urgent { border-top-color: #bd3c42; }
.detail-summary__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 28rpx 18rpx;
}
.detail-summary__tags { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.detail-summary__type {
  color: #315b80;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}
.detail-summary__address {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  border-top: 2rpx solid #dce8f1;
  border-bottom: 2rpx solid #dce8f1;
  background: linear-gradient(135deg, #e9f4fc 0%, #f8fbfe 100%);
  color: #1e3e5c;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
}
.detail-summary__address .icon { margin-top: 9rpx; }
.detail-summary__problem {
  padding: 26rpx 28rpx;
  color: #263f58;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.65;
}
.detail-summary__facts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  margin: 0 28rpx 26rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #dfe9f1;
}
.detail-fact {
  min-width: 0;
  padding: 18rpx 10rpx;
  background: #f6f9fc;
  text-align: center;
}
.detail-fact__label { color: var(--color-text-tertiary); font-size: 23rpx; line-height: 1.4; }
.detail-fact__value {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.detail-fact__hint { margin-top: 5rpx; color: var(--color-text-tertiary); font-size: 22rpx; }
.detail-fact__hint--danger { color: var(--color-danger); }
.detail-fact__hint--warn { color: #a7640e; }
.detail-summary__material {
  margin: 0 28rpx 26rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #ecd3a9;
  border-radius: 18rpx;
  background: #fff8ec;
  color: #7e531a;
  font-size: 27rpx;
  line-height: 1.55;
}
.detail-summary__material > text { display: block; margin-bottom: 5rpx; font-weight: 700; }
.detail-summary .thumbs { padding: 0 28rpx 24rpx; }
.detail-summary__foot {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 28rpx 24rpx;
  border-top: 2rpx solid #e4ebf2;
  background: #f8fafc;
}

.quote {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #5f91b9;
  background: #edf4fa;
  border-radius: 0 20rpx 20rpx 0;
  font-size: var(--font-lg);
  line-height: 1.7;
}

/* 联系业主：图标 + 文字，48rpx 高的点击区靠 padding 撑够 */
.call {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border: 2rpx solid #b9d0e3;
  border-radius: 999rpx;
  background: #f3f8fc;
  color: var(--color-brand);
  font-size: var(--font-lg);
}
.call .icon { margin-top: 0; }

.section-title { font-size: var(--font-2xl); font-weight: 700; }
/* 「维修结果」卡里标题和下面的信息行之间要有一档，别让标题贴在第一行上 */
.card > .section-title { display: block; margin-bottom: 28rpx; }
/* 用料在信息行的「值」这一列里竖着排，每项之间留一点，不然几项挤成一坨 */
.kv__v > .used-item + .used-item { margin-top: 12rpx; }
.meta { color: var(--color-text-tertiary); font-size: var(--font-sm); margin-top: 14rpx; line-height: 1.6; }
.label { font-size: var(--font-md); color: var(--color-text-secondary); margin-bottom: 14rpx; }
.label.mt { margin-top: 32rpx; }
.mt { margin-top: 32rpx; }

.fold--inline { min-height: auto; padding: 0 0 16rpx; margin-bottom: 0; }

/* ---------- 底部固定操作条 ---------- */
/* 底部操作条与附件缩略图都在 tokens.wxss 里统一定义 */


/* 常用话术：现场打字慢，能点就别让人打（标题走共用的 .label） */
.phrases { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.phrase {
  min-height: 76rpx;
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-card-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-lg);
  line-height: 1.4;
  transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
}
/* 选中 = 品牌色实底 + 白字，和 .chip--on 同一套：
   8% 的淡底在户外看不出来，维修工会重复点同一句话（2026-09-01 反馈的同一类问题） */
.phrase--on {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: #fff;
  font-weight: 500;
}

/* .error 已挪到 app.wxss（三个页面共用，别再各写一份） */

.timeline-item { position: relative; display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.timeline-item::after { content: ""; position: absolute; left: 7rpx; top: 32rpx; bottom: -28rpx; width: 2rpx; background: #d9e5ee; }
.timeline-item:last-child { margin-bottom: 0; }
.timeline-item:last-child::after { display: none; }
.dot { width: 16rpx; height: 16rpx; border: 6rpx solid #dbeaf5; border-radius: 50%; background: var(--color-brand); margin-top: 10rpx; flex-shrink: 0; z-index: 1; }
.timeline-body { flex: 1; }
.timeline-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.timeline-label { font-size: var(--font-xl); font-weight: 500; }
.timeline-at { flex-shrink: 0; font-size: var(--font-sm); color: var(--color-text-tertiary); font-variant-numeric: tabular-nums; }
.timeline-operator { margin-top: 6rpx; font-size: var(--font-sm); color: var(--color-text-tertiary); }
.timeline-note { margin-top: 10rpx; font-size: var(--font-md); color: var(--color-text-secondary); line-height: 1.6; }
/* 每个节点停了多久：卡在哪一步、卡了多久，比绝对时间更好用 */
.timeline-stay {
  margin-top: 10rpx;
  font-size: var(--font-md);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* ---------- 添加用料 ---------- */
.sheet__body { box-sizing: border-box; }
.mat-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: var(--font-md);
}
/* 够不够：够用是灰的（不打扰），不够/没有是橙的（提示要走缺料） */
.mat-hint {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  font-size: var(--font-md);
  line-height: 1.5;
  color: var(--color-text-secondary);
}
.mat-hint--short { color: #ad6800; }
.mat-hint__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--color-brand);
  color: #fff;
  font-size: var(--font-xs);
  font-weight: 600;
}
.mat-hint__icon--short { background: #d48806; }
.mat-hint__text { flex: 1; min-width: 0; }

/* 完工面板里回显已记的用料 */
.used-list { display: flex; flex-direction: column; gap: 12rpx; }
.used-item {
  padding: 16rpx 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-lg);
  line-height: 1.5;
}
.used-item__tag {
  margin-left: 12rpx;
  font-size: var(--font-xs);
  color: #ad6800;
}

.mat-item {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #d4e0eb;
  border: 2rpx solid #aebfd1;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 26rpx rgba(35, 65, 105, 0.13);
}
.mat-item .mat-name { background: var(--color-card-bg); }
.mat-title {
  flex: 1;
  min-width: 0;
  padding: 8rpx 0;
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1.45;
  color: var(--color-text);
}
.mat-spec {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border: 2rpx solid rgba(49, 95, 155, 0.25);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-brand);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1;
}
.mat-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
}
.mat-photo {
  width: 184rpx;
  height: 184rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 28rpx;
  flex-shrink: 0;
  background: #e4e9ef;
}
.mat-photo--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}
.mat-control {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}
.mat-qty-label {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}
.mat-qty {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.mat-pick {
  flex-shrink: 0;
  min-width: 112rpx;
  padding-left: 10rpx;
  padding-right: 10rpx;
  border-radius: 20rpx;
  font-size: var(--font-sm);
}
.mat-unit {
  flex-shrink: 0;
  max-width: 64rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}
/* 用料备注：比名称轻一档，别和主信息抢眼 */
.mat-note {
  height: 104rpx;
  border: 2rpx solid rgba(49, 95, 155, 0.1);
  border-radius: 20rpx;
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
}

.mat-row { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.mat-row:first-child { margin-top: 0; }
.mat-row--title { align-items: flex-start; }
.mat-name {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 92rpx;
  padding: 0 22rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-xl);
}
/* 数量步进器：两边 ±、中间可直接改。按钮 92rpx 见方，戴手套也点得中 */
.stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-card-bg);
  overflow: hidden;
}
.stepper__btn {
  width: 64rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-brand);
  background: var(--color-card-bg);
  transition: background 200ms ease;
}
.stepper__btn:active { background: rgba(49, 85, 138, 0.1); }
/* 已经到下限：变灰但仍占位，别让按钮忽然消失导致误触旁边的输入框 */
.stepper__btn--off { color: var(--color-text-tertiary); }
.stepper__input {
  box-sizing: border-box;
  width: 78rpx;
  height: 72rpx;
  padding: 0 8rpx;
  border-left: 2rpx solid var(--color-border);
  border-right: 2rpx solid var(--color-border);
  background: var(--color-card-bg);
  font-size: var(--font-xl);
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.mat-del {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 40rpx;
  flex-shrink: 0;
}
.mat-submit {
  font-size: var(--font-md);
}
.sku-no-result {
  padding-left: 36rpx;
  padding-right: 36rpx;
  line-height: 1.6;
}

/* 等待材料的缺料清单 */
.wait-mat {
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  background: rgba(250, 173, 20, 0.1);
  color: #ad6800;
  font-size: var(--font-lg);
  line-height: 1.6;
}

/* 完工小结里模型听出来的材料名：只是提醒去「添加用料」里选，不是已经记上了，
   所以做成橙色说明而不是列表 —— 看着像「已记录」的话，用料就漏了 */
.mat-said {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: rgba(250, 173, 20, 0.1);
  color: #ad6800;
  font-size: var(--font-md);
  line-height: 1.6;
}

.ai-basis {
  margin-top: 10rpx;
  color: var(--brand-700);
  font-size: var(--font-md);
  line-height: 1.55;
}

/* ---------- 完工提交：与报修页同一套蓝色、分步、大字号设计语言 ---------- */
.complete-sheet {
  height: 96vh;
  overflow: hidden;
  border-radius: 40rpx 40rpx 0 0;
  background: #f1f6fb;
}
.complete-head {
  flex-shrink: 0;
  min-height: 150rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx 6rpx;
  background: #355f96;
  color: #fff;
}
.complete-head__close, .complete-head__side { flex-shrink: 0; width: 70rpx; }
.complete-head__close { font-size: 58rpx; font-weight: 300; }
.complete-head__body { flex: 1; min-width: 0; text-align: center; }
.complete-head__title { font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.complete-head__desc { margin-top: 5rpx; color: rgba(255,255,255,.9); font-size: 30rpx; line-height: 1.45; }
.complete-body {
  box-sizing: border-box;
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 26rpx 24rpx 34rpx;
}
.complete-guide {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #e4eef8;
}
.complete-guide__badge {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #315f98;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}
.complete-guide__title { color: #315f98; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.complete-guide__desc { margin-top: 4rpx; color: #536f8c; font-size: 29rpx; line-height: 1.55; }
.complete-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(39,72,108,.065);
}
.complete-card__head { display: flex; align-items: center; gap: 18rpx; margin-bottom: 28rpx; }
.complete-card__num {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 15rpx;
  background: #315f98;
  color: #fff;
  font-size: 34rpx;
  line-height: 60rpx;
  text-align: center;
}
.complete-card__title { color: #17314d; font-size: 37rpx; font-weight: 700; line-height: 1.35; }
.complete-card__desc { margin-top: 2rpx; color: #5d758e; font-size: 29rpx; line-height: 1.5; }
.complete-label { margin: 22rpx 0 14rpx; color: #29445e; font-size: 33rpx; font-weight: 600; line-height: 1.45; }
.complete-label:first-of-type { margin-top: 0; }
.complete-label text { margin-left: 8rpx; color: #73869a; font-size: 29rpx; font-weight: 400; }
.complete-label .complete-required { color: #c64b52; font-weight: 500; }
.complete-label--next { margin-top: 28rpx; }
.complete-input, .complete-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid #c6d7e7;
  border-radius: 18rpx;
  background: #fff;
  color: #17314d;
  font-size: 34rpx;
}
.complete-input { height: 98rpx; padding: 0 24rpx; }
.complete-textarea { min-height: 190rpx; padding: 20rpx 22rpx; line-height: 1.6; }
.complete-textarea--short { min-height: 150rpx; }
.complete-speech {
  box-sizing: border-box;
  width: 100% !important;
  min-height: 108rpx;
  margin: 0 0 26rpx !important;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 22rpx;
  padding: 14rpx 26rpx;
  border-radius: 20rpx;
  background: #355f96;
  color: #fff;
  text-align: left;
  box-shadow: 0 12rpx 28rpx rgba(49,95,152,.2);
}
.complete-speech::after { border: 0; }
.complete-speech--on { background: #b33e45; }
.complete-speech__mic { position: relative; flex-shrink: 0; width: 18rpx; height: 30rpx; border: 3rpx solid currentColor; border-radius: 12rpx; }
.complete-speech__mic::before { content: ''; position: absolute; left: -9rpx; bottom: -9rpx; width: 30rpx; height: 22rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 16rpx 16rpx; }
.complete-speech__title { font-size: 35rpx; font-weight: 700; line-height: 1.35; }
.complete-speech__desc { margin-top: 3rpx; color: rgba(255,255,255,.88); font-size: 29rpx; line-height: 1.45; }
.complete-listening { margin: -10rpx 0 22rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #e7f1fa; color: #315f98; font-size: 30rpx; line-height: 1.55; }
.speech-field-button {
  box-sizing: border-box;
  width: 100% !important;
  min-height: 96rpx;
  margin: 0 0 18rpx !important;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 22rpx;
  padding: 14rpx 24rpx;
  border: 2rpx solid #9ebbd5;
  border-radius: 18rpx;
  background: #eef6fd;
  color: #315f98;
  text-align: left;
}
.speech-field-button::after, .speech-mini::after { border: 0; }
.speech-field-button--compact { min-height: 84rpx; margin-top: 14rpx !important; }
.speech-field-button--on, .speech-mini--on { border-color: #b33e45; background: #b33e45; color: #fff; }
.speech-field-button__title { font-size: 31rpx; font-weight: 700; line-height: 1.35; }
.speech-field-button__desc { margin-top: 2rpx; color: #6d8398; font-size: 25rpx; line-height: 1.4; }
.speech-field-button--on .speech-field-button__desc { color: rgba(255,255,255,.88); }
.speech-field-listening { margin: -6rpx 0 16rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: #e7f1fa; color: #315f98; font-size: 27rpx; line-height: 1.5; }
.speech-field-listening--compact { margin-top: 10rpx; }
.speech-mini {
  flex-shrink: 0;
  min-width: 142rpx;
  min-height: 88rpx;
  margin: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid #9ebbd5;
  border-radius: 18rpx;
  background: #eef6fd;
  color: #315f98;
  font-size: 27rpx;
  font-weight: 700;
}
.speech-mini .complete-speech__mic { transform: scale(.86); }
.complete-subtitle { margin-top: 24rpx; color: #5a7188; font-size: 30rpx; line-height: 1.5; }
.complete-sheet .phrase { min-height: 76rpx; font-size: 30rpx; }
.fee-input { height: 98rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 24rpx; border: 2rpx solid #c6d7e7; border-radius: 18rpx; background: #fff; }
.fee-input > text { color: #315f98; font-size: 38rpx; font-weight: 600; }
.fee-input input { flex: 1; height: 96rpx; color: #17314d; font-size: 35rpx; }
.complete-sheet .ai-basis, .complete-sheet .mat-said { font-size: 29rpx; line-height: 1.6; }
.complete-sheet .used-list { gap: 14rpx; }
.complete-sheet .used-item { display: flex; align-items: center; gap: 12rpx; min-height: 82rpx; padding: 16rpx 20rpx; border: 2rpx solid #d7e3ed; border-radius: 16rpx; background: #f5f9fc; font-size: 30rpx; }
.used-item__name { flex: 1; min-width: 0; color: #203c57; font-weight: 600; line-height: 1.5; }
.used-item__qty { flex-shrink: 0; color: #315f98; font-size: 32rpx; font-weight: 700; }
.complete-sheet .used-item__tag { flex-shrink: 0; font-size: 27rpx; }
.complete-empty { padding: 22rpx; border-radius: 16rpx; background: #fff5e7; color: #85591f; font-size: 29rpx; line-height: 1.6; }
.complete-photo-entry { min-height: 106rpx; display: flex; align-items: center; gap: 18rpx; padding: 12rpx 22rpx; border: 2rpx dashed #8eafd0; border-radius: 18rpx; background: #f8fbfe; }
.complete-photo-entry > view:nth-child(2) { flex: 1; min-width: 0; }
.complete-photo-entry__camera { position: relative; flex-shrink: 0; width: 28rpx; height: 22rpx; border: 3rpx solid #315f98; border-radius: 4rpx; }
.complete-photo-entry__camera::before { content: ''; position: absolute; left: 7rpx; top: 4rpx; width: 9rpx; height: 9rpx; border: 2rpx solid #315f98; border-radius: 50%; }
.complete-photo-entry__camera::after { content: ''; position: absolute; left: 4rpx; top: -8rpx; width: 11rpx; height: 6rpx; border-radius: 3rpx 3rpx 0 0; background: #315f98; }
.complete-photo-entry__title { color: #315f98; font-size: 33rpx; font-weight: 700; line-height: 1.4; }
.complete-photo-entry__desc { margin-top: 3rpx; color: #617990; font-size: 29rpx; line-height: 1.45; }
.complete-photo-entry__plus { color: #315f98; font-size: 40rpx; }
.complete-thumbs { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.complete-error { margin: 22rpx 0; padding: 18rpx 20rpx; border-radius: 16rpx; background: #fff0f0; color: #bd3f47; font-size: 30rpx; line-height: 1.55; }
.complete-foot { flex-shrink: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #d8e4ee; background: rgba(255,255,255,.98); }
.complete-submit { width: 100% !important; height: 112rpx; margin: 0 !important; display: flex; align-items: center; justify-content: center; gap: 16rpx; border-radius: 20rpx; background: #355f96; color: #fff; font-size: 38rpx; font-weight: 700; box-shadow: 0 10rpx 24rpx rgba(49,95,152,.2); }
.complete-submit::after { border: 0; }
.complete-submit__check { width: 34rpx; height: 34rpx; border: 3rpx solid #fff; border-radius: 50%; font-size: 24rpx; line-height: 31rpx; text-align: center; }
.issued-block {
  padding: 18rpx;
  border: 2rpx solid #c9dff2;
  border-radius: 16rpx;
  background: #f5f9fd;
}

.issued-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #e2edf6;
}

.issued-item__body { flex: 1; min-width: 0; }
.issued-item__name { color: #173b59; font-weight: 600; line-height: 1.5; }
