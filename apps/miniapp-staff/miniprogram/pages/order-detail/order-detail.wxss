/* 字号一律引 tokens.wxss 的 --font-* 阶梯；卡片/图标/停留徽标在 app.wxss 里统一定义 */


/* 业主原话：引号块，和系统文案区分开 */
.order-summary { border-top: 8rpx solid #4f88b5; box-shadow: 0 12rpx 30rpx rgba(26,54,83,.10); }
.order-summary .wo-card__head { padding-bottom: 22rpx; border-bottom: 2rpx solid #e4ebf2; }
.order-summary .wo-card__type { font-size: 38rpx; }
.order-summary .wo-card__foot { margin-top: 28rpx; padding-top: 22rpx; border-top: 2rpx solid #e4ebf2; }

.quote {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #5f91b9;
  background: #edf4fa;
  border-radius: 0 20rpx 20rpx 0;
  font-size: var(--font-lg);
  line-height: 1.7;
}

/* 联系业主：图标 + 文字，48rpx 高的点击区靠 padding 撑够 */
.call {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border: 2rpx solid #b9d0e3;
  border-radius: 999rpx;
  background: #f3f8fc;
  color: var(--color-brand);
  font-size: var(--font-lg);
}
.call .icon { margin-top: 0; }

.section-title { font-size: var(--font-2xl); font-weight: 700; }
/* 「维修结果」卡里标题和下面的信息行之间要有一档，别让标题贴在第一行上 */
.card > .section-title { display: block; margin-bottom: 28rpx; }
/* 用料在信息行的「值」这一列里竖着排，每项之间留一点，不然几项挤成一坨 */
.kv__v > .used-item + .used-item { margin-top: 12rpx; }
.meta { color: var(--color-text-tertiary); font-size: var(--font-sm); margin-top: 14rpx; line-height: 1.6; }
.label { font-size: var(--font-md); color: var(--color-text-secondary); margin-bottom: 14rpx; }
.label.mt { margin-top: 32rpx; }
.mt { margin-top: 32rpx; }

.fold--inline { min-height: auto; padding: 0 0 16rpx; margin-bottom: 0; }

/* ---------- 底部固定操作条 ---------- */
/* 底部操作条与附件缩略图都在 tokens.wxss 里统一定义 */


/* 常用话术：现场打字慢，能点就别让人打（标题走共用的 .label） */
.phrases { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.phrase {
  min-height: 76rpx;
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-border);
  background: var(--color-card-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-lg);
  line-height: 1.4;
  transition: background 200ms ease, border-color 200ms ease, color 200ms ease;
}
/* 选中 = 品牌色实底 + 白字，和 .chip--on 同一套：
   8% 的淡底在户外看不出来，维修工会重复点同一句话（2026-09-01 反馈的同一类问题） */
.phrase--on {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: #fff;
  font-weight: 500;
}

/* .error 已挪到 app.wxss（三个页面共用，别再各写一份） */

.timeline-item { position: relative; display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.timeline-item::after { content: ""; position: absolute; left: 7rpx; top: 32rpx; bottom: -28rpx; width: 2rpx; background: #d9e5ee; }
.timeline-item:last-child { margin-bottom: 0; }
.timeline-item:last-child::after { display: none; }
.dot { width: 16rpx; height: 16rpx; border: 6rpx solid #dbeaf5; border-radius: 50%; background: var(--color-brand); margin-top: 10rpx; flex-shrink: 0; z-index: 1; }
.timeline-body { flex: 1; }
.timeline-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.timeline-label { font-size: var(--font-xl); font-weight: 500; }
.timeline-at { flex-shrink: 0; font-size: var(--font-sm); color: var(--color-text-tertiary); font-variant-numeric: tabular-nums; }
.timeline-note { margin-top: 10rpx; font-size: var(--font-md); color: var(--color-text-secondary); line-height: 1.6; }
/* 每个节点停了多久：卡在哪一步、卡了多久，比绝对时间更好用 */
.timeline-stay {
  margin-top: 10rpx;
  font-size: var(--font-md);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* ---------- 添加用料 ---------- */
.sheet__body { box-sizing: border-box; }
.mat-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: var(--font-md);
}
/* 够不够：够用是灰的（不打扰），不够/没有是橙的（提示要走缺料） */
.mat-hint {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  font-size: var(--font-md);
  line-height: 1.5;
  color: var(--color-text-secondary);
}
.mat-hint--short { color: #ad6800; }
.mat-hint__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--color-brand);
  color: #fff;
  font-size: var(--font-xs);
  font-weight: 600;
}
.mat-hint__icon--short { background: #d48806; }
.mat-hint__text { flex: 1; min-width: 0; }

/* 完工面板里回显已记的用料 */
.used-list { display: flex; flex-direction: column; gap: 12rpx; }
.used-item {
  padding: 16rpx 20rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-lg);
  line-height: 1.5;
}
.used-item__tag {
  margin-left: 12rpx;
  font-size: var(--font-xs);
  color: #ad6800;
}

.mat-item {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #d4e0eb;
  border: 2rpx solid #aebfd1;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 26rpx rgba(35, 65, 105, 0.13);
}
.mat-item .mat-name { background: var(--color-card-bg); }
.mat-title {
  flex: 1;
  min-width: 0;
  padding: 8rpx 0;
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1.45;
  color: var(--color-text);
}
.mat-spec {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border: 2rpx solid rgba(49, 95, 155, 0.25);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  color: var(--color-brand);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1;
}
.mat-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
}
.mat-photo {
  width: 184rpx;
  height: 184rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 28rpx;
  flex-shrink: 0;
  background: #e4e9ef;
}
.mat-photo--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: var(--font-xs);
}
.mat-control {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}
.mat-qty-label {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}
.mat-qty {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.mat-pick {
  flex-shrink: 0;
  min-width: 112rpx;
  padding-left: 10rpx;
  padding-right: 10rpx;
  border-radius: 20rpx;
  font-size: var(--font-sm);
}
.mat-unit {
  flex-shrink: 0;
  max-width: 64rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}
/* 用料备注：比名称轻一档，别和主信息抢眼 */
.mat-note {
  height: 104rpx;
  border: 2rpx solid rgba(49, 95, 155, 0.1);
  border-radius: 20rpx;
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
}

.mat-row { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.mat-row:first-child { margin-top: 0; }
.mat-row--title { align-items: flex-start; }
.mat-name {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 92rpx;
  padding: 0 22rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-xl);
}
/* 数量步进器：两边 ±、中间可直接改。按钮 92rpx 见方，戴手套也点得中 */
.stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-card-bg);
  overflow: hidden;
}
.stepper__btn {
  width: 64rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--color-brand);
  background: var(--color-card-bg);
  transition: background 200ms ease;
}
.stepper__btn:active { background: rgba(49, 85, 138, 0.1); }
/* 已经到下限：变灰但仍占位，别让按钮忽然消失导致误触旁边的输入框 */
.stepper__btn--off { color: var(--color-text-tertiary); }
.stepper__input {
  box-sizing: border-box;
  width: 78rpx;
  height: 72rpx;
  padding: 0 8rpx;
  border-left: 2rpx solid var(--color-border);
  border-right: 2rpx solid var(--color-border);
  background: var(--color-card-bg);
  font-size: var(--font-xl);
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.mat-del {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 40rpx;
  flex-shrink: 0;
}
.mat-submit {
  font-size: var(--font-md);
}
.sku-no-result {
  padding-left: 36rpx;
  padding-right: 36rpx;
  line-height: 1.6;
}

/* 等待材料的缺料清单 */
.wait-mat {
  padding: 18rpx 22rpx;
  border-radius: var(--radius-sm);
  background: rgba(250, 173, 20, 0.1);
  color: #ad6800;
  font-size: var(--font-lg);
  line-height: 1.6;
}

/* 完工小结里模型听出来的材料名：只是提醒去「添加用料」里选，不是已经记上了，
   所以做成橙色说明而不是列表 —— 看着像「已记录」的话，用料就漏了 */
.mat-said {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: rgba(250, 173, 20, 0.1);
  color: #ad6800;
  font-size: var(--font-md);
  line-height: 1.6;
}

.ai-basis {
  margin-top: 10rpx;
  color: var(--brand-700);
  font-size: var(--font-md);
  line-height: 1.55;
}
