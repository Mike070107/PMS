<view wx:if="{{detail}}" class="container container--with-bar">
  <!-- 这一屏最该先回答的：修什么、在哪、压了多久。
       「现在什么状态」看右上角的状态标，「接下来干什么」看底部固定按钮条，
       都不用再写一句话解释一遍。 -->
  <view class="card wo-card">
    <view class="wo-card__head">
      <view class="wo-card__title">
        <text wx:if="{{urgent}}" class="badge--urgent">紧急</text>
        <text class="wo-card__type">{{typeLabel}}</text>
      </view>
      <pms-tag class="status-tag" status="{{detail.workOrder.status}}"/>
    </view>

    <view class="kv"><text class="kv__k">工单编号</text><text class="kv__v">{{detail.workOrder.orderNo}}</text></view>
    <view class="kv"><text class="kv__k">报修地址</text><text class="kv__v">{{detail.request.addressText || '未填地址'}}</text></view>
    <view class="kv">
      <text class="kv__k">报修时间</text>
      <text class="kv__v">{{createdAtText}}<text class="kv__tag kv__tag--{{stayTone}}">{{stayBadge}}</text></text>
    </view>
    <view class="kv"><text class="kv__k">故障描述</text><text class="kv__v">{{detail.request.content}}</text></view>
    <view class="kv"><text class="kv__k">维修工</text><text class="kv__v">{{assigneeText}}</text></view>
    <view wx:if="{{missingText}}" class="kv">
      <text class="kv__k">等待材料</text><text class="kv__v">{{missingText}}</text>
    </view>

    <view wx:if="{{detail.request.attachments.length}}" class="thumbs">
      <image
        wx:for="{{detail.request.attachments}}"
        wx:key="*this"
        class="thumb"
        src="{{item}}"
        mode="aspectFill"
        data-url="{{item}}"
        bindtap="onPreviewRequestImage"
      />
    </view>

    <view class="wo-card__foot">
      <view class="call" bindtap="onCall">
        <view class="icon icon--phone"></view>
        <text>联系业主</text>
      </view>
    </view>
  </view>

  <!-- 修完了它才出现：故障位置、用料、收费、完修时间 —— 验收的人要看的就是这些。
       放在进度之前：进度回答「走到哪一步」，这张卡回答「到底修了什么」，后者更该先看见 -->
  <view wx:if="{{hasResult}}" class="card">
    <view class="section-title">维修结果</view>
    <view wx:for="{{resultRows}}" wx:key="label" class="kv">
      <text class="kv__k">{{item.label}}</text>
      <text class="kv__v">{{item.value}}</text>
    </view>

    <view wx:if="{{resultMaterials.length}}" class="kv">
      <text class="kv__k">用料</text>
      <view class="kv__v">
        <view wx:for="{{resultMaterials}}" wx:for-item="mat" wx:key="*this" class="used-item">{{mat}}</view>
      </view>
    </view>

    <block wx:if="{{resultPhotos.length}}">
      <view class="kv"><text class="kv__k">完工照片</text><text class="kv__v">共 {{resultPhotos.length}} 张</text></view>
      <view class="thumbs">
        <image
          wx:for="{{resultPhotos}}"
          wx:key="*this"
          class="thumb"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          bindtap="onPreviewResultImage"
        />
      </view>
    </block>
  </view>

  <!-- 进度：最新的动作在最上面（buildTimeline 已经倒序），默认只露第一条 -->
  <view class="card">
    <view class="fold fold--inline" bindtap="onToggleTimeline">
      <text class="section-title">进度</text>
      <text class="fold__action" wx:if="{{timeline.length > 1}}">
        {{timelineOpen ? '收起' : '展开全部 ' + timeline.length + ' 步'}}
      </text>
    </view>

    <view
      wx:for="{{timeline}}"
      wx:key="id"
      wx:if="{{timelineOpen || index === 0}}"
      class="timeline-item"
    >
      <view class="dot"></view>
      <view class="timeline-body">
        <view class="timeline-row">
          <text class="timeline-label">{{item.label}}</text>
          <text class="timeline-at">{{item.at}}</text>
        </view>
        <view wx:if="{{item.stay}}" class="timeline-stay">{{item.stay}}</view>
        <view wx:if="{{item.note}}" class="timeline-note">{{item.note}}</view>
      </view>
    </view>
  </view>

  <view class="error card" wx:if="{{errorMsg && !panel}}">{{errorMsg}}</view>
</view>

<!-- 底部固定操作条：一屏里只有一个实心主按钮，不用再猜该点哪个 -->
<view wx:if="{{detail && (canAccept || canComplete)}}" class="action-bar">
  <button
    wx:if="{{canNeedMaterial}}"
    class="btn btn--outline"
    data-panel="material"
    bindtap="onOpenPanel"
  >添加用料{{materialRows.length ? ' ' + materialRows.length : ''}}</button>
  <button
    wx:if="{{canAccept}}"
    class="btn btn--primary"
    loading="{{busy}}"
    disabled="{{busy}}"
    bindtap="onAccept"
  >{{acceptText}}</button>
  <button
    wx:if="{{canComplete}}"
    class="btn btn--primary"
    data-panel="complete"
    bindtap="onOpenPanel"
  >完工提交</button>
</view>

<!-- ============ 添加用料面板 ============ -->
<view wx:if="{{panel === 'material'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'material'}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">添加用料</text>
    <text class="sheet__close" bindtap="onClosePanel">关闭</text>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <view wx:if="{{!materialRows.length}}" class="mat-empty">还没添加用料</view>

    <view class="mat-item" wx:for="{{materialRows}}" wx:key="index">
      <view class="mat-row">
        <input
          class="mat-name"
          placeholder="材料名称"
          value="{{item.name}}"
          data-index="{{index}}"
          data-field="name"
          bindinput="onMaterialInput"
        />
        <view class="mat-del" data-index="{{index}}" bindtap="onRemoveMaterialRow">×</view>
      </view>

      <view class="mat-row">
        <button class="btn btn--outline btn--sm mat-pick" data-index="{{index}}" bindtap="onOpenSku">
          {{item.materialId ? '换一个' : '从库存选'}}
        </button>
        <!-- 数量步进：默认 1，两边各一个 ±；数字大时直接改中间输入框 -->
        <view class="stepper">
          <view
            class="stepper__btn {{item.qty <= 1 ? 'stepper__btn--off' : ''}}"
            data-index="{{index}}"
            data-step="-1"
            bindtap="onStepQty"
          >−</view>
          <input
            class="stepper__input"
            type="digit"
            value="{{item.qty}}"
            data-index="{{index}}"
            data-field="qty"
            bindinput="onMaterialInput"
          />
          <view class="stepper__btn" data-index="{{index}}" data-step="1" bindtap="onStepQty">＋</view>
        </view>
        <text class="mat-unit">{{item.unit || ''}}</text>
      </view>

      <!-- 用料备注：会原样印到养护单背面《材料领耗记录》的备注格 -->
      <view class="mat-row">
        <input
          class="mat-name mat-note"
          placeholder="备注（选填，会印到养护单）"
          value="{{item.note}}"
          data-index="{{index}}"
          data-field="note"
          bindinput="onMaterialInput"
        />
      </view>

      <!-- 够不够，写在行里，不用自己去库存页查 -->
      <view wx:if="{{item.hintText}}" class="mat-hint {{item.hintShort ? 'mat-hint--short' : ''}}">
        {{item.hintText}}
      </view>

      <view wx:if="{{item.materialId && item.photoUrl}}" class="mat-sku">
        <image
          class="mat-sku__photo"
          src="{{item.photoUrl}}"
          mode="aspectFill"
          data-url="{{item.photoUrl}}"
          catchtap="onPreviewSkuPhoto"
        />
        <text class="mat-sku__text">{{item.code}}</text>
      </view>
    </view>

    <view class="btn-row mt">
      <button class="btn btn--outline" bindtap="onOpenSku">＋ 从库存选</button>
      <button class="btn btn--ghost" bindtap="onAddMaterialRow">手填一项</button>
    </view>
    <view class="label mt">补充说明<text class="label__opt">选填</text></view>
    <input class="input" placeholder="型号、品牌或用途" value="{{materialNote}}" bindinput="onMaterialNote"/>

    <view class="error" wx:if="{{materialError}}">{{materialError}}</view>
  </scroll-view>

  <view class="sheet__foot sheet__foot--row">
    <!-- 有缺料才给「提报缺料」这条出路；都够用时它没有意义 -->
    <button
      wx:if="{{hasShortage}}"
      class="btn btn--outline"
      loading="{{busy}}"
      disabled="{{busy}}"
      bindtap="onSubmitMaterial"
    >提报缺料</button>
    <button class="btn btn--primary" bindtap="onConfirmMaterial">记下用料</button>
  </view>
</view>

<!-- ============ 完工提交面板 ============ -->
<view wx:if="{{panel === 'complete'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'complete'}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">完工提交</text>
    <text class="sheet__close" bindtap="onClosePanel">关闭</text>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <view class="label">维修说明<text class="label__opt">业主可见</text></view>
    <textarea placeholder="更换了什么、处理了什么问题" bindinput="onNote" value="{{actionNote}}"/>
    <!-- 常用话术：点一下填进上面的文本框，再点一下撤掉；顺序按本小区用得多不多来 -->
    <block wx:if="{{phrases.length}}">
      <view class="label mt">常用话术<text class="label__opt">点一下填入</text></view>
      <view class="phrases">
        <view
          wx:for="{{phrases}}"
          wx:key="text"
          class="phrase {{item.on ? 'phrase--on' : ''}}"
          data-text="{{item.text}}"
          bindtap="onTapPhrase"
        >{{item.text}}</view>
      </view>
    </block>

    <!-- 位置和现象业主报修时已经说过，这里预填出来给维修工核对/改，不强制 -->
    <view class="label mt">故障位置<text class="label__opt">选填</text></view>
    <input class="input" placeholder="如：厨房水槽下方" value="{{faultLocation}}" data-field="faultLocation" bindinput="onFaultInput"/>

    <view class="label mt">故障现象<text class="label__opt">选填</text></view>
    <input class="input" placeholder="如：接头老化渗水" value="{{faultSymptom}}" data-field="faultSymptom" bindinput="onFaultInput"/>

    <view class="label mt">收费金额（元）<text class="label__opt">选填</text></view>
    <input class="input" type="digit" placeholder="不收费就留空" value="{{feeYuan}}" bindinput="onFeeInput"/>

    <!-- 用料在「添加用料」里维护，这里只做确认，避免两处都能改 -->
    <view class="label mt">用料</view>
    <view wx:if="{{materialRows.length}}" class="used-list">
      <view wx:for="{{materialRows}}" wx:key="index" class="used-item">
        {{item.name}} ×{{item.qty}}{{item.unit || ''}}
        <text wx:if="{{!item.materialId}}" class="used-item__tag">手填</text>
      </view>
    </view>
    <view wx:else class="muted">未记录</view>

    <view class="label mt">完工照片<text class="label__opt">选填</text></view>
    <view class="thumbs">
      <view wx:for="{{resultAttachments}}" wx:key="*this" class="thumb-wrap">
        <image class="thumb" src="{{item}}" mode="aspectFill"/>
        <view class="thumb-remove" data-index="{{index}}" catchtap="onRemoveMedia">
          <view class="icon icon--close"></view>
        </view>
      </view>
      <view wx:if="{{resultAttachments.length < 6}}" class="thumb-add" bindtap="onChooseMedia">
        <view class="icon icon--camera"></view>
        <text class="add-text">{{uploading ? '上传中' : '拍照'}}</text>
      </view>
    </view>

    <view class="error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </scroll-view>

  <view class="sheet__foot">
    <button
      class="btn btn--primary"
      loading="{{busy}}"
      disabled="{{busy || uploading}}"
      bindtap="onComplete"
    >提交完工</button>
  </view>
</view>

<!-- ============ 领料仓库的库存选择器（叠在用料面板之上） ============ -->
<view wx:if="{{skuOpen}}" class="sheet-mask sheet-mask--top" bindtap="onCloseSku" catchtouchmove="noop"/>
<view wx:if="{{skuOpen}}" class="sheet sheet--top" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">{{skuTitle}}</text>
    <view class="sheet__head-right">
      <!-- 默认仓由后台「小区 + 报修类型」配好；配漏了或那个仓空了，得让人自己挑一个 -->
      <text wx:if="{{warehouses.length}}" class="sheet__link" bindtap="onSwitchWarehouse">
        {{skuWarehouseId ? '换仓库' : '选仓库'}}
      </text>
      <text class="sheet__close" bindtap="onCloseSku">关闭</text>
    </view>
  </view>

  <!-- 没定下仓库就没有「库存」可言，搜索框/筛选/列头一起收起来，只留提示和「选仓库」 -->
  <block wx:if="{{skuWarehouseId}}">
    <input
      class="input sheet__search"
      placeholder="搜索名称 / 别名 / 型号 / 编码"
      value="{{skuKeyword}}"
      bindinput="onSkuKeyword"
    />

    <!-- 类别筛选：材料几十上百条，先按类别缩一轮比一直翻快得多。放不下就左右滑 -->
    <scroll-view wx:if="{{skuCategories.length > 1}}" class="chips chips--inset" scroll-x enable-flex>
      <view class="chip {{skuCategoryIndex < 0 ? 'chip--on' : ''}}" data-index="-1" bindtap="onPickSkuCategory">全部</view>
      <view
        class="chip {{skuCategoryIndex === index ? 'chip--on' : ''}}"
        wx:for="{{skuCategories}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onPickSkuCategory"
      >{{item}}</view>
    </scroll-view>

    <!-- 列头常驻：列表一滚起来就不知道右边那个数字是什么了 -->
    <view class="sku-head">
      <text class="sku-head__photo">图片</text>
      <text class="sku-head__name">名称</text>
      <text class="sku-head__qty">库存数量</text>
    </view>
  </block>

  <scroll-view class="sheet__body sheet__body--flush" scroll-y>
    <view wx:if="{{skuLoading}}" class="center muted">加载中…</view>
    <block wx:elif="{{skuError}}">
      <view class="error">{{skuError}}</view>
      <button class="btn btn--outline mt" bindtap="onRetrySku">重试</button>
    </block>
    <block wx:else>
      <view wx:if="{{skuEmptyHint}}" class="sku-empty">{{skuEmptyHint}}</view>

      <block wx:if="{{skuWarehouseId}}">
        <view wx:if="{{!skuList.length}}" class="center muted">
          没有匹配的材料。关掉这里点「手填一项」，提报缺料后由办公室补进材料库。
        </view>

        <view
          wx:for="{{skuList}}"
          wx:key="materialId"
          class="sku"
          hover-class="wo-card--hover"
          hover-stay-time="80"
          data-index="{{index}}"
          bindtap="onPickSku"
        >
          <image
            wx:if="{{item.photoUrl}}"
            class="sku__photo"
            src="{{item.photoUrl}}"
            mode="aspectFill"
            data-url="{{item.photoUrl}}"
            catchtap="onPreviewSkuPhoto"
          />
          <view wx:else class="sku__photo sku__photo--empty">无图</view>
          <view class="sku__body">
            <view class="sku__title">{{item.name}}{{item.spec ? ' · ' + item.spec : ''}}</view>
            <view class="meta">{{item.code}} · {{item.category || '未分类'}}</view>
          </view>
          <!-- 有多少货是选料时最该看见的一列 -->
          <view class="sku__qty {{item.qty > 0 ? '' : 'sku__qty--none'}}">
            {{item.qty > 0 ? item.qty + item.unit : '无货'}}
          </view>
        </view>
      </block>

      <button
        wx:if="{{!skuWarehouseId}}"
        class="btn btn--outline mt"
        bindtap="onSwitchWarehouse"
        disabled="{{!warehouses.length}}"
      >选仓库</button>
    </block>
  </scroll-view>
</view>
