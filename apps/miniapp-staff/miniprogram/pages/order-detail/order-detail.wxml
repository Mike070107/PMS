<view class="detail-page" bindtouchstart="onSwipeBackStart" bindtouchmove="onSwipeBackMove" bindtouchend="onSwipeBackEnd" bindtouchcancel="onSwipeBackCancel">
  <view class="detail-nav">
    <!-- 标题行和微信胶囊同一条线、右侧按胶囊位置留空；副标题单独一行放胶囊下面（utils/custom-nav.ts） -->
    <view class="detail-nav__safe" style="{{nav.top ? 'height:' + nav.top + 'px' : ''}}"></view>
    <view class="detail-nav__bar" style="padding-right:{{nav.padRight}}px;{{nav.height ? 'min-height:' + nav.height + 'px' : ''}}">
      <view class="detail-nav__back" bindtap="onBack">‹</view>
      <view class="detail-nav__center"><view class="detail-nav__title">工单现场处理</view></view>
      <!-- 「?」= 指导层开关，见 utils/guide.ts -->
      <view class="detail-nav__side"><view class="nav-help {{guide ? 'nav-help--on' : ''}}" bindtap="onToggleGuide">?</view></view>
    </view>
    <view wx:if="{{guide}}" class="detail-nav__desc">先核对现场，再记录用料和完工情况</view>
  </view>

  <view wx:if="{{detail}}" class="detail-body {{canAccept || canComplete ? 'detail-body--with-bar' : ''}}">
    <view class="site-card {{urgent ? 'site-card--urgent' : ''}}">
      <view class="site-card__head">
        <view class="site-card__tags"><text wx:if="{{urgent}}" class="badge--urgent">紧急</text><text class="site-card__type">{{typeLabel}}</text></view>
        <pms-tag class="status-tag" status="{{detail.workOrder.status}}" label="{{currentStatusText}}"/>
      </view>
      <view class="site-card__number">工单编号：{{detail.workOrder.orderNo}}</view>

      <view class="site-block">
        <view class="site-block__label"><text>1</text> 去哪里</view>
        <view class="site-block__address"><view class="icon icon--pin"></view><text>{{detail.request.addressText || '未填地址'}}</text></view>
      </view>
      <view class="site-block">
        <view class="site-block__label"><text>2</text> 什么问题</view>
        <view class="site-block__problem">{{detail.request.content || '未填写故障描述'}}</view>
      </view>
      <view class="site-block site-block--contact">
        <view class="site-block__label"><text>3</text> 联系谁</view>
        <view class="contact-row">
          <view class="contact-row__body"><view class="contact-row__name">{{detail.request.contactName || '未留联系人姓名'}}</view><view class="contact-row__phone">{{detail.request.contactPhone || '未留联系电话'}}</view></view>
          <view class="contact-call" bindtap="onCall"><view class="icon icon--phone"></view><text>打电话</text></view>
        </view>
      </view>

      <view wx:if="{{detail.request.attachments.length}}" class="site-photos">
        <view class="site-photos__title">报修现场照片 · {{detail.request.attachments.length}}张</view>
        <scroll-view class="site-photos__list" scroll-x enable-flex>
          <image wx:for="{{detail.request.attachments}}" wx:key="*this" class="site-photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewRequestImage"/>
        </scroll-view>
      </view>
    </view>

    <view wx:if="{{canComplete || canNeedMaterial}}" class="work-card">
      <view class="work-card__head"><view><view class="work-card__title">{{guide ? '现场处理顺序' : '现场处理'}}</view><view wx:if="{{guide}}" class="work-card__desc">按下面三步做，不容易漏填</view></view><view class="work-card__assignee">{{assigneeText}}</view></view>
      <view wx:if="{{guide}}" class="work-steps">
        <view class="work-step work-step--done"><text>✓</text><view>核对现场</view></view>
        <view class="work-step__line"></view>
        <view class="work-step {{materialRows.length || issuedMaterials.length ? 'work-step--done' : 'work-step--on'}}"><text>{{materialRows.length || issuedMaterials.length ? '✓' : '2'}}</text><view>记录用料</view></view>
        <view class="work-step__line"></view>
        <view class="work-step work-step--on"><text>3</text><view>提交完工</view></view>
      </view>
      <view class="material-summary">
        <view class="material-summary__label">本单用料</view>
        <view class="material-summary__value">{{materialRows.length || issuedMaterials.length ? '已记录 ' + (materialRows.length + issuedMaterials.length) + ' 项' : '还没有记录用料'}}</view>
      </view>
      <view wx:if="{{missingText}}" class="material-wait"><text>等待材料</text><view>{{missingText}}</view></view>
    </view>

    <view class="detail-meta-card">
      <view class="detail-meta"><view class="detail-meta__label">报修时间</view><view class="detail-meta__value">{{createdAtText}}</view><view class="detail-meta__hint detail-meta__hint--{{stayTone}}">{{stayBadge}}</view></view>
      <view class="detail-meta"><view class="detail-meta__label">当前维修工</view><view class="detail-meta__value">{{assigneeText}}</view></view>
    </view>

    <view wx:if="{{hasResult}}" class="content-card">
      <view class="content-card__title">维修结果</view>
      <view wx:for="{{resultRows}}" wx:key="label" class="result-row"><text>{{item.label}}</text><view>{{item.value}}</view></view>
      <view wx:if="{{resultMaterials.length}}" class="result-row"><text>用料</text><view><view wx:for="{{resultMaterials}}" wx:for-item="mat" wx:key="*this" class="result-material">{{mat}}</view></view></view>
      <block wx:if="{{resultPhotos.length}}">
        <view class="result-row"><text>完工照片</text><view>共 {{resultPhotos.length}} 张</view></view>
        <view class="result-photos"><image wx:for="{{resultPhotos}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewResultImage"/></view>
      </block>
    </view>

    <view class="content-card">
      <view class="progress-head" bindtap="onToggleTimeline"><view class="content-card__title">工单进度</view><view wx:if="{{timeline.length > 1}}" class="progress-head__action">{{timelineOpen ? '收起' : '展开全部 ' + timeline.length + ' 步'}} ›</view></view>
      <view wx:for="{{timeline}}" wx:key="id" wx:if="{{timelineOpen || index === 0}}" class="timeline-item">
        <view class="dot"></view>
        <view class="timeline-body">
          <view class="timeline-row"><text class="timeline-label">{{item.label}}</text><text class="timeline-at">{{item.at}}</text></view>
          <view class="timeline-operator">操作人：{{item.operatorName}}</view>
          <view wx:if="{{item.stay}}" class="timeline-stay">{{item.stay}}</view>
          <view wx:if="{{item.note}}" class="timeline-note">{{item.note}}</view>
          <view wx:if="{{item.attachments.length}}" class="timeline-photos">
            <image wx:for="{{item.attachments}}" wx:for-item="photo" wx:key="*this" class="timeline-photo" src="{{photo}}" mode="aspectFill" data-url="{{photo}}" data-urls="{{item.attachments}}" bindtap="onPreviewProgressImage"/>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{canAddProgress || canTransfer}}" class="field-actions {{canAddProgress && canTransfer ? 'field-actions--split' : ''}}">
      <button wx:if="{{canAddProgress}}" class="field-action field-action--progress" data-panel="progress" bindtap="onOpenPanel">添加维修备注</button>
      <button wx:if="{{canTransfer}}" class="field-action field-action--transfer" data-panel="transfer" bindtap="onOpenPanel">转给其他人修</button>
      <view wx:if="{{guide && canTransfer}}" class="field-actions__hint">转单后由所属管理处重新选择工单类型和维修工</view>
    </view>

    <view wx:if="{{canRollback}}" class="rollback-entry">
      <view><view class="rollback-entry__title">刚才处理错了？</view><view wx:if="{{guide}}" class="rollback-entry__desc">办公室可撤回上一笔操作，退回哪一步、要不要退料，点开后由系统告诉你</view></view>
      <button class="rollback-entry__button" data-panel="rollback" bindtap="onOpenPanel">撤回上一步</button>
    </view>

    <!-- 作废：和撤回是两格独立权限（2026-09-05） -->
    <view wx:if="{{canVoid}}" class="rollback-entry rollback-entry--void">
      <view><view class="rollback-entry__title">这单不用修了？</view><view wx:if="{{guide}}" class="rollback-entry__desc">作废会退回已领用的材料、不进统计；记录保留，仍能查到</view></view>
      <button class="rollback-entry__button rollback-entry__button--void" data-panel="void" bindtap="onOpenPanel">作废工单</button>
    </view>

    <view class="detail-error" wx:if="{{errorMsg && !panel}}">{{errorMsg}}</view>
  </view>
</view>

<!-- 「记录用料 2」那个数字曾被当成步骤号（2026-09-04 Mike），改成按钮下一行明说「已记 N 项」 -->
<view wx:if="{{detail && (canAccept || canComplete || canRedispatch)}}" class="site-action-bar">
  <button wx:if="{{canNeedMaterial}}" class="site-action site-action--secondary" data-panel="material" bindtap="onOpenPanel"><view class="btn__icon icon-action--box-blue"></view><view class="site-action__text"><text>记录用料</text><text wx:if="{{materialRows.length || issuedMaterials.length}}" class="site-action__sub">已记 {{materialRows.length + issuedMaterials.length}} 项</text></view></button>
  <button wx:if="{{canAccept}}" class="site-action site-action--primary" loading="{{busy}}" disabled="{{busy}}" bindtap="onAccept"><view class="btn__icon icon-action--check-white"></view><text>{{acceptText}}</text></button>
  <button wx:if="{{canComplete}}" class="site-action site-action--primary" data-panel="complete" bindtap="onOpenPanel"><view class="btn__icon icon-action--wrench-white"></view><text>去完工</text></button>
  <button wx:if="{{canRedispatch}}" class="site-action site-action--primary" bindtap="onGoRedispatch"><view class="btn__icon icon-action--send-white"></view><text>去派单台重新派单</text></button>
</view>

<!-- ============ 办公室撤回处理节点 ============ -->
<view wx:if="{{panel === 'rollback'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'rollback'}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head"><text class="sheet__title">撤回上一步</text><text class="sheet__close" bindtap="onClosePanel">关闭</text></view>
  <scroll-view class="sheet__body" scroll-y>
    <view wx:if="{{rollbackLoading}}" class="rollback-warning"><view>正在读取这次撤回会影响什么…</view></view>
    <view wx:elif="{{rollbackBlocked}}" class="rollback-warning rollback-warning--blocked">
      <view class="rollback-warning__title">这张工单现在不能撤回</view>
      <view>{{rollbackBlockedReason || '请联系管理员核对工单轨迹'}}</view>
    </view>
    <view wx:else class="rollback-warning">
      <view class="rollback-warning__title">将撤回「{{rollbackActionLabel}}」，工单恢复到「{{rollbackTargetText}}」</view>
      <view wx:for="{{rollbackImpacts}}" wx:key="*this" class="rollback-warning__impact">{{item}}</view>
      <view>原操作不会消失，操作人、前后状态和撤回原因都会如实保留在工单进度中。</view>
    </view>
    <view wx:if="{{!rollbackBlocked}}" class="label mt">撤回原因<text class="label__opt">必填</text></view>
    <button wx:if="{{hasSpeech && !rollbackBlocked}}" class="speech-field-button {{recording && speechTarget === 'rollback' ? 'speech-field-button--on' : ''}}" data-speech-target="rollback" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord">
      <view class="complete-speech__mic"></view><view><view class="speech-field-button__title">{{recording && speechTarget === 'rollback' ? '松开结束' : '按住说撤回原因'}}</view><view wx:if="{{guide}}" class="speech-field-button__desc">说完自动填到下面，还可以修改</view></view>
    </button>
    <view wx:if="{{recording && speechTarget === 'rollback'}}" class="speech-field-listening">正在听：{{partial || '请继续说…'}}</view>
    <textarea wx:if="{{!rollbackBlocked}}" class="complete-textarea" maxlength="500" placeholder="例如：误点完工，现场还有一项需要处理" value="{{rollbackNote}}" bindinput="onRollbackNote"/>
    <view class="complete-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </scroll-view>
  <view class="sheet__foot"><button class="btn btn--primary" loading="{{busy}}" disabled="{{busy || rollbackLoading || rollbackBlocked}}" bindtap="onSubmitRollback">确认撤回</button></view>
</view>

<!-- ============ 作废工单 ============ -->
<view wx:if="{{panel === 'void'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'void'}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head"><text class="sheet__title">作废工单</text><text class="sheet__close" bindtap="onClosePanel">关闭</text></view>
  <scroll-view class="sheet__body" scroll-y>
    <view class="rollback-warning rollback-warning--blocked">
      <view class="rollback-warning__title">作废后这张单不再处理</view>
      <view class="rollback-warning__impact">本单已领用的材料会退回仓库</view>
      <view class="rollback-warning__impact">不再计入完工、时效等统计</view>
      <view>记录保留，办公室仍能在工单管理里筛到它。</view>
    </view>
    <view class="label mt">作废原因<text class="label__opt">必填</text></view>
    <button wx:if="{{hasSpeech}}" class="speech-field-button {{recording && speechTarget === 'void' ? 'speech-field-button--on' : ''}}" data-speech-target="void" data-speech-label="作废原因" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord">
      <view class="complete-speech__mic"></view><view><view class="speech-field-button__title">{{recording && speechTarget === 'void' ? '松开结束' : '按住说作废原因'}}</view><view wx:if="{{guide}}" class="speech-field-button__desc">说完自动填到下面，还可以修改</view></view>
    </button>
    <view wx:if="{{recording && speechTarget === 'void'}}" class="speech-field-listening">正在听：{{partial || '请继续说…'}}</view>
    <textarea class="complete-textarea" maxlength="500" placeholder="例如：业主重复报修，另一张单已在处理" value="{{voidNote}}" bindinput="onVoidNote"/>
    <view class="void-confirm {{voidConfirmed ? 'void-confirm--on' : ''}}" bindtap="onToggleVoidConfirm">
      <view class="void-confirm__box"></view>
      <text>我确认：退回本单已领用的材料，并把它从统计中排除</text>
    </view>
    <view class="complete-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </scroll-view>
  <view class="sheet__foot"><button class="btn btn--primary btn--danger-solid" loading="{{busy}}" disabled="{{busy}}" bindtap="onSubmitVoid">确认作废</button></view>
</view>

<!-- ============ 维修过程记录 ============ -->
<view wx:if="{{panel === 'progress'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'progress'}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head"><text class="sheet__title">添加维修备注</text><text class="sheet__close" bindtap="onClosePanel">关闭</text></view>
  <scroll-view class="sheet__body" scroll-y>
    <view class="label">进度说明<text class="label__opt">说明当前做到哪里、下一步做什么</text></view>
    <button wx:if="{{hasSpeech}}" class="speech-field-button {{recording && speechTarget === 'progress' ? 'speech-field-button--on' : ''}}" data-speech-target="progress" data-speech-label="进度说明" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord">
      <view class="complete-speech__mic"></view><view><view class="speech-field-button__title">{{recording && speechTarget === 'progress' ? '松开结束' : '按住说备注'}}</view><view wx:if="{{guide}}" class="speech-field-button__desc">说完自动填到下面，还可以修改</view></view>
    </button>
    <view wx:if="{{recording && speechTarget === 'progress'}}" class="speech-field-listening">正在听：{{partial || '请继续说…'}}</view>
    <textarea class="complete-textarea" maxlength="500" placeholder="例如：已拆开检查，确认主板损坏，正在联系办公室确认配件" value="{{progressNote}}" bindinput="onProgressNote"/>
    <view class="label mt">现场照片<text class="label__opt">最多 6 张</text></view>
    <view class="progress-photo-add" bindtap="onChooseProgressPhoto">{{uploading ? '上传中…' : '+ 拍照或从相册选择'}}</view>
    <view wx:if="{{progressAttachments.length}}" class="complete-thumbs">
      <view wx:for="{{progressAttachments}}" wx:key="*this" class="thumb-wrap">
        <image class="thumb" src="{{item}}" mode="aspectFill"/>
        <view class="thumb-remove" data-index="{{index}}" catchtap="onRemoveProgressPhoto"><view class="icon icon--close"></view></view>
      </view>
    </view>
    <view class="complete-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </scroll-view>
  <view class="sheet__foot"><button class="btn btn--primary" loading="{{busy}}" disabled="{{busy || uploading}}" bindtap="onSubmitProgress">保存进度</button></view>
</view>

<!-- ============ 转回办公室重新派单 ============ -->
<view wx:if="{{panel === 'transfer'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'transfer'}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head"><text class="sheet__title">转给其他人修</text><text class="sheet__close" bindtap="onClosePanel">关闭</text></view>
  <scroll-view class="sheet__body" scroll-y>
    <view class="transfer-warning"><view class="transfer-warning__title">提交后会发生什么</view><view>1. 清空当前工单类型和维修工</view><view>2. 工单回到“待派单”</view><view>3. 所属管理处办公室收到微信和站内通知</view><view>4. 办公室重新选类型、维修工并派单</view></view>
    <view class="label mt">转单原因<text class="label__opt">必填，方便办公室判断</text></view>
    <button wx:if="{{hasSpeech}}" class="speech-field-button {{recording && speechTarget === 'transfer' ? 'speech-field-button--on' : ''}}" data-speech-target="transfer" data-speech-label="转单原因" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord">
      <view class="complete-speech__mic"></view><view><view class="speech-field-button__title">{{recording && speechTarget === 'transfer' ? '松开结束' : '按住说原因'}}</view><view wx:if="{{guide}}" class="speech-field-button__desc">例如：需要电工处理</view></view>
    </button>
    <view wx:if="{{recording && speechTarget === 'transfer'}}" class="speech-field-listening">正在听：{{partial || '请继续说…'}}</view>
    <textarea class="complete-textarea" maxlength="500" placeholder="例如：需要电工处理，我无法继续维修" value="{{transferNote}}" bindinput="onTransferNote"/>
    <view class="complete-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </scroll-view>
  <view class="sheet__foot"><button class="btn transfer-submit" loading="{{busy}}" disabled="{{busy}}" bindtap="onSubmitTransfer">确认交回办公室</button></view>
</view>

<!-- ============ 添加用料面板 ============ -->
<view wx:if="{{panel === 'material'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'material'}}" class="sheet" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">添加用料</text>
    <text class="sheet__close" bindtap="onClosePanel">关闭</text>
  </view>

  <scroll-view class="sheet__body" scroll-y>
    <view wx:if="{{issuedMaterials.length}}" class="issued-block">
      <view class="label">已领用·已扣库<text class="label__opt">删除会自动退库</text></view>
      <view wx:for="{{issuedMaterials}}" wx:key="id" class="issued-item">
        <view class="issued-item__body">
          <view class="issued-item__name">{{item.name}}{{item.spec ? ' · ' + item.spec : ''}}</view>
          <view class="muted">{{item.warehouseName}} · ×{{item.qty}}{{item.unit || ''}}</view>
        </view>
        <button class="btn btn--ghost btn--sm" data-id="{{item.id}}" bindtap="onRemoveIssuedMaterial">删除退库</button>
      </view>
    </view>

    <view class="label {{issuedMaterials.length ? 'mt' : ''}}">本次新增<text class="label__opt">可连续添加多项</text></view>
    <view wx:if="{{!materialRows.length}}" class="mat-empty">还没添加。下方选「仓库材料」；材料库里没有的点「申购新材料」</view>

    <view class="mat-item" wx:for="{{materialRows}}" wx:key="index">
      <!-- 第一行：名称 + 规格。库存 SKU 固定展示，手填行仍允许输入名称。 -->
      <view class="mat-row mat-row--title">
        <view wx:if="{{item.materialId}}" class="mat-title">{{item.name}}</view>
        <input
          wx:else
          class="mat-name"
          placeholder="材料名称"
          value="{{item.name}}"
          data-index="{{index}}"
          data-field="name"
          bindinput="onMaterialInput"
        />
        <text wx:if="{{item.materialId && item.spec}}" class="mat-spec">{{item.spec}}</text>
        <!-- 这一行会进采购申请：库存 0 / 不够 / 材料库里没有 -->
        <text wx:if="{{item.purchase}}" class="mat-badge">申购</text>
        <view class="mat-del" data-index="{{index}}" bindtap="onRemoveMaterialRow">×</view>
      </view>
      <!-- 申购新材料：型号 / 参数单独一行，办公室建档时分别落到名称和规格 -->
      <view wx:if="{{!item.materialId}}" class="mat-row">
        <input
          class="mat-name mat-spec-input"
          placeholder="型号 / 参数（选填，如 86型 二线 白色）"
          value="{{item.spec}}"
          data-index="{{index}}"
          data-field="spec"
          bindinput="onMaterialInput"
        />
      </view>

      <!-- 第二行：图片在左，数量/单位居中，「换一个」在右。 -->
      <view class="mat-main">
        <image
          wx:if="{{item.photoUrl}}"
          class="mat-photo"
          src="{{item.photoUrl}}"
          mode="aspectFill"
          data-url="{{item.photoUrl}}"
          data-urls="{{item.photoUrls}}"
          catchtap="onPreviewSkuPhoto"
        />
        <!-- 申购新材料：没图的位置就是「拍样本」入口，拍下要买的东西 -->
        <view wx:elif="{{!item.materialId}}" class="mat-photo mat-photo--add" data-index="{{index}}" catchtap="onChooseRowPhoto">
          <view class="mat-photo__camera"></view>
          <text>{{uploading ? '上传中' : '拍样本'}}</text>
          <text class="mat-photo__sub">最多 3 张</text>
        </view>
        <view wx:else class="mat-photo mat-photo--empty">无图</view>
        <view class="mat-control">
          <text class="mat-qty-label">使用数量</text>
          <view class="mat-qty">
            <!-- 数量步进：默认 1，两边各一个 ±；数字大时直接改中间输入框 -->
            <view class="stepper">
              <view
                class="stepper__btn {{item.qty <= 1 ? 'stepper__btn--off' : ''}}"
                data-index="{{index}}"
                data-step="-1"
                bindtap="onStepQty"
              >−</view>
              <input
                class="stepper__input"
                type="digit"
                value="{{item.qty}}"
                data-index="{{index}}"
                data-field="qty"
                bindinput="onMaterialInput"
              />
              <view class="stepper__btn" data-index="{{index}}" data-step="1" bindtap="onStepQty">＋</view>
            </view>
            <text class="mat-unit">{{item.unit || ''}}</text>
          </view>
        </view>
        <button class="btn btn--outline btn--sm mat-pick" data-index="{{index}}" bindtap="onOpenSku">
          <view class="btn__icon icon-action--box-blue"></view><text>{{item.materialId ? '换一个' : '从库存选'}}</text>
        </button>
      </view>

      <!-- 申购新材料的样本照片条：可删可补，最多 3 张 -->
      <view wx:if="{{!item.materialId && item.photoUrls.length}}" class="mat-samples">
        <view wx:for="{{item.photoUrls}}" wx:for-item="url" wx:for-index="pi" wx:key="*this" class="mat-sample">
          <image class="mat-sample__img" src="{{url}}" mode="aspectFill" data-url="{{url}}" data-urls="{{item.photoUrls}}" catchtap="onPreviewSkuPhoto"/>
          <view class="mat-sample__remove" data-index="{{index}}" data-photo-index="{{pi}}" catchtap="onRemoveRowPhoto"><view class="icon icon--close"></view></view>
        </view>
        <view wx:if="{{item.photoUrls.length < 3}}" class="mat-sample mat-sample--add" data-index="{{index}}" catchtap="onChooseRowPhoto">＋</view>
      </view>

      <!-- 用料备注：会原样印到养护单背面《材料领耗记录》的备注格 -->
      <view class="mat-row">
        <input
          class="mat-name mat-note"
          placeholder="备注（选填，会印到养护单）"
          value="{{item.note}}"
          data-index="{{index}}"
          data-field="note"
          bindinput="onMaterialInput"
        />
        <button wx:if="{{hasSpeech}}" class="speech-mini {{recording && speechTarget === 'materialRowNote' && speechRowIndex === index ? 'speech-mini--on' : ''}}" data-speech-target="materialRowNote" data-speech-label="用料备注" data-row-index="{{index}}" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord"><view class="complete-speech__mic"></view><text>{{recording && speechTarget === 'materialRowNote' && speechRowIndex === index ? '松开' : '按住说'}}</text></button>
      </view>
      <view wx:if="{{recording && speechTarget === 'materialRowNote' && speechRowIndex === index}}" class="speech-field-listening speech-field-listening--compact">正在听：{{partial || '请继续说…'}}</view>

      <!-- 够不够，写在行里，不用自己去库存页查 -->
      <view wx:if="{{item.hintText}}" class="mat-hint {{item.hintShort ? 'mat-hint--short' : ''}}">
        <view class="mat-hint__icon {{item.hintShort ? 'mat-hint__icon--short' : ''}}">仓</view>
        <text class="mat-hint__text">{{item.hintText}}</text>
      </view>

    </view>

    <view class="btn-row mt">
      <button class="btn btn--outline" bindtap="onOpenSku">
        <view class="btn__icon icon-action--box-blue"></view><text>+ 仓库材料</text>
      </button>
      <button class="btn btn--ghost" bindtap="onAddMaterialRow">
        <view class="btn__icon icon-action--edit-blue"></view><text>+ 申购新材料</text>
      </button>
    </view>
    <view class="label mt">补充说明<text class="label__opt">选填</text></view>
    <button wx:if="{{hasSpeech}}" class="speech-field-button speech-field-button--compact {{recording && speechTarget === 'materialNote' ? 'speech-field-button--on' : ''}}" data-speech-target="materialNote" data-speech-label="缺料补充说明" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord">
      <view class="complete-speech__mic"></view><view><view class="speech-field-button__title">{{recording && speechTarget === 'materialNote' ? '松开结束' : '按住说补充说明'}}</view><view wx:if="{{guide}}" class="speech-field-button__desc">型号、品牌或用途</view></view>
    </button>
    <view wx:if="{{recording && speechTarget === 'materialNote'}}" class="speech-field-listening">正在听：{{partial || '请继续说…'}}</view>
    <textarea class="complete-textarea complete-textarea--short" maxlength="500" placeholder="型号、品牌或用途" value="{{materialNote}}" bindinput="onMaterialNote"/>

    <view class="error" wx:if="{{materialError}}">{{materialError}}</view>
  </scroll-view>

  <view class="sheet__foot">
    <button
      class="btn btn--primary mat-submit"
      loading="{{busy}}"
      disabled="{{busy || !materialRows.length}}"
      bindtap="onMaterialPrimaryAction"
    ><view class="btn__icon icon-action--check-white"></view><text>{{materialActionText}}</text></button>
  </view>
</view>

<!-- ============ 完工提交面板 ============ -->
<view wx:if="{{panel === 'complete'}}" class="sheet-mask" bindtap="onClosePanel" catchtouchmove="noop"/>
<view wx:if="{{panel === 'complete'}}" class="sheet complete-sheet" catchtouchmove="noop">
  <view class="complete-head">
    <view class="complete-head__close" bindtap="onClosePanel">‹</view>
    <view class="complete-head__body">
      <view class="complete-head__title">完工提交</view>
      <view wx:if="{{guide}}" class="complete-head__desc">按现场实际填写，提交前还能修改</view>
    </view>
    <view class="complete-head__side"></view>
  </view>

  <scroll-view class="complete-body" scroll-y>
    <!-- 上一次完工被撤回：材料已退库，这里是原草稿，重新提交才会再次扣库 -->
    <view wx:if="{{completionDraftNotice}}" class="complete-draft-note">
      <view class="complete-draft-note__title">{{completionDraftNotice}}</view>
      <view wx:if="{{completionDraftReason}}" class="complete-draft-note__desc">撤回原因：{{completionDraftReason}}</view>
    </view>
    <view wx:if="{{guide}}" class="complete-guide">
      <view class="complete-guide__badge">AI</view>
      <view><view class="complete-guide__title">可以按住说一句话</view><view class="complete-guide__desc">说清做了什么、实际故障、是否收费，系统会帮你整理</view></view>
    </view>

    <view class="complete-card">
      <view class="complete-card__head">
        <view class="complete-card__num">1</view>
        <view><view class="complete-card__title">完工照片和说明</view><view wx:if="{{guide}}" class="complete-card__desc">先拍维修后的样子，再写做了什么；说明业主看得到</view></view>
      </view>
      <!-- 2026-09-04 Mike：完工照片放第一步 -->
      <view class="complete-label">完工照片 <text>{{guide ? '选填，建议拍维修结果' : '选填'}}</text></view>
      <view class="complete-photo-entry" bindtap="onChooseMedia">
        <view class="complete-photo-entry__camera"></view>
        <view><view class="complete-photo-entry__title">{{resultAttachments.length ? '继续添加完工照片' : '添加完工照片'}}</view><view wx:if="{{guide}}" class="complete-photo-entry__desc">最多6张，拍清维修后的状态</view></view>
        <view class="complete-photo-entry__plus">＋</view>
      </view>
      <view wx:if="{{resultAttachments.length}}" class="complete-thumbs">
        <view wx:for="{{resultAttachments}}" wx:key="*this" class="thumb-wrap">
          <image class="thumb" src="{{item}}" mode="aspectFill"/>
          <view class="thumb-remove" data-index="{{index}}" catchtap="onRemoveMedia"><view class="icon icon--close"></view></view>
        </view>
      </view>
      <button wx:if="{{hasSpeech}}" class="complete-speech {{recording && speechTarget === 'summary' ? 'complete-speech--on' : ''}}" data-speech-target="summary" data-speech-label="完工情况" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord">
        <view class="complete-speech__mic"></view>
        <view><view class="complete-speech__title">{{recording && speechTarget === 'summary' ? '松开结束' : summarizing ? '正在整理…' : '按住说完工情况'}}</view><view wx:if="{{guide}}" class="complete-speech__desc">一次说清做了什么、故障和收费，AI 自动整理</view></view>
      </button>
      <view wx:if="{{recording && speechTarget === 'summary'}}" class="complete-listening">正在听：{{partial || '请继续说…'}}</view>
      <view class="complete-label complete-label--next">维修说明 <text class="complete-required">必填</text></view>
      <textarea class="complete-textarea" placeholder="例如：更换门铃电源并重新接线，测试后已能正常开门" bindinput="onNote" value="{{actionNote}}"/>
      <view wx:if="{{materialHints.length}}" class="mat-said">AI听到可能用了：{{materialHints}}。这只是提醒，不会自动加入用料；请按实际情况到用料记录中手动选择。</view>
      <block wx:if="{{phrases.length}}">
        <view class="complete-subtitle">常用话术，点一下就能填</view>
        <view class="phrases">
          <view wx:for="{{phrases}}" wx:key="text" class="phrase {{item.on ? 'phrase--on' : ''}}" data-text="{{item.text}}" bindtap="onTapPhrase">{{item.text}}</view>
        </view>
      </block>
    </view>

    <view class="complete-card">
      <view class="complete-card__head">
        <view class="complete-card__num">2</view>
        <view><view class="complete-card__title">现场实际情况</view><view wx:if="{{guide}}" class="complete-card__desc">核对位置、故障和收费</view></view>
      </view>
      <view class="complete-label">实际位置 <text>选填</text></view>
      <input class="complete-input" placeholder="例如：厨房水槽下方" value="{{faultLocation}}" data-field="faultLocation" bindinput="onFaultInput"/>
      <button wx:if="{{hasSpeech}}" class="speech-field-button speech-field-button--compact {{recording && speechTarget === 'faultLocation' ? 'speech-field-button--on' : ''}}" data-speech-target="faultLocation" data-speech-label="实际位置" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord"><view class="complete-speech__mic"></view><view><view class="speech-field-button__title">{{recording && speechTarget === 'faultLocation' ? '松开结束' : '按住说实际位置'}}</view><view wx:if="{{guide}}" class="speech-field-button__desc">识别后自动填入</view></view></button>
      <view wx:if="{{recording && speechTarget === 'faultLocation'}}" class="speech-field-listening">正在听：{{partial || '请继续说…'}}</view>
      <view class="complete-label complete-label--next">实际故障现象 <text>选填</text></view>
      <textarea class="complete-textarea complete-textarea--short" placeholder="例如：门铃电源老化，线路接触不良" value="{{faultSymptom}}" data-field="faultSymptom" bindinput="onFaultInput"/>
      <button wx:if="{{hasSpeech}}" class="speech-field-button speech-field-button--compact {{recording && speechTarget === 'faultSymptom' ? 'speech-field-button--on' : ''}}" data-speech-target="faultSymptom" data-speech-label="实际故障现象" bindtouchstart="onStartRecord" bindtouchend="onStopRecord" bindtouchcancel="onStopRecord"><view class="complete-speech__mic"></view><view><view class="speech-field-button__title">{{recording && speechTarget === 'faultSymptom' ? '松开结束' : '按住说故障现象'}}</view><view wx:if="{{guide}}" class="speech-field-button__desc">识别后自动填入</view></view></button>
      <view wx:if="{{recording && speechTarget === 'faultSymptom'}}" class="speech-field-listening">正在听：{{partial || '请继续说…'}}</view>
      <view class="complete-label complete-label--next">收费金额（元） <text>不收费可留空</text></view>
      <view class="fee-input"><text>¥</text><input type="digit" placeholder="0.00" value="{{feeYuan}}" bindinput="onFeeInput"/></view>
      <view wx:if="{{feeSuggestionText}}" class="ai-basis">{{feeSuggestionText}}。金额不会自动提交，可直接修改。</view>
    </view>

    <view class="complete-card">
      <view class="complete-card__head">
        <view class="complete-card__num">3</view>
        <view><view class="complete-card__title">本单用料</view><view wx:if="{{guide}}" class="complete-card__desc">提交前核对本单已经记录的用料</view></view>
      </view>
      <view class="complete-label">本单用料</view>
      <view wx:if="{{materialRows.length}}" class="used-list">
        <view wx:for="{{materialRows}}" wx:key="index" class="used-item">
          <view class="used-item__name">{{item.name}}</view>
          <view class="used-item__qty">×{{item.qty}}{{item.unit || ''}}</view>
          <text wx:if="{{!item.materialId}}" class="used-item__tag">手填</text>
        </view>
      </view>
      <view wx:else class="complete-empty">还没有记录用料；如使用了材料，请先返回详情页添加用料</view>
    </view>

    <view class="complete-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </scroll-view>

  <view class="complete-foot">
    <button class="complete-submit" loading="{{busy}}" disabled="{{busy || uploading}}" bindtap="onComplete"><view class="complete-submit__check">✓</view><text>确认提交完工</text></button>
  </view>
</view>

<!-- ============ 领料仓库的库存选择器（叠在用料面板之上） ============ -->
<view wx:if="{{skuOpen}}" class="sheet-mask sheet-mask--top" bindtap="onCloseSku" catchtouchmove="noop"/>
<view wx:if="{{skuOpen}}" class="sheet sheet--top" catchtouchmove="noop">
  <view class="sheet__head">
    <text class="sheet__title">{{skuTitle}}</text>
    <view class="sheet__head-right">
      <!-- 默认仓由后台「小区 + 报修类型」配好；配漏了或那个仓空了，得让人自己挑一个 -->
      <text wx:if="{{warehouses.length}}" class="sheet__link" bindtap="onSwitchWarehouse">
        {{skuWarehouseId ? '换仓库' : '选仓库'}}
      </text>
      <text class="sheet__close" bindtap="onCloseSku">关闭</text>
    </view>
  </view>

  <!-- 没定下仓库就没有「库存」可言，搜索框/筛选/列头一起收起来，只留提示和「选仓库」 -->
  <block wx:if="{{skuWarehouseId}}">
    <input
      class="input sheet__search"
      placeholder="搜索名称 / 别名 / 型号 / 编码"
      value="{{skuKeyword}}"
      bindinput="onSkuKeyword"
    />

    <!-- 类别筛选：材料几十上百条，先按类别缩一轮比一直翻快得多。放不下就左右滑 -->
    <scroll-view wx:if="{{skuCategories.length > 1}}" class="chips chips--inset" scroll-x enable-flex>
      <view class="chip {{skuCategoryIndex < 0 ? 'chip--on' : ''}}" data-index="-1" bindtap="onPickSkuCategory">全部</view>
      <view
        class="chip {{skuCategoryIndex === index ? 'chip--on' : ''}}"
        wx:for="{{skuCategories}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onPickSkuCategory"
      >{{item}}</view>
    </scroll-view>

    <!-- 列头常驻：列表一滚起来就不知道右边那个数字是什么了 -->
    <view class="sku-head">
      <text class="sku-head__photo">图片</text>
      <text class="sku-head__name">名称</text>
      <text class="sku-head__qty">库存数量</text>
    </view>
  </block>

  <scroll-view class="sheet__body sheet__body--flush" scroll-y>
    <view wx:if="{{skuLoading}}" class="center muted">加载中…</view>
    <block wx:elif="{{skuError}}">
      <view class="error">{{skuError}}</view>
      <button class="btn btn--outline mt" bindtap="onRetrySku">重试</button>
    </block>
    <block wx:else>
      <view wx:if="{{skuEmptyHint}}" class="sku-empty">{{skuEmptyHint}}</view>

      <block wx:if="{{skuWarehouseId}}">
        <view wx:if="{{!skuList.length}}" class="center muted sku-no-result">
          <text>{{skuKeyword ? '材料库里没有匹配的材料' : '默认只展示有库存的材料；输入名称也能搜到库存为 0 的材料，选中后会加入采购申请'}}</text>
          <!-- 搜不到就地申购：带着搜索词新建一行，不用关掉弹层再去找按钮 -->
          <button wx:if="{{skuKeyword}}" class="btn btn--outline mt sku-purchase" data-name="{{skuKeyword}}" bindtap="onAddPurchaseFromSku">
            <view class="btn__icon icon-action--edit-blue"></view><text>申购新材料「{{skuKeyword}}」</text>
          </button>
        </view>

        <view
          wx:for="{{skuList}}"
          wx:key="materialId"
          class="sku"
          hover-class="wo-card--hover"
          hover-stay-time="80"
          data-index="{{index}}"
          bindtap="onPickSku"
        >
          <image
            wx:if="{{item.photoUrl}}"
            class="sku__photo"
            src="{{item.photoUrl}}"
            mode="aspectFill"
            data-url="{{item.photoUrl}}"
            data-urls="{{item.photoUrls}}"
            catchtap="onPreviewSkuPhoto"
          />
          <view wx:else class="sku__photo sku__photo--empty">无图</view>
          <view class="sku__body">
            <view class="sku__title">{{item.name}}{{item.spec ? ' · ' + item.spec : ''}}</view>
            <view class="meta">{{item.code}} · {{item.category || '未分类'}}</view>
          </view>
          <!-- 有多少货是选料时最该看见的一列 -->
          <view class="sku__qty {{item.qty > 0 ? '' : 'sku__qty--none'}}">
            {{item.qty > 0 ? item.qty + item.unit : '无货 · 申购'}}
          </view>
        </view>
      </block>

      <button
        wx:if="{{!skuWarehouseId}}"
        class="btn btn--outline mt"
        bindtap="onSwitchWarehouse"
        disabled="{{!warehouses.length}}"
      ><view class="btn__icon icon-action--box-blue"></view><text>选仓库</text></button>
    </block>
  </scroll-view>
</view>
