<import src="/templates/wo-card.wxml"/>

<!-- 深色页头（data-first-ui）：「手上几单、其中几单压着」第一眼说完。
     和工单池同一套页头 + 数据卡，两屏之间不用重新认版式。
     标题写死「在手工单」，和 my-orders.json 的 navigationBarTitleText 同源 —— 改一处要改两处。 -->
<view class="hero">
  <view class="hero__top">
    <view class="hero__title">在手工单</view>
    <view class="hero__count">{{active.length}} 单在手</view>
  </view>
  <view class="hero__hint">先做紧急和等待时间较长的任务</view>
  <view wx:if="{{overdueCount}}" class="hero__stats">
    <!-- 一单都没压着就整格不显示：常年挂个 0 会让这抹红失去意义 -->
    <view>
      <view class="hero__num hero__num--danger">{{overdueCount}}</view>
      <view class="hero__cap">压 3 天以上</view>
    </view>
  </view>
</view>

<!-- 这一页只有「手上真正要干的活」。
     「我报的」和「已完结」2026-08-31 搬去工单池的三档 Tab 了 —— 这一屏是干活的地方，
     底下压着一摞已经结束的单，人得先翻过它们才看得到今天该干什么。 -->
<view class="hero-sheet hero-sheet--tabbar">
  <view wx:if="{{!active.length && loaded}}">
    <pms-empty text="手上没有工单，去「工单池」接一单"/>
  </view>

  <view
    wx:for="{{active}}"
    wx:key="id"
    class="card wo-card wo-card--data"
    hover-class="wo-card--hover"
    hover-stay-time="80"
    bindtap="onTapItem"
    data-id="{{item.id}}"
  >
    <!-- 卡片正文（地址一行 + 报修内容一行 + 数据网格）在 /templates/wo-card.wxml，
         和工单池共用一份。手上的活要找谁开门，所以第三格放报修人 -->
    <template
      is="wo-card-body"
      data="{{item: item, thirdLabel: '报修人', thirdValue: item.statReporter, thirdHint: item.statReporterHint}}"
    />

    <view class="wo-card__foot">
      <text class="wo-card__more">{{item.actionText}} ›</text>
    </view>
  </view>
</view>
