<view class="container container--tabbar">
  <view class="page-lead">
    <view class="page-lead__title">在手 {{active.length}} 条</view>
  </view>

  <view wx:if="{{!active.length && !done.length && loaded}}">
    <pms-empty text="手上没有工单，去「工单池」接一单"/>
  </view>

  <view
    wx:for="{{active}}"
    wx:key="id"
    class="card wo-card"
    hover-class="wo-card--hover"
    hover-stay-time="80"
    bindtap="onTapItem"
    data-id="{{item.id}}"
  >
    <view class="wo-card__head">
      <view class="wo-card__title">
        <text wx:if="{{item.urgent}}" class="badge--urgent">紧急</text>
        <text class="wo-card__type">{{item.typeLabel}}</text>
      </view>
      <pms-tag class="status-tag" status="{{item.status}}"/>
    </view>

    <view class="kv"><text class="kv__k">工单编号</text><text class="kv__v">{{item.orderNo}}</text></view>
    <view class="kv"><text class="kv__k">报修地址</text><text class="kv__v">{{item.summaryAddress || '未填地址'}}</text></view>
    <view class="kv"><text class="kv__k">故障描述</text><text class="kv__v kv__v--clamp">{{item.summaryContent}}</text></view>
    <view class="kv">
      <text class="kv__k">报修时间</text>
      <text class="kv__v">{{item.timeText}}<text class="kv__tag kv__tag--{{item.stayTone}}">{{item.stayBadge}}</text></text>
    </view>

    <view class="wo-card__foot">
      <text class="wo-card__more">{{item.actionText}} ›</text>
    </view>
  </view>

  <!-- 已完结的默认收起：手上真正要干的活才该占屏幕 -->
  <view wx:if="{{done.length}}" class="fold" bindtap="onToggleDone">
    <text class="fold__title">已完结 {{done.length}} 条</text>
    <text class="fold__action">{{doneOpen ? '收起' : '展开'}}</text>
  </view>

  <block wx:if="{{doneOpen}}">
    <view
      wx:for="{{done}}"
      wx:key="id"
      class="card wo-card wo-card--done"
      hover-class="wo-card--hover"
      hover-stay-time="80"
      bindtap="onTapItem"
      data-id="{{item.id}}"
    >
      <view class="wo-card__head">
        <view class="wo-card__title">
          <text class="wo-card__type">{{item.typeLabel}}</text>
        </view>
        <pms-tag class="status-tag" status="{{item.status}}"/>
      </view>

      <view class="kv"><text class="kv__k">工单编号</text><text class="kv__v">{{item.orderNo}}</text></view>
      <view class="kv"><text class="kv__k">报修地址</text><text class="kv__v">{{item.summaryAddress || '未填地址'}}</text></view>
      <view class="kv"><text class="kv__k">报修时间</text><text class="kv__v">{{item.createdAtText}}</text></view>

      <view class="wo-card__foot">
        <text class="wo-card__more">查看详情 ›</text>
      </view>
    </view>
  </block>
</view>
