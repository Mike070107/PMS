<import src="/templates/wo-card.wxml"/>

<view class="work-hero">
  <view class="work-hero__top">
    <view>
      <view class="work-hero__eyebrow">我的现场任务</view>
      <view class="work-hero__title">在手工单</view>
    </view>
    <view class="work-hero__count">{{active.length}} 单在手</view>
  </view>
  <view class="work-hero__hint">紧急优先；同组按报修时间从早到晚</view>
  <view class="work-metrics">
    <view class="work-metric work-metric--danger">
      <view class="work-metric__value">{{urgentCount}}</view>
      <view class="work-metric__label">紧急</view>
    </view>
    <view class="work-metric work-metric--warning">
      <view class="work-metric__value">{{waitingMaterialCount}}</view>
      <view class="work-metric__label">等待材料</view>
    </view>
    <view class="work-metric">
      <view class="work-metric__value">{{normalCount}}</view>
      <view class="work-metric__label">普通</view>
    </view>
  </view>
</view>

<!-- 这一页只有「手上真正要干的活」。
     「我报的」和「已完结」2026-08-31 搬去工单池的三档 Tab 了 —— 这一屏是干活的地方，
     底下压着一摞已经结束的单，人得先翻过它们才看得到今天该干什么。 -->
<view class="hero-sheet hero-sheet--tabbar">
  <view wx:if="{{!active.length && loaded}}">
    <pms-empty text="手上没有工单，去「工单池」接一单"/>
  </view>

  <block
    wx:for="{{active}}"
    wx:key="id"
  >
    <view wx:if="{{item.groupStart}}" class="priority-group {{item.urgent ? 'priority-group--urgent' : ''}}">
      <view class="priority-group__title">{{item.groupLabel}}</view>
      <view class="priority-group__hint">同组按报修时间从早到晚</view>
    </view>
    <view
    class="card wo-card wo-card--data"
    hover-class="wo-card--hover"
    hover-stay-time="80"
    bindtap="onTapItem"
    data-id="{{item.id}}"
  >
    <!-- 卡片正文（地址一行 + 报修内容一行 + 数据网格）在 /templates/wo-card.wxml，
         和工单池共用一份。手上的活要找谁开门，所以第三格放报修人 -->
    <template
      is="wo-card-body"
      data="{{item: item, thirdLabel: '报修人', thirdValue: item.statReporter, thirdHint: item.statReporterHint}}"
    />

    <view class="wo-card__foot">
      <text class="wo-card__more">{{item.actionText}} ›</text>
    </view>
    </view>
  </block>
</view>
