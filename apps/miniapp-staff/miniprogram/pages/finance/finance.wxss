page{background:#eef3f8;color:#20324b;font-family:-apple-system,"PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif}.page{padding:28rpx 28rpx 60rpx}.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx;padding:34rpx;border:2rpx solid #d6e3f0;border-radius:28rpx;background:linear-gradient(135deg,#f8fbff,#e8f2ff)}.hero__eyebrow{font-size:26rpx;color:#3971a6;font-weight:700}.hero__title{font-size:48rpx;font-weight:800;margin:8rpx 0}.hero__desc{font-size:28rpx;color:#687b91;line-height:1.6}.hero__button{flex-shrink:0;margin:0;min-height:88rpx;padding:0 28rpx;border:0;border-radius:18rpx;background:#31558a;color:#fff;font-size:32rpx;font-weight:700}.hero__button::after,.save::after,.voice::after{border:0}.list{display:flex;flex-direction:column;gap:20rpx;margin-top:28rpx}.entry-card{padding:28rpx;background:#fff;border:2rpx solid #dfe7ef;border-radius:22rpx}.entry-card__top{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.entry-card__reason{font-size:34rpx;font-weight:700;line-height:1.5}.entry-card__amount{flex-shrink:0;font-size:38rpx;font-weight:800;font-variant-numeric:tabular-nums}.entry-card__amount--expense{color:#bf5543}.entry-card__amount--income{color:#17805b}.entry-card__meta{display:flex;align-items:center;gap:12rpx;margin-top:16rpx;color:#718097;font-size:28rpx}.status{margin-left:auto;padding:6rpx 14rpx;border-radius:999rpx;background:#eef2f6}.status--pending{color:#a85c12;background:#fff1dc}.status--reimbursed{color:#14744f;background:#e6f6ef}.empty{margin-top:30rpx;padding:90rpx 36rpx;text-align:center;color:#728096;background:#fff;border-radius:22rpx;font-size:30rpx}.empty__title{margin-bottom:12rpx;color:#344a67;font-size:36rpx;font-weight:700}.mask{position:fixed;inset:0;z-index:100;background:rgba(21,35,52,.48)}.sheet{position:fixed;z-index:101;left:0;right:0;bottom:0;display:flex;flex-direction:column;max-height:calc(100vh - 100rpx - env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#f7f9fc}.sheet__head{display:flex;align-items:center;justify-content:space-between;padding:30rpx 32rpx 20rpx}.sheet__title{font-size:40rpx;font-weight:800}.sheet__close{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;color:#617187;font-size:48rpx}.sheet__body{flex:1;min-height:0;padding:0 32rpx}.field{margin-top:24rpx}.label{font-size:30rpx;font-weight:700;margin-bottom:12rpx}.hint{font-size:26rpx;color:#758397}.segmented,.choices{display:flex;flex-wrap:wrap;gap:14rpx}.segment,.choice{display:flex;align-items:center;justify-content:center;min-height:84rpx;padding:0 28rpx;border:2rpx solid #d5dee8;border-radius:16rpx;background:#fff;color:#52657b;font-size:30rpx}.segment{flex:1}.segment--active,.choice--active{border-color:#31558a;background:#eaf2fb;color:#294d7b;font-weight:700}.segment--active.expense{border-color:#bf5543;background:#fff0ed;color:#a84736}.segment--active.income{border-color:#17805b;background:#e9f7f1;color:#116c4c}.money-input{display:flex;align-items:center;min-height:100rpx;padding:0 24rpx;border:2rpx solid #cfd9e4;border-radius:18rpx;background:#fff;font-size:38rpx}.money-input input{flex:1;height:100rpx;margin-left:12rpx;font-size:44rpx;font-weight:800}.textarea{box-sizing:border-box;width:100%;min-height:180rpx;padding:22rpx;border:2rpx solid #cfd9e4;border-radius:18rpx;background:#fff;font-size:32rpx;line-height:1.6}.voice{margin-top:14rpx;min-height:88rpx;border:2rpx solid #9db1c6;border-radius:999rpx;background:#fff;color:#31558a;font-size:30rpx;font-weight:700;touch-action:none}.voice--on{border-color:#31558a;background:#31558a;color:#fff}.picker{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;padding:0 24rpx;border:2rpx solid #cfd9e4;border-radius:18rpx;background:#fff;font-size:32rpx}.switch-row{display:flex;align-items:center;justify-content:space-between}.sheet__spacer{height:36rpx}.sheet__footer{flex-shrink:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));border-top:2rpx solid #e2e8ef;background:#fff}.save{min-height:92rpx;border:0;border-radius:18rpx;background:#31558a;color:#fff;font-size:36rpx;font-weight:800}
