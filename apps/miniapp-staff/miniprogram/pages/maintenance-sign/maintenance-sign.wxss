/* 养护单查验签字。纸面所有尺寸都在 WXML 里按 mm × k 内联，这里只放不随缩放变的皮肤：
   线、底色、字体、对齐。和 Web 端 maintenance-sheet.css 是同一张纸的两套皮，改样子两边一起改。 */
page { background: #edf2f7; }
.sign-page { min-height: 100vh; color: #22384c; }
.sign-state { padding: 240rpx 48rpx 80rpx; text-align: center; color: #718396; font-size: 30rpx; }
.sign-state__mark { width: 104rpx; height: 104rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #fff0ef; color: #bd3c39; font-size: 64rpx; font-weight: 700; line-height: 104rpx; }
.sign-state__title { color: #253b50; font-size: 36rpx; font-weight: 700; }
.sign-state__text { margin-top: 18rpx; line-height: 1.7; }

/* 顶栏：一句「请签署谁」+ 缩放。说明只留一行，纸本身就是说明 */
.sign-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 24rpx; background: #fff; border-bottom: 2rpx solid #dce5ed; }
.sign-toolbar__body { flex: 1; min-width: 0; }
.sign-toolbar__title { color: #1f3851; font-size: 34rpx; font-weight: 800; line-height: 1.4; }
.sign-toolbar__sub { margin-top: 4rpx; overflow: hidden; color: #74889a; font-size: 26rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.sign-zoom { display: flex; align-items: center; flex-shrink: 0; border: 2rpx solid #d2dde7; border-radius: 16rpx; overflow: hidden; }
.sign-zoom button { width: 72rpx; height: 72rpx; min-height: 0; margin: 0; padding: 0; border-radius: 0; background: #f8fafc; color: #31558a; font-size: 36rpx; line-height: 1; }
.sign-zoom button::after { border: 0; }
.sign-zoom text { width: 88rpx; color: #526a80; font-size: 24rpx; text-align: center; }

/* 纸铺在灰底上，横竖都能滚；正反两面上下排 */
.sign-scroll { width: 100%; height: calc(100vh - 150rpx - 190rpx - env(safe-area-inset-bottom)); }
.sign-canvas { display: inline-flex; flex-direction: column; gap: 24rpx; padding: 24rpx; }

/* ---------- 纸 ---------- */
.mo-sheet {
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
  color: #000;
  box-shadow: 0 8rpx 30rpx rgba(38, 58, 78, 0.12);
  /* 表单字体用宋体系：这是单据的标准脸，缺字回退到系统中文字体 */
  font-family: 'SimSun', '宋体', 'Songti SC', 'STSong', 'Noto Serif CJK SC', serif;
  line-height: 1.12;
}
/* 骑缝线只画正面 */
.mo-perf { position: absolute; width: 0; border-left: 2rpx dashed #000; }
.mo-block { position: absolute; }
.mo-head { display: flex; align-items: center; justify-content: center; }
.mo-head__anchor { position: relative; display: inline-flex; align-items: baseline; }
.mo-head__after { position: absolute; left: 100%; bottom: 0; display: flex; align-items: baseline; white-space: nowrap; }
.mo-title { font-family: 'SimHei', '黑体', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans CJK SC', sans-serif; font-weight: 700; line-height: 1; white-space: nowrap; }
/* 号码机盖上去的那串红字 */
.mo-no { display: inline-block; font-family: 'Arial', 'Helvetica', sans-serif; color: rgb(192, 75, 89); line-height: 1; transform: rotate(-1.8deg); white-space: nowrap; }
.mo-no__page { color: #000; }
.mo-unitline { display: flex; align-items: flex-end; }
.mo-unitline__value { display: flex; align-items: center; justify-content: center; border-bottom: 2rpx solid #000; }

.mo-tbl { width: 100%; box-sizing: border-box; border: 2rpx solid #000; }
.mo-tbl--flush { border: 0; }
.mo-row { display: flex; width: 100%; box-sizing: border-box; }
.mo-row + .mo-row { border-top: 1rpx solid #000; }
.mo-cell {
  position: relative;
  flex: 0 0 auto;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}
.mo-cell + .mo-cell { border-left: 1rpx solid #000; }
.mo-cell--grow { flex: 1 1 auto; }
.mo-cell--left { justify-content: flex-start; text-align: left; }
.mo-cell--top { align-items: flex-start; }
.mo-cell--full { width: 100%; }
/* 本次要签的那一格：黄底 + 金边，一眼知道往哪儿点 */
.mo-cell--target { background: #fff6d6; box-shadow: inset 0 0 0 3rpx #dda836; }
.mo-lb { white-space: pre-line; }
/* 填上去的内容：楷体/行楷有就用，没有退到系统字体，加粗跟纸上手写的分量接近 */
.mo-txt {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-family: 'STXingkai', '华文行楷', 'Xingkai SC', 'STKaiti', '华文楷体', 'KaiTi', '楷体', cursive;
  font-weight: 700;
  color: #000;
  white-space: pre-wrap;
  word-break: break-all;
}
.mo-txt--left { justify-content: flex-start; text-align: left; }
.mo-txt--wrap { align-items: flex-start; }
.mo-txt--paren { flex: 0 0 auto; height: 100%; }
.mo-total__v, .mo-md__n, .mo-addr__val { font-family: 'STXingkai', '华文行楷', 'Xingkai SC', 'STKaiti', '华文楷体', 'KaiTi', '楷体', cursive; font-weight: 700; }

/* 地址格两行：上行「村」正对着下行的「弄」 */
.mo-addr { display: flex; flex-direction: column; justify-content: center; width: 100%; height: 100%; }
.mo-addr__row { display: flex; align-items: baseline; width: 100%; }
.mo-addr__slot { display: flex; align-items: baseline; flex: 1 1 auto; min-width: 0; }
.mo-addr__val { flex: 1 1 auto; min-width: 0; overflow: hidden; text-align: center; white-space: nowrap; }
.mo-addr__unit { flex: 0 0 auto; padding: 0 1rpx; }

.mo-paren { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.mo-ymd { display: flex; align-items: baseline; justify-content: center; }
.mo-tick { font-family: 'SimSun', '宋体', serif; line-height: 1; }
.mo-sign { display: block; max-width: 100%; width: 100%; height: 100%; }
.mo-signslot__hint { color: #9bb0ad; }
.mo-md { position: absolute; }
.mo-total { display: flex; align-items: center; width: 100%; height: 100%; }
.mo-total__v { flex: 1 1 auto; text-align: center; }
.mo-vpair { display: flex; align-items: center; justify-content: center; }
.mo-col2 { display: flex; flex-direction: column; width: 100%; height: 100%; }
.mo-sub { display: flex; align-items: center; justify-content: center; width: 100%; box-sizing: border-box; }
.mo-sub + .mo-sub { border-top: 1rpx solid #000; }
.mo-sub--row { display: flex; align-items: stretch; }
.mo-sub--row .mo-cell { height: 100%; }

/* 背面：左块表格 + 右侧「折旧料」一列 */
.mo-back-grid { display: flex; width: 100%; box-sizing: border-box; border: 2rpx solid #000; }
.mo-back-grid__left { flex: 0 0 auto; }
.mo-back-grid__right { flex: 1 1 auto; display: flex; flex-direction: column; border-left: 1rpx solid #000; }
.mo-back-grid__right .mo-cell + .mo-cell { border-left: 0; border-top: 1rpx solid #000; }
.mo-notes { line-height: 1.75; }
.mo-notes__item { text-indent: 2em; }

/* ---------- 底栏 / 签字板（与改版前一致） ---------- */
.sign-actions-safe { height: 190rpx; }
.sign-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 12rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #d4dee7; background: rgba(255, 255, 255, .97); box-shadow: 0 -8rpx 26rpx rgba(28, 49, 68, .08); }
.sign-actions__hint { margin-bottom: 10rpx; color: #8492a0; font-size: 24rpx; text-align: center; }
.sign-actions__buttons { display: flex; gap: 16rpx; }
.sign-actions__buttons button { flex: 1; min-height: 96rpx; margin: 0; border-radius: 16rpx; font-size: 34rpx; font-weight: 800; }
.sign-actions__write { border: 2rpx solid #31558a; background: #fff; color: #31558a; }
.sign-actions__submit { border: 0; background: #31558a; color: #fff; }
.sign-actions__buttons button::after { border: 0; }
.sign-pad-mask { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 24rpx; background: rgba(15, 29, 42, .72); }
.sign-pad { width: 100%; max-width: 1100rpx; padding: 22rpx; border-radius: 24rpx; background: #f7fafc; box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, .28); }
.sign-pad__head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 18rpx; }
.sign-pad__head strong { display: block; color: #1d3850; font-size: 34rpx; }
.sign-pad__head text { display: block; margin-top: 5rpx; color: #7a8c9d; font-size: 26rpx; }
.sign-pad__head button { min-height: 72rpx; margin: 0; padding: 0 22rpx; background: #e9eef3; color: #50677b; font-size: 28rpx; line-height: 1.2; }
.sign-pad__head button::after { border: 0; }
.sign-pad__canvas { width: 100%; height: 430rpx; border: 3rpx dashed #8ea2b4; border-radius: 18rpx; background: #fff; }
.sign-pad__foot { display: flex; gap: 14rpx; margin-top: 18rpx; }
.sign-pad__foot button { flex: 1; min-height: 88rpx; margin: 0; border: 0; border-radius: 14rpx; background: #e7edf2; color: #4f667a; font-size: 30rpx; font-weight: 700; }
.sign-pad__foot .sign-pad__keep { flex: 1.7; background: #31558a; color: #fff; }
.sign-pad__foot button::after { border: 0; }
@media (orientation: landscape) {
  .sign-pad { width: 92vw; }
  .sign-pad__canvas { height: 54vh; }
}
