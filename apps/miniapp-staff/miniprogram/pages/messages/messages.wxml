<view class="container">
  <view class="screen-head">
    <view class="screen-head__title">消息中心</view>
    <view class="screen-head__desc">工单指派、缺料进度和系统提醒都在这里</view>
  </view>
  <view wx:if="{{list.length && unread}}" class="topbar">
    <text class="topbar__count">{{unread}} 条未读</text>
    <text class="topbar__action" bindtap="onReadAll">全部标为已读</text>
  </view>

  <view wx:if="{{!list.length && loaded}}" class="empty-wrap">
    <pms-empty text="还没有消息。派给你的工单会在这里提醒"/>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="msg {{item.readAt ? '' : 'msg--unread'}}"
    data-index="{{index}}"
    bindtap="onTapItem"
  >
    <!-- 未读用一个小圆点标出来，比整条变色克制，也不影响阅读 -->
    <view class="msg__dot {{item.readAt ? 'msg__dot--off' : ''}}"></view>
    <view class="msg__body">
      <view class="msg__title">{{item.title}}</view>
      <view wx:if="{{item.desc}}" class="msg__desc">{{item.desc}}</view>
      <view class="msg__time">{{item.timeText}}</view>
    </view>
    <view wx:if="{{item.page}}" class="icon icon--chevron"></view>
  </view>
</view>
