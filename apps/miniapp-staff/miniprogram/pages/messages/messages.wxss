/* 和业主端消息页同一套外观（那边在 pages/messages 下），改一处两边都要看一眼 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: 0 var(--space-xs) 18rpx;
}
.topbar__count { font-size: var(--font-md); color: var(--color-text-tertiary); }
.topbar__action {
  min-height: var(--tap-min);
  display: inline-flex;
  align-items: center;
  padding: 0 var(--space-sm);
  color: var(--color-brand);
  font-size: var(--font-md);
}
.topbar__action:active { opacity: 0.6; }

.msg {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #dbe5ee;
  border-radius: 28rpx;
  background: var(--color-card-bg);
  box-shadow: 0 6rpx 18rpx rgba(26,54,83,.05);
  transition: opacity var(--dur) ease;
}
.msg:active { opacity: 0.75; }
.msg--unread { background: #edf5fb; border-color: #b9d1e4; }

.msg__dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--color-brand);
}
.msg__dot--off { background: transparent; }

.msg__body { flex: 1; min-width: 0; }
.msg__title { font-size: var(--font-xl); font-weight: 600; line-height: 1.5; }
/* 派单备注 / 故障描述：光一句「有新工单」判断不了要不要现在去 */
.msg__desc {
  margin-top: 8rpx;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.6;
}
.msg__time {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

.empty-wrap { padding-top: 96rpx; }
