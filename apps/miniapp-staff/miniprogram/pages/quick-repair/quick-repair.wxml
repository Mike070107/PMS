<view class="container container--with-bar">
  <view class="screen-head">
    <view class="screen-head__title">AI 随手拍报修</view>
    <view class="screen-head__desc">拍现场、说清位置和故障，AI 帮你整理成报修单</view>
  </view>

  <!-- 1. 拍 -->
  <view class="card">
    <view class="label">现场照片 / 视频<text class="label__opt">最多 {{maxImages}} 张，视频 1 段 {{maxVideoSeconds}} 秒</text></view>
    <view class="thumbs">
      <view wx:for="{{mediaList}}" wx:key="url" class="thumb-wrap">
        <video
          wx:if="{{item.video}}"
          class="thumb"
          src="{{item.url}}"
          object-fit="cover"
          show-center-play-btn="{{true}}"
        />
        <image
          wx:else
          class="thumb"
          src="{{item.url}}"
          mode="aspectFill"
          data-url="{{item.url}}"
          bindtap="onPreviewMedia"
        />
        <view class="thumb-remove" data-index="{{index}}" catchtap="onRemoveMedia">
          <view class="icon icon--close"></view>
        </view>
      </view>
      <view
        wx:if="{{attachments.length - videoCount < maxImages}}"
        class="thumb-add"
        data-type="image"
        bindtap="onCapture"
      >
        <view class="icon icon--camera"></view>
        <text class="add-text">{{uploading ? '上传中' : '拍照'}}</text>
      </view>
      <view wx:if="{{!videoCount}}" class="thumb-add" data-type="video" bindtap="onCapture">
        <view class="icon icon--camera"></view>
        <text class="add-text">{{uploading ? '上传中' : '拍视频'}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 说 -->
  <view class="card">
    <view class="label">说一句话<text class="label__opt">普通话</text></view>

    <button
      wx:if="{{hasSpeech}}"
      class="hold {{recording ? 'hold--on' : ''}}"
      bindtouchstart="onStartRecord"
      bindtouchend="onStopRecord"
      bindtouchcancel="onStopRecord"
    ><view class="btn__icon icon-action--mic-white"></view><text>{{recording ? '松开结束' : '按住说话'}}</text></button>

    <!-- 按钮下面这段是「这页到底怎么用」：不写的话，人按完话不知道还要不要自己填表。
         例句用真实小区名，照着念一遍就能成一单 -->
    <view class="howto">
      <view class="howto__line">一句话描述故障地点和现象以及联系人联系电话，AI 自动填表。</view>
      <view class="howto__line">例如说出：<text class="howto__eg">枫桦一期17号201家里灯不亮，联系人张先生，电话13800138000</text></view>
      <view class="howto__line">然后点【提交报修】即可</view>
    </view>

    <view wx:if="{{recording && partial}}" class="partial">{{partial}}</view>

    <textarea
      class="say"
      placeholder="例：枫桦一期17号201家里灯不亮，联系人张先生，电话13800138000"
      value="{{content}}"
      bindinput="onInput"
    />
  </view>

  <!-- 3. 认出来的：认出来才显示，认不出就不占地方 -->
  <view wx:if="{{found.length}}" class="card">
    <view class="label">已自动认出<text class="label__opt">不对就改用完整表单</text></view>
    <view wx:for="{{found}}" wx:key="key" class="kv">
      <text class="kv__k">{{item.label}}</text>
      <text class="kv__v">{{item.value}}</text>
    </view>
  </view>

  <!-- 说了「急修」就标紧急。整行可点：取消 / 标回来都在这一下 -->
  <view
    wx:if="{{urgentMatched || urgent}}"
    class="card urgency {{urgent ? 'urgency--on' : ''}}"
    bindtap="onToggleUrgent"
  >
    <text class="urgency__badge">{{urgent ? '紧急' : '普通'}}</text>
    <view class="urgency__body">
      <view class="urgency__text">{{urgent ? '这单按紧急处理' : '这单不按紧急处理'}}</view>
      <view class="urgency__hint">{{urgent ? urgentReasonText + '，点这行取消' : '点这行标回紧急'}}</view>
    </view>
  </view>

  <view wx:if="{{needManual}}" class="card">
    <view class="sku-empty">
      这句话里没认出小区房号。说清楚「几期几号几室」再说一次，或者改用完整表单逐项填。
    </view>
    <button class="btn btn--outline mt" bindtap="onEditInFull">
      <view class="btn__icon icon-action--form-blue"></view><text>改用完整表单</text>
    </button>
  </view>

  <view wx:if="{{errorMsg}}" class="error card">{{errorMsg}}</view>
</view>

<view class="action-bar">
  <button class="btn btn--ghost" bindtap="onEditInFull">
    <view class="btn__icon icon-action--edit-blue"></view><text>完整表单</text>
  </button>
  <button
    class="btn btn--primary"
    loading="{{submitting}}"
    disabled="{{submitting || uploading}}"
    bindtap="onSubmit"
  ><view class="btn__icon icon-action--send-white"></view><text>提交报修</text></button>
</view>
