<view class="container container--with-bar">
  <view class="screen-head">
    <view class="screen-head__title">AI 随手拍报修</view>
    <view class="screen-head__desc">按住说一句话，AI 自动整理地址、故障和联系人</view>
  </view>

  <!-- 1. 先说：这是这页的主入口，保持和微信发语音一样的“按住说、松开发送”。 -->
  <view class="card quick-step quick-step--primary">
    <view class="quick-step__head">
      <text class="quick-step__num">1</text>
      <view><view class="quick-step__title">按住说一句话</view><view class="quick-step__desc">说清地点、故障、联系人和电话</view></view>
    </view>

    <button
      wx:if="{{hasSpeech}}"
      class="hold {{recording ? 'hold--on' : ''}}"
      bindtouchstart="onStartRecord"
      bindtouchend="onStopRecord"
      bindtouchcancel="onStopRecord"
    ><view class="btn__icon icon-action--mic-white"></view><text>{{recording ? '正在听，松开发送' : '按住说话'}}</text></button>

    <!-- 按钮下面这段是「这页到底怎么用」：不写的话，人按完话不知道还要不要自己填表。
         例句用真实小区名，照着念一遍就能成一单 -->
    <view class="howto">
      <view class="howto__line">一句话描述故障地点和现象以及联系人联系电话，AI 自动填表。</view>
      <view class="howto__line">例如说出：<text class="howto__eg">枫桦一期17号201家里灯不亮，联系人张先生，电话13800138000</text></view>
      <view class="howto__line">然后点【提交报修】即可</view>
    </view>

    <view wx:if="{{recording && partial}}" class="partial">{{partial}}</view>

    <textarea
      class="say"
      placeholder="例：枫桦一期17号201家里灯不亮，联系人张先生，电话13800138000"
      value="{{content}}"
      bindinput="onInput"
    />
  </view>

  <!-- 2. 照片是补充，不挡住一句话报修的主路径。 -->
  <view class="card quick-step">
    <view class="quick-step__head">
      <text class="quick-step__num">2</text>
      <view><view class="quick-step__title">补充现场照片</view><view class="quick-step__desc">选填，方便维修工提前判断</view></view>
    </view>
    <view class="thumbs">
      <view wx:for="{{mediaList}}" wx:key="url" class="thumb-wrap">
        <video wx:if="{{item.video}}" class="thumb" src="{{item.url}}" object-fit="cover" show-center-play-btn="{{true}}" />
        <image wx:else class="thumb" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="onPreviewMedia" />
        <view class="thumb-remove" data-index="{{index}}" catchtap="onRemoveMedia"><view class="icon icon--close"></view></view>
      </view>
      <view wx:if="{{attachments.length - videoCount < maxImages}}" class="thumb-add" data-type="image" bindtap="onCapture">
        <view class="icon icon--camera"></view><text class="add-text">{{uploading ? '上传中' : '拍照'}}</text>
      </view>
      <view wx:if="{{!videoCount}}" class="thumb-add" data-type="video" bindtap="onCapture">
        <view class="icon icon--camera"></view><text class="add-text">{{uploading ? '上传中' : '拍视频'}}</text>
      </view>
    </view>
    <view class="quick-step__limit">最多 {{maxImages}} 张照片，或 1 段 {{maxVideoSeconds}} 秒视频</view>
  </view>

  <!-- 3. 识别结果集中确认，避免自动填入后还要去多个位置寻找。 -->
  <view wx:if="{{found.length}}" class="card ai-result">
    <view class="ai-result__head">
      <view class="ai-result__mark">AI</view>
      <view class="ai-result__head-body">
        <view class="ai-result__title">已整理成报修单</view>
        <view class="ai-result__desc">重点核对地址和联系电话</view>
      </view>
    </view>
    <view wx:for="{{found}}" wx:key="key" class="kv">
      <text class="kv__k">{{item.label}}</text>
      <text class="kv__v">{{item.value}}</text>
    </view>
    <button class="btn btn--outline mt" bindtap="onEditInFull">
      <view class="btn__icon icon-action--edit-blue"></view><text>有内容不对，打开完整表单修改</text>
    </button>
  </view>

  <view class="card urgency-panel">
    <view class="quick-step__title">紧急程度</view>
    <view class="quick-step__desc">默认普通；只有确实需要优先处理时选择紧急</view>
    <view class="urgency-choice">
      <view class="urgency-choice__item {{!urgent ? 'urgency-choice__item--on' : ''}}" data-urgent="0" bindtap="onPickUrgency">
        <view class="urgency-choice__title">普通（默认）</view>
        <view class="urgency-choice__desc">按正常顺序处理</view>
      </view>
      <view class="urgency-choice__item urgency-choice__item--danger {{urgent ? 'urgency-choice__item--on' : ''}}" data-urgent="1" bindtap="onPickUrgency">
        <view class="urgency-choice__title">紧急</view>
        <view class="urgency-choice__desc">进入优先处理组</view>
      </view>
    </view>
    <view wx:if="{{urgent && urgentReasonText}}" class="urgency-reason">AI 判断依据：{{urgentReasonText}}</view>
  </view>

  <view wx:if="{{needManual}}" class="card">
    <view class="sku-empty">
      这句话里没认出小区房号。说清楚「几期几号几室」再说一次，或者改用完整表单逐项填。
    </view>
    <button class="btn btn--outline mt" bindtap="onEditInFull">
      <view class="btn__icon icon-action--form-blue"></view><text>改用完整表单</text>
    </button>
  </view>

  <view wx:if="{{errorMsg}}" class="error card">{{errorMsg}}</view>
</view>

<view class="action-bar">
  <button class="btn btn--ghost" bindtap="onEditInFull">
    <view class="btn__icon icon-action--edit-blue"></view><text>完整表单</text>
  </button>
  <button
    class="btn btn--primary"
    loading="{{submitting}}"
    disabled="{{submitting || uploading}}"
    bindtap="onSubmit"
  ><view class="btn__icon icon-action--send-white"></view><text>提交报修</text></button>
</view>
