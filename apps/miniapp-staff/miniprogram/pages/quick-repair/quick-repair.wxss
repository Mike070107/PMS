/* 卡片、缩略图、底部操作条、.kv 信息行都在 tokens.wxss / app.wxss 里统一定义，
   这里只放「按住说话」这一个本页独有的控件 */

/* 「按住说话」（.hold / .hold--on）已提到 app.wxss，和完工小结共用一套 */

.quick-step { overflow: hidden; }
.quick-step--primary {
  border-color: #b9d5ea;
  background: linear-gradient(180deg, #f8fcff 0%, #ffffff 100%);
}
.quick-step__head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.quick-step__num {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-brand);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.quick-step__title { color: #233f5a; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.quick-step__desc { margin-top: 4rpx; color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.5; }
.quick-step__limit { margin-top: 18rpx; color: var(--color-text-tertiary); font-size: 25rpx; line-height: 1.55; }
.quick-step--primary .hold {
  height: 148rpx;
  margin-top: 4rpx;
  border-radius: 74rpx;
  font-size: 38rpx;
  box-shadow: 0 14rpx 30rpx rgba(49, 85, 138, 0.25);
}
.quick-step--primary .hold .btn__icon { width: 50rpx; height: 50rpx; }
.quick-step--primary .hold--on {
  background: #b43b43;
  box-shadow: 0 0 0 14rpx rgba(197, 61, 69, 0.10);
}

.ai-result { border-color: #b7d5c7; background: #fbfefc; }
.ai-result__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #dcebe3;
}
.ai-result__mark {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: #2f7a54;
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
}
.ai-result__head-body { flex: 1; min-width: 0; }
.ai-result__title { color: #275f46; font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.ai-result__desc { margin-top: 3rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.urgency-panel { padding-top: 28rpx; }

/* 「按住说话」下面的用法说明。辅助说明用 26-28rpx（面向老人的下限），
   行高 1.6，别和上面的按钮挤在一起 */
.howto {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  background: #edf4fa;
  border: 2rpx solid #d7e5f0;
}
.howto__line {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}
.howto__line + .howto__line { margin-top: 8rpx; }
/* 例句给出颜色，一眼看得出「这句是照着念的」 */
.howto__eg { color: var(--color-brand); }

/* 实时识别出来的半截话：让人知道系统在听、听成了什么 */
.partial {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  background: #edf4fa;
  border: 2rpx solid #d7e5f0;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  line-height: 1.6;
}

/* 说完的整句落在这里，可以直接改 —— 语音识别不可能一次全对 */
.say { margin-top: 16rpx; min-height: 160rpx; }

/* 紧急那一行：整张卡是点击目标，戴手套也点得中 */
.urgency { display: flex; align-items: center; gap: 16rpx; }
.urgency--on {
  border-color: rgba(255, 77, 79, 0.5);
  background: rgba(255, 77, 79, 0.06);
}
.urgency__badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  font-weight: 600;
}
.urgency--on .urgency__badge {
  background: rgba(255, 77, 79, 0.14);
  color: var(--color-danger);
}
.urgency__body { flex: 1; }
.urgency__text { font-size: var(--font-lg); font-weight: 500; line-height: 1.5; }
.urgency--on .urgency__text { color: var(--color-danger); }
.urgency__hint {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--color-text-tertiary);
}
