page { background: #f1f6fb; }

.quick-page {
  min-height: 100vh;
  background: #f1f6fb;
  color: #172f49;
}

.quick-nav {
  color: #fff;
  background: #355f96;
}
.quick-nav__safe { height: calc(env(safe-area-inset-top) + 16rpx); }
/* 标题行：高度和顶边由页面按胶囊位置 inline 给（utils/custom-nav.ts），这里是拿不到时的默认值 */
.quick-nav__bar {
  position: relative;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 34rpx;
}
.quick-nav__center { flex: 1; min-width: 0; text-align: center; }
.quick-nav__title { font-size: 42rpx; font-weight: 600; line-height: 1.35; }
.quick-nav__subtitle { padding: 8rpx 34rpx 22rpx; text-align: center; color: rgba(255,255,255,.92); font-size: 31rpx; line-height: 1.45; }
.quick-nav__side {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}
/* 返回箭头点击区放大到 96×88rpx，负外边距保住箭头的视觉位置（同工单详情页） */
.quick-nav__back { width: 96rpx; height: 88rpx; margin-left: -20rpx; font-size: 54rpx; font-weight: 300; }
.quick-nav__help {
  width: 36rpx;
  height: 36rpx;
  margin: 0 16rpx;
  border: 3rpx solid rgba(255,255,255,.92);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
}

.quick-body { padding: 28rpx 26rpx calc(42rpx + env(safe-area-inset-bottom)); }

.voice-guide {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: #e5eff9;
}
.voice-guide__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #315f98;
}
.voice-guide__bubble {
  position: relative;
  width: 34rpx;
  height: 26rpx;
  border: 2rpx solid #fff;
  border-radius: 14rpx;
  color: #fff;
  font-size: 16rpx;
  line-height: 18rpx;
  text-align: center;
}
.voice-guide__body { flex: 1; min-width: 0; }
.voice-guide__title { color: #315f98; font-size: 35rpx; font-weight: 600; line-height: 1.45; }
.voice-guide__desc { margin-top: 5rpx; color: #526f8e; font-size: 29rpx; line-height: 1.55; }

.say-checklist {
  margin-top: 24rpx;
  padding: 30rpx 30rpx 22rpx;
  border: 2rpx solid #e0e8f0;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(39, 72, 108, .06);
}
.say-checklist__title { margin-bottom: 18rpx; color: #142e48; font-size: 35rpx; font-weight: 600; line-height: 1.4; }
.say-checklist__row { display: flex; align-items: center; gap: 20rpx; padding: 10rpx 0; }
.say-checklist__num {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #315f98;
  color: #fff;
  font-size: 31rpx;
  font-weight: 500;
}
.say-checklist__name { color: #17314d; font-size: 32rpx; font-weight: 500; line-height: 1.35; }
.say-checklist__desc { margin-top: 2rpx; color: #5c748f; font-size: 29rpx; line-height: 1.5; }

.voice-example {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 26rpx;
  background: #fff2e2;
}
.voice-example__head { display: flex; align-items: center; justify-content: space-between; color: #8f5219; font-size: 29rpx; }
.voice-example__play { min-height: 64rpx; display: flex; align-items: center; padding: 0 6rpx 0 20rpx; color: #315f98; font-size: 31rpx; font-weight: 500; }
.voice-example__speaker { margin-right: 8rpx; font-size: 21rpx; }
.voice-example__sentence { margin-top: 16rpx; color: #122e49; font-size: 35rpx; line-height: 1.75; }
.voice-example__sentence text { display: inline; padding: 2rpx 5rpx; }
.voice-example__location { background: #e4f1f9; }
.voice-example__fault { background: #e6f3ed; }
.voice-example__contact { background: #f2e5e9; }
.voice-example__legend { display: flex; gap: 24rpx; margin-top: 16rpx; }
.legend { position: relative; padding-left: 24rpx; color: #596f86; font-size: 28rpx; }
.legend::before { content: ""; position: absolute; left: 0; top: 8rpx; width: 12rpx; height: 12rpx; border-radius: 50%; }
.legend--location::before { background: #7aa7cd; }
.legend--fault::before { background: #62a88d; }
.legend--contact::before { background: #bb8b9b; }

.photo-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 106rpx;
  margin-top: 24rpx;
  padding: 12rpx 26rpx;
  border: 2rpx dashed #8eb1d1;
  border-radius: 22rpx;
  background: #fff;
}
.photo-entry__camera {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 22rpx;
  border: 3rpx solid #315f98;
  border-radius: 4rpx;
}
.photo-entry__camera::before { content: ""; position: absolute; left: 7rpx; top: 4rpx; width: 9rpx; height: 9rpx; border: 2rpx solid #315f98; border-radius: 50%; }
.photo-entry__camera::after { content: ""; position: absolute; left: 4rpx; top: -8rpx; width: 10rpx; height: 6rpx; border-radius: 3rpx 3rpx 0 0; background: #315f98; }
.photo-entry__body { flex: 1; min-width: 0; }
.photo-entry__title { color: #315f98; font-size: 34rpx; font-weight: 600; line-height: 1.4; }
.photo-entry__desc { margin-top: 3rpx; color: #60778f; font-size: 28rpx; line-height: 1.5; }
.photo-entry__arrow { color: #315f98; font-size: 42rpx; font-weight: 300; }
.quick-media { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 20rpx; padding: 22rpx; border-radius: 22rpx; background: #fff; }

.hold-area { padding: 0 40rpx; text-align: center; }
/* 和上面的拍照入口拉开距离（2026-09-04 反馈挨太近）；录音中这一行变成「正在听」 */
.hold-area__prompt { min-height: 46rpx; margin: 64rpx 0 20rpx; color: #315f98; font-size: 31rpx; font-weight: 500; line-height: 1.45; }
.hold-area__prompt--on { color: #b53d44; }
.prototype-hold {
  width: 100% !important;
  height: 116rpx;
  margin: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  border-radius: 28rpx;
  background: #355f96;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  box-shadow: 0 18rpx 38rpx rgba(49, 95, 152, .24);
}
.prototype-hold::after { border: none; }
/* 按住只变色，不缩放不位移：按钮一动人就以为没按住 */
.prototype-hold--on { background: #b53d44; }
.prototype-hold__mic {
  position: relative;
  width: 18rpx;
  height: 30rpx;
  border: 3rpx solid #fff;
  border-radius: 12rpx;
}
.prototype-hold__mic::before { content: ""; position: absolute; left: -9rpx; bottom: -9rpx; width: 30rpx; height: 22rpx; border: 3rpx solid #fff; border-top: 0; border-radius: 0 0 16rpx 16rpx; }
.prototype-hold__mic::after { content: ""; position: absolute; left: 6rpx; bottom: -15rpx; width: 3rpx; height: 9rpx; background: #fff; }
.hold-area__title { min-height: 50rpx; margin-top: 24rpx; color: #122c47; font-size: 35rpx; font-weight: 600; line-height: 1.45; }
/* 录音中这一行显示识别到的字，字数多就往下长，按钮在它上面不受影响 */
.hold-area__title--partial { color: #315f98; font-weight: 500; }
.hold-area__desc { margin-top: 6rpx; color: #60778f; font-size: 29rpx; line-height: 1.5; }
.speech-unavailable { padding: 26rpx; border-radius: 20rpx; background: #fff3e2; color: #8b5a16; font-size: 30rpx; line-height: 1.6; }

.form-link {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #315f98;
  font-size: 31rpx;
}
.form-link__icon { font-size: 25rpx; }

.listening-panel {
  margin-top: 24rpx;
  padding: 44rpx 30rpx;
  border-radius: 30rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(39, 72, 108, .08);
}
.listening-panel__pulse {
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(53,95,150,.12);
  animation: listening-pulse 1.25s ease-in-out infinite;
}
.listening-panel__mic { width: 68rpx; height: 68rpx; border-radius: 50%; background: #355f96; color: #fff; font-size: 28rpx; line-height: 68rpx; }
.listening-panel__title { margin-top: 24rpx; color: #183651; font-size: 36rpx; font-weight: 600; }
.listening-panel__partial { min-height: 72rpx; margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #eaf3fb; color: #315f98; font-size: 29rpx; line-height: 1.55; }
.listening-panel__hint { margin-top: 18rpx; color: #63798f; font-size: 29rpx; }
@keyframes listening-pulse { 0%,100% { transform: scale(.92); } 50% { transform: scale(1.08); } }

.review-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #b8d5c7;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(44, 92, 67, .07);
}
.review-card__head { display: flex; align-items: center; gap: 16rpx; padding-bottom: 20rpx; border-bottom: 2rpx solid #deebe4; }
.review-card__check { width: 58rpx; height: 58rpx; border-radius: 50%; background: #3d8561; color: #fff; font-size: 34rpx; line-height: 58rpx; text-align: center; }
.review-card__title { color: #245f44; font-size: 33rpx; font-weight: 600; }
.review-card__desc { margin-top: 3rpx; color: #5e7769; font-size: 28rpx; }
.review-card__raw { box-sizing: border-box; width: 100%; min-height: 120rpx; margin-top: 20rpx; padding: 18rpx 20rpx; border: 2rpx solid #d6e4dc; border-radius: 18rpx; background: #f7fbf8; color: #18314a; font-size: 33rpx; line-height: 1.65; }
.review-card__rows { margin-top: 18rpx; overflow: hidden; border: 2rpx solid #e0e9e4; border-radius: 18rpx; }
.review-row { display: grid; grid-template-columns: 150rpx 1fr; gap: 16rpx; padding: 18rpx 20rpx; border-bottom: 2rpx solid #edf2ef; }
.review-row:last-child { border-bottom: 0; }
.review-row__label { color: #647b91; font-size: 29rpx; }
.review-row__value { color: #1b354e; font-size: 31rpx; font-weight: 600; line-height: 1.55; }
.recognize-warning { margin-top: 18rpx; padding: 20rpx 22rpx; border-radius: 18rpx; background: #fff3e3; color: #885919; font-size: 29rpx; line-height: 1.65; }

.after-recognize { margin-top: 22rpx; }
.urgency-simple { padding: 24rpx; border: 2rpx solid #dbe5ee; border-radius: 24rpx; background: #fff; }
.urgency-simple__head { color: #203f5c; font-size: 30rpx; font-weight: 600; }
.prototype-hold--secondary { height: 94rpx; margin-top: 20rpx !important; border-radius: 22rpx; font-size: 30rpx; box-shadow: none; }
.review-actions { display: grid; grid-template-columns: 1fr 1.25fr; gap: 16rpx; margin-top: 20rpx; }
.review-actions .btn { min-height: 96rpx; padding: 0 18rpx; font-size: 33rpx; font-weight: 600; }

@media (prefers-reduced-motion: reduce) {
  .listening-panel__pulse { animation: none; }
}

/* 「?」弹说明；原 36rpx 太小，点不准 */
.quick-nav__help { width: 60rpx; height: 60rpx; font-size: 34rpx; }
