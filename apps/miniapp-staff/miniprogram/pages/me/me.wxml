<view class="container container--tabbar">
  <block wx:if="{{mode === 'more'}}">
    <view class="screen-head screen-head--help">
      <view class="screen-head__title">更多应用</view>
      <view wx:if="{{guide}}" class="screen-head__desc">常用功能会以图标放在这里，页面保持简单好找</view>
      <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
    </view>
    <view class="card more-panel">
      <view class="more-panel__title">维修知识</view>
      <view class="app-grid">
        <view class="app-tile {{experienceAccess.canView ? '' : 'app-tile--disabled'}}" bindtap="onOpenExperience">
          <view class="app-tile__icon"><view class="experience-glyph"></view></view>
          <view class="app-tile__name">维修经验总结</view>
          <view class="app-tile__desc">
            {{experienceAccess.canView ? '图文记录经验和注意事项' : '暂无授权的类别笔记本'}}
          </view>
          <view wx:if="{{experienceAccess.canView}}" class="app-tile__badge">
            {{experienceAccess.notebookCount}} 个笔记本
          </view>
        </view>
      </view>
    </view>
  </block>
  <block wx:else>
  <view class="screen-head screen-head--help">
    <view class="screen-head__title">我的工作台</view>
    <view wx:if="{{guide}}" class="screen-head__desc">管理提醒、报修入口、意见反馈和当前账号</view>
    <view class="head-help {{guide ? 'head-help--on' : ''}}" bindtap="onToggleGuide">?</view>
  </view>
  <!-- 身份先说清楚：不同角色能看到的功能不一样，别让人以为是「功能没了」 -->
  <view wx:if="{{user}}" class="card profile">
    <view class="profile__avatar">{{avatarText}}</view>
    <view class="profile__body">
      <view class="profile__name">{{user.name || '邻修员工'}}</view>
      <view class="profile__meta">{{roleText}}<text wx:if="{{phoneText}}"> · {{phoneText}}</text></view>
    </view>
  </view>

  <view class="card entries">
    <view wx:if="{{canUseMessages}}" class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onOpenMessages">
      <view class="entry-icon"><view class="entry-icon__glyph icon-menu--message"></view></view>
      <view class="entry__body">
        <view class="entry__title">
          消息<text wx:if="{{unread}}" class="entry__badge">{{unread}}</text>
        </view>
        <view wx:if="{{guide}}" class="entry__desc">派给你的工单、缺料进度都会在这里提醒</view>
      </view>
      <view class="entry__arrow"></view>
    </view>

    <!-- 微信的一次性订阅：同意一次才能推一条，所以要给一个能随时再点的入口。
         只有维修工需要 —— 工单是派给他的。
         状态文案在 me.ts 里算好（notifyStateText / notifyDesc）：三种状态各带一个条数，
         塞进 wxml 的三元表达式里没人看得懂，改一次要在两处对着数括号 -->
    <view wx:if="{{canSubscribe}}" class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onEnableNotify">
      <view class="entry-icon"><view class="entry-icon__glyph icon-menu--bell"></view></view>
      <view class="entry__body">
        <view class="entry__title">
          工单微信提醒
          <text class="entry__state entry__state--{{notifyTone}}">{{notifyStateText}}</text>
        </view>
        <view wx:if="{{guide}}" class="entry__desc">{{notifyDesc}}</view>
      </view>
      <view class="entry__arrow"></view>
    </view>

    <view class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onOpenFeedback">
      <view class="entry-icon"><view class="entry-icon__glyph icon-menu--feedback"></view></view>
      <view class="entry__body">
        <view class="entry__title">意见与建议</view>
        <view wx:if="{{guide}}" class="entry__desc">告诉我们哪里不好用，也可以提出新的功能想法</view>
      </view>
      <view class="entry__arrow"></view>
    </view>
  </view>

  <view wx:if="{{canReport || canSeeMyRepairs}}" class="card entries">
    <view wx:if="{{canReport}}" class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onGoRepair">
      <view class="entry-icon"><view class="entry-icon__glyph icon-menu--repair"></view></view>
      <view class="entry__body">
        <view class="entry__title">我要报修</view>
        <view wx:if="{{guide}}" class="entry__desc">{{repairDesc}}</view>
      </view>
      <view class="entry__arrow"></view>
    </view>

    <!-- 我报的单派给别人之后，在手和工单池里都看不到，只在「在手工单」页那个折叠区里。
         替住户报完修的人最想知道的就是「那单后来怎么样了」，得给一个找得到的入口 -->
    <view wx:if="{{canSeeMyRepairs}}" class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onOpenReported">
      <view class="entry-icon"><view class="entry-icon__glyph icon-menu--clipboard"></view></view>
      <view class="entry__body">
        <view class="entry__title">我的报修</view>
        <view wx:if="{{guide}}" class="entry__desc">我替住户和巡查提的单，派给谁了、修到哪一步了</view>
      </view>
      <view class="entry__arrow"></view>
    </view>
  </view>

  <view class="card entries">
    <view class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onFeedback">
      <view class="entry-icon"><view class="entry-icon__glyph icon-menu--message"></view></view>
      <view class="entry__body">
        <view class="entry__title">反馈异常</view>
        <view wx:if="{{guide}}" class="entry__desc">操作失败、数据不对或不好用，自动带上出错页面和最近错误</view>
      </view>
      <view class="entry__arrow"></view>
    </view>
  </view>

  <!-- 「材料与库存」不再放这里：底部 tabBar 已经有那一格，而且两处是同一个权限
       （app:inventory · 可见），看得到入口的人底部一定也有，重复放只是让这一屏更长 -->

  <view class="card">
    <view class="card__title">账号说明</view>
    <view wx:if="{{guide}}" class="card__desc">账号由物业管理员开通，一个微信只能绑一个员工账号。</view>
    <view wx:if="{{guide}}" class="card__desc mt-sm">要换一个手机号登录：先在下面退出，再用另一个手机号登录。如果提示「该微信已绑定员工 X」，说明这个微信还挂在原来那个账号上，请管理员在后台「用户管理」里给它解绑后再登。</view>
  </view>

  <button class="btn btn--ghost" bindtap="onLogout">
    <view class="btn__icon icon-action--logout-gray"></view>
    <text>退出登录</text>
  </button>

  <view class="build-info">{{buildText}}</view>
  </block>
</view>
