<view class="container container--tabbar">
  <!-- 身份先说清楚：不同角色能看到的功能不一样，别让人以为是「功能没了」 -->
  <view wx:if="{{user}}" class="card profile">
    <view class="profile__avatar">{{avatarText}}</view>
    <view class="profile__body">
      <view class="profile__name">{{user.name || '邻修员工'}}</view>
      <view class="profile__meta">{{roleText}}<text wx:if="{{phoneText}}"> · {{phoneText}}</text></view>
    </view>
  </view>

  <view class="card entries">
    <view class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onOpenMessages">
      <view class="entry__body">
        <view class="entry__title">
          消息<text wx:if="{{unread}}" class="entry__badge">{{unread}}</text>
        </view>
        <view class="entry__desc">派给你的工单、缺料进度都会在这里提醒</view>
      </view>
      <view class="entry__arrow"></view>
    </view>

    <!-- 微信的一次性订阅：同意一次才能推一条，所以要给一个能随时再点的入口。
         只有维修工需要 —— 工单是派给他的 -->
    <view wx:if="{{canSubscribe}}" class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onEnableNotify">
      <view class="entry__body">
        <view class="entry__title">
          新工单微信提醒
          <text class="entry__state {{notifyAlways ? 'entry__state--on' : ''}}">{{notifyAlways ? '已开启' : '未开启'}}</text>
        </view>
        <view class="entry__desc">
          {{notifyAlways ? '每次派单微信都会提醒你，不用再点允许' : '点这里开启；弹窗里记得勾上「总是保持以上选择」'}}
        </view>
      </view>
      <view class="entry__arrow"></view>
    </view>
  </view>

  <view class="card entries">
    <view class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onGoRepair">
      <view class="entry__body">
        <view class="entry__title">我要报修</view>
        <view class="entry__desc">{{repairDesc}}</view>
      </view>
      <view class="entry__arrow"></view>
    </view>
  </view>

  <!-- 维修工没有材料/库存权限，这块整段不显示。
       办公室一侧底部已经有「材料与库存」那一格，这里留着是给「从我的页进去」的习惯 -->
  <view wx:if="{{canUseMaterials || canUseInventory}}" class="card entries">
    <view class="entry" hover-class="entry--hover" hover-stay-time="80" bindtap="onOpenInventory">
      <view class="entry__body">
        <view class="entry__title">材料与库存</view>
        <view class="entry__desc">看还有几个、补 SKU 资料和照片、采购申请进度</view>
      </view>
      <view class="entry__arrow"></view>
    </view>
  </view>

  <view class="card">
    <view class="card__title">账号说明</view>
    <view class="card__desc">账号由物业管理员开通。换手机或换微信后无法登录时，请联系管理员在后台「解绑微信」。</view>
  </view>

  <button class="btn btn--ghost" bindtap="onLogout">退出登录</button>

  <view class="build-info">{{buildText}}</view>
</view>
