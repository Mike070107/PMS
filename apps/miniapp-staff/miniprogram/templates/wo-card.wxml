<!--
  工单卡片的正文（头部两行 + 数据网格 + 缺料说明），工单池 / 派单台 / 在手工单 / 我报的 /
  已完结**共用这一份**。以前是各页面各抄一遍，改一次要改四处，漏一处就长得不一样。

  卡片外壳（.card.wo-card.wo-card--data、点击、hover）和底部那行动作按钮留在各页面：
  外壳上的 wx:for/data-id 每页不同，动作更是每页都不一样（接单 / 派单 / 去完工 / 看进度）。

  用法：
    <import src="/templates/wo-card.wxml"/>
    <template is="wo-card-body" data="{{item, thirdLabel: '报修人', thirdValue: item.statReporter, thirdHint: item.statReporterHint}}"/>

  第三格由调用方给（thirdLabel/thirdValue/thirdHint）：维修工要看「找谁开门」，
  派单台要看「在谁手上」，报单的人要看「派给谁了」—— 同一格三种含义，不能写死。
  样式在 app.wxss 的 .wo-card--data 一节。
-->
<template name="wo-card-body">
  <view class="wo-card__head">
    <view class="wo-card__main">
      <!-- 第一行报修内容、第二行地址，两行都加粗，各占一行超出省略（2026-09-01 定的）。

           「紧急」标挂在第一行行首，不放地址那一行：它占掉近 90rpx，
           地址会被截成「枫桦景苑一期17号20…」——室号看不全，跟没写一样。
           地址整行只留给它自己。 -->
      <view class="wo-card__title">
        <text wx:if="{{item.urgent}}" class="badge--urgent">紧急</text>{{item.summaryContent || '未填描述'}}
      </view>
      <view class="wo-card__addr-line">
        <view class="icon icon--pin"></view>
        <view class="wo-card__addr">{{item.summaryAddress || '未填地址'}}</view>
      </view>
      <!-- 报修照片：一眼看出坏成什么样，比读一句描述快得多。
           catchtap 拦住冒泡 —— 点图是看大图，点卡片才是进详情。
           超过 4 张时最后一张压一个「+N」，别把卡片撑成相册 -->
      <view wx:if="{{item.photos.length}}" class="wo-card__shots">
        <view
          wx:for="{{item.photos}}"
          wx:for-item="shot"
          wx:key="*this"
          class="wo-card__shot"
          data-url="{{shot}}"
          data-urls="{{item.photos}}"
          catchtap="onPreviewShot"
        >
          <image class="wo-card__shot-img" src="{{shot}}" mode="aspectFill" lazy-load />
          <view wx:if="{{index === 3 && item.photoCount > 4}}" class="wo-card__shot-more">
            +{{item.photoCount - 4}}
          </view>
        </view>
      </view>
    </view>
    <pms-tag class="status-tag" status="{{item.status}}"/>
  </view>

  <view class="wo-card__chips">
    <text class="wo-card__chip wo-card__chip--{{item.stayTone}}">{{item.statStayLabel}} {{item.statStay}}</text>
    <text class="wo-card__chip">{{item.typeLabel}}</text>
  </view>

  <view class="wo-card__info">
    <view class="wo-card__info-main">
      <view class="wo-card__info-label">{{thirdLabel}}</view>
      <view class="wo-card__info-value">{{thirdValue}}<text wx:if="{{thirdHint}}" class="wo-card__info-hint">{{thirdHint}}</text></view>
    </view>
    <view class="wo-card__time">{{item.timeText}}</view>
  </view>

  <!-- 缺料清单塞不进网格，放正文：状态标签只说「在等料」，等的是什么得写出来才有用 -->
  <view wx:if="{{item.missingText}}" class="wo-card__note">等待材料：{{item.missingText}}</view>
</template>
