<view wx:if="{{!hideTrigger}}" class="field {{compact ? 'field--compact' : ''}}" bindtap="onOpen">
  <view wx:if="{{!compact}}" class="label">报修位置</view>
  <view class="picker {{compact ? 'picker--compact' : ''}} {{valueText ? '' : 'placeholder'}}">
    {{valueText || (loading ? '正在加载地址…' : '点这里选小区 / 楼栋 / 房号')}}
  </view>
  <view wx:if="{{!compact}}" class="muted mt-sm">楼道、电梯、大门这类公共区域，选到那一级就行，不用选房号。</view>
</view>

<!-- 选择面板：手机上放不下级联面板，改成逐层钻取 -->
<view wx:if="{{open}}" class="mask" catchtap="onClose" catchtouchmove="onBlockMove"></view>
<view wx:if="{{open}}" class="panel" catchtouchmove="onBlockMove">
  <view class="panel__head">
    <view class="panel__back {{level === 'community' ? 'panel__back--off' : ''}}" catchtap="onBack">
      {{level === 'community' ? '' : '返回上一级'}}
    </view>
    <view class="panel__title">选报修位置</view>
    <view class="panel__close" catchtap="onClose">关闭</view>
  </view>

  <!-- 面包屑：当前钻到哪一层 -->
  <view wx:if="{{communityName}}" class="crumb">
    {{communityName}}{{buildingText ? ' · ' + buildingText : ''}}
  </view>

  <!-- 快速查询：输 228/4/201 直接出完整地址，和后台同一套匹配 -->
  <view class="search">
    <input
      class="search__input"
      placeholder="快速查询：输入 228/4/201"
      value="{{keyword}}"
      bindinput="onKeyword"
    />
  </view>
  <scroll-view wx:if="{{suggestions.length}}" class="suggest" scroll-y>
    <view
      wx:for="{{suggestions}}"
      wx:key="key"
      class="suggest__item"
      data-index="{{index}}"
      catchtap="onPickSuggestion"
    >{{item.text}}</view>
  </scroll-view>

  <!-- 公区、当前级入口和楼栋/房号共用一个外层滚动区，不固定占住楼栋空间。 -->
  <scroll-view wx:if="{{!suggestions.length}}" class="list" scroll-y scroll-into-view="place-list-{{level}}">
    <view id="place-list-{{level}}" class="list__content">
    <view wx:if="{{spotRows.length}}" class="spot-section">
      <button class="spot-section__toggle" catchtap="onToggleSpots" aria-label="{{spotsExpanded ? '收起公共区域点位' : '展开公共区域点位'}}">
        <text class="spot-section__title">公共区域（{{spotRows.length}}）</text>
        <text class="spot-section__action">{{spotsExpanded ? '收起' : '展开'}}</text>
      </button>
      <!-- 普通 view 的 overflow 无法可靠承接小程序触摸滚动，使用定高原生 scroll-view。 -->
      <scroll-view wx:if="{{spotsExpanded}}" class="spot-list" scroll-y enhanced bounces="{{false}}" style="height: {{spotRows.length < 3 ? spotRows.length * 112 : 336}}rpx;">
        <view
          wx:for="{{spotRows}}"
          wx:key="key"
          class="spot-row"
          data-index="{{index}}"
          catchtap="onPickSpotRow"
        >
          <view class="spot-row__pin"></view>
          <text class="spot-row__label">{{item.label}}</text>
          <text class="spot-row__note">{{item.note}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- 停在当前这一级 = 公共区域单 -->
    <view wx:if="{{stayLabel}}" class="stay-here" catchtap="onStayHere">
      <text class="stay-here__main">{{stayLabel}}</text>
      <text class="stay-here__sub">楼道、电梯、大门、路灯等公共设施选这个</text>
    </view>

    <view wx:if="{{level === 'house'}}" class="skip-room" catchtap="onSkipRoom">
      不填房号（只报到这栋楼）
    </view>

      <view
        wx:for="{{rows}}"
        wx:key="key"
        class="list__item"
        data-index="{{index}}"
        catchtap="onPickRow"
      >
        <text class="list__label">{{item.label}}</text>
        <text wx:if="{{item.note}}" class="list__note">{{item.note}}</text>
        <view wx:if="{{level !== 'house'}}" class="icon icon--chevron"></view>
      </view>
      <view wx:if="{{!rows.length}}" class="list__empty">这一级还没有数据</view>
    </view>
  </scroll-view>
</view>
