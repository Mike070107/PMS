# ===== App =====
PORT=4000
NODE_ENV=development
TZ=Asia/Shanghai
API_GLOBAL_PREFIX=api/v1
# API 的公网入口（带协议、不带尾斜杠）。附件走 GET /upload/file?key= 代理读私有桶，
# 小程序 <image> 只认绝对地址，这里不配小程序里的照片会全部显示不出来。
APP_PUBLIC_BASE_URL=https://prsznh.cn

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pms_repair
DB_USER=pms
DB_PASS=pms@db123
# dev 用 synchronize 自动建表；生产暂时也 true，首版 migration 出来后切 false
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ===== Object Storage =====
# Prod: 腾讯云 COS（桶: property-repair-2026-1259497259 / ap-shanghai）
# Dev:  本地不用对象存储 / 或 docker-compose.dev.yml 起 MinIO 时用 MINIO_* 兼容变量
COS_REGION=ap-shanghai
COS_BUCKET=property-repair-2026-1259497259
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE_URL=https://property-repair-2026-1259497259.cos.ap-shanghai.myqcloud.com

# ===== JWT =====
JWT_SECRET=change-me-in-prod
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ===== Bootstrap =====
# 一次性引导首个 superadmin 用，POST /auth/bootstrap-admin 校验该 token。
# 创建完首个账号后请立即清空此值（设为空串即可禁用接口）。
BOOTSTRAP_TOKEN=


# 业主端
WX_OWNER_APPID=
WX_OWNER_SECRET=
# 员工端
WX_STAFF_APPID=
WX_STAFF_SECRET=

# ===== 楼栋报修码（小程序码 wxacode.getUnlimited）=====
# 扫码落地页。必须是业主端小程序里真实存在的页面，不带参数、不带前导斜杠。
# 该页会自行判断入驻状态：已入驻直接报修，未入驻转到入驻页并预填小区/弄/号。
WX_OWNER_QR_PAGE=pages/repair-create/repair-create
# 生成哪个版本的小程序码：release（正式版，要求小程序已发布）/ trial（体验版）/ develop（开发版）。
# 小程序还没提审发布时先用 trial 验证流程，正式贴码前务必切回 release 并「全部重新生成」。
WX_OWNER_QR_ENV_VERSION=release
