# ===== App =====
PORT=4000
NODE_ENV=production
TZ=Asia/Shanghai
API_GLOBAL_PREFIX=api/v1
# API 公网入口：附件经 /upload/file?key= 代理读私有桶，小程序 <image> 只认绝对地址
APP_PUBLIC_BASE_URL=https://prsznh.cn

# ===== PostgreSQL =====
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=pms_repair
DB_USER=pms
DB_PASS=<same-as-docker/.env POSTGRES_PASSWORD>
# 生产先用 synchronize 把 28 张表建出来，跑通后切 false 走 migration
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=<same-as-docker/.env REDIS_PASSWORD>

# ===== Object Storage (Tencent Cloud COS) =====
# 桶: property-repair-2026-1259497259, 区域: ap-shanghai
# AK/SK 从腾讯云 CAM 子账号生成（赋予该桶的读写权限即可，不要用主账号 root key）
COS_REGION=ap-shanghai
COS_BUCKET=property-repair-2026-1259497259
COS_SECRET_ID=<change-me-from-CAM>
COS_SECRET_KEY=<change-me-from-CAM>
# 公网下载基础 URL（COS 自带域名，无需备案；备案后可挂自有域名 + CDN）
COS_PUBLIC_BASE_URL=https://property-repair-2026-1259497259.cos.ap-shanghai.myqcloud.com

# ===== JWT =====
JWT_SECRET=<change-me-64-char-random>
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ===== Bootstrap =====
# 引导首个 superadmin。流程：
#   1) 部署后临时设为非空值（例：openssl rand -hex 16），pm2 reload --update-env
#   2) curl -X POST /api/v1/auth/bootstrap-admin 创建首个 admin
#   3) 清空此值 → pm2 reload --update-env （接口立刻禁用）
BOOTSTRAP_TOKEN=

# ===== WeChat Mini Programs（先空着，小程序代申请下来再填） =====
WX_OWNER_APPID=
WX_OWNER_SECRET=
WX_STAFF_APPID=
WX_STAFF_SECRET=
# 微信审核共用账号：只免除微信绑定，仍校验密码、员工端角色和启用状态；多个账号用逗号分隔。
MINIAPP_REVIEW_ACCOUNTS=testadmin

# ===== 后台网页的微信扫码登录（小程序码 wxacode.getUnlimited，走员工端凭据）=====
# 生成哪个版本的小程序码：release（正式版，要求员工端小程序已发布）/ trial（体验版）。
#
# 员工端还没发布正式版时用 trial，且必须先在公众平台把上传的开发版本
# 「选为体验版」—— 不然扫开是旧包，新页面不存在。
#
# **不要用 develop**：它指的是开发者工具当前编译的那个版本，不是 CLI 上传的
# 「开发版本」，工具一关就失效，手机上扫出来是「开发版小程序已过期」。
# （2026-08-25 实际踩过。）
WX_STAFF_QR_ENV_VERSION=trial
