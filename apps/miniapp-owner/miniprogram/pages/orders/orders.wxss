/* ---------- 分组标签（吸顶） ---------- */
.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-md);
  background: var(--color-bg);
}
.tab {
  flex: 1;
  min-height: var(--tap-min);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  border-radius: 999rpx;
  background: var(--color-card-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-md);
  transition: background-color var(--dur) ease, color var(--dur) ease;
}
.tab--on {
  background: var(--color-brand);
  color: #fff;
  font-weight: 600;
}
.tab:active { opacity: 0.7; }
/* 条数用等宽数字，四个标签的宽度不会随数字跳动 */
.tab__count { font-variant-numeric: tabular-nums; opacity: 0.85; }

/* 吸顶条已经带了上边距，容器不要再顶一次 */
.container--with-tabs { padding-top: 0; }

/* ---------- 工单卡片 ---------- */
.order { transition: opacity var(--dur) ease; }
.order:active { opacity: 0.75; }

.order__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  /* 标题和状态之间留够一档：贴太近扫一眼容易连成一句话 */
  gap: var(--space-lg);
}
.order__type {
  /* 类型名不截断：宽度让出来给状态标签，放不下就换行。
     「家里门锁/门窗相关」这种长名字截成「家里门锁/门窗…」反而看不出是什么。
     head 用 flex-start 对齐，标题换成两行时标签仍稳在右上角。 */
  flex: 1;
  min-width: 0;
  /* 封一个上限：不让类型名一路顶到状态标签跟前，宁可早一点换行 */
  max-width: 58%;
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1.35;
}



/* 停留天数：和员工端工单池同一套配色口径，≥2 天橙、≥3 天红 */


/* ---------- 空状态 ---------- */
.empty-wrap { padding-top: 96rpx; }
.empty-wrap .btn { margin-top: var(--space-lg); }
