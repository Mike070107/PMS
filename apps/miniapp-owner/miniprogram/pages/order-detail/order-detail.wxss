.order-no { color: var(--color-text-tertiary); font-size: var(--font-sm); }
.title { font-size: var(--font-2xl); font-weight: 600; margin-top: var(--space-xs); line-height: 1.4; }
.desc { color: var(--color-text-secondary); margin-top: 8rpx; line-height: 1.6; }
.meta { color: var(--color-text-tertiary); font-size: var(--font-sm); margin-top: var(--space-sm); }
.section-title { font-size: var(--font-xl); font-weight: 600; margin-bottom: var(--space-md); }
.mt { margin-top: 32rpx; }

.thumbs { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.thumb { width: 160rpx; height: 160rpx; border-radius: var(--radius-sm); background: var(--color-bg); }

.timeline-item { display: flex; gap: var(--space-sm); margin-bottom: var(--space-lg); }
.timeline-item:last-child { margin-bottom: 0; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--color-brand); margin-top: 12rpx; flex-shrink: 0; }
.timeline-body { flex: 1; }
.timeline-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.timeline-label { font-size: var(--font-xl); font-weight: 600; }
/* 时间用等宽数字，几行叠在一起时对得齐 */
.timeline-at {
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}
.timeline-note {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}
.timeline-photos { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.timeline-photo { width: 132rpx; height: 132rpx; border-radius: 12rpx; background: var(--color-bg); }

.stars { font-size: 56rpx; color: #d9d9d9; letter-spacing: 8rpx; }
.stars .on { color: var(--color-warning); }
/* 业主端这个框上面紧挨着标签，补一点间距；其余外观走 tokens.wxss */
textarea { min-height: 160rpx; margin-top: 16rpx; }

/* 每个节点停了多久：卡在哪一步、卡了多久，比绝对时间更好用 */
.timeline-stay {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}
