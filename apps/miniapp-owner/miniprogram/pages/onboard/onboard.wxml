<view class="container">
  <view class="card">
    <view class="place-row">
      <view class="place-info">
        <view class="label">我的小区 / 楼栋</view>
        <view class="place">{{placeText || '选择小区或扫电梯里的二维码自动带出信息'}}</view>
      </view>
      <button class="btn btn--outline btn--sm" bindtap="onTapScan">{{placeText ? '重新扫码' : '扫码'}}</button>
    </view>

    <!-- 没有码也能用：自己选小区。这一块任何情况下都要在，不能因为拉不到就消失 -->
    <view class="field mt">
      <view class="label">选择小区</view>

      <picker
        wx:if="{{communityNames.length}}"
        mode="selector"
        range="{{communityNames}}"
        value="{{communityIndex}}"
        bindchange="onPickCommunity"
      >
        <view class="picker {{communityIndex < 0 ? 'placeholder' : ''}}">
          {{communityIndex < 0 ? '点这里选小区' : communityNames[communityIndex]}}
        </view>
      </picker>

      <view wx:elif="{{communityLoading}}" class="picker placeholder">小区列表加载中…</view>

      <view wx:else class="picker placeholder" bindtap="onRetryCommunities">
        {{communityError || '小区列表加载失败'}}，点这里重试
      </view>
    </view>

    <view class="prefill-hint" wx:if="{{prefillHint}}">{{prefillHint}}</view>
    <view class="field-error" wx:if="{{errors.place}}">{{errors.place}}</view>
  </view>

  <!-- 弄由所选小区决定，这里只问几号楼 -->
  <view class="card" wx:if="{{communityId}}">
    <view class="field">
      <view class="label">几号楼</view>
      <view class="no-row">
        <input
          class="input no-input"
          type="text"
          placeholder="如 3"
          value="{{buildingNo}}"
          bindinput="onInputBuildingNo"
        />
        <view class="unit">号楼</view>
      </view>
      <view class="field-error" wx:if="{{errors.building}}">{{errors.building}}</view>
      <view class="hint" wx:elif="{{fromScan}}">已按二维码填好，扫错了可以直接改</view>
      <view class="hint" wx:elif="{{laneHint}}">{{laneHint}}</view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">房号</view>
      <input class="input" placeholder="如 101" value="{{roomNo}}" bindinput="onInputRoom"/>
      <view class="field-error" wx:if="{{errors.room}}">{{errors.room}}</view>
    </view>

    <view class="field">
      <view class="label">业主姓名</view>
      <input class="input" placeholder="与房产登记一致，方便物业核对" value="{{realName}}" bindinput="onInputName"/>
      <view class="field-error" wx:if="{{errors.name}}">{{errors.name}}</view>
    </view>

    <view class="field">
      <view class="label">手机号</view>
      <button
        wx:if="{{!phoneCode}}"
        class="btn btn--outline"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
      >使用微信手机号</button>
      <view wx:else class="ok">微信手机号已授权</view>
      <input
        wx:if="{{!phoneCode}}"
        class="input phone-input"
        type="number"
        placeholder="也可手动填写"
        value="{{phone}}"
        bindinput="onInputPhone"
      />
      <view class="field-error" wx:if="{{errors.phone}}">{{errors.phone}}</view>
    </view>
  </view>

  <button class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">提交审核</button>
  <view class="tip">提交后由物业核对房号，审核通过即可报修</view>
</view>
