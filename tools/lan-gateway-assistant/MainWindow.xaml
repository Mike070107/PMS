<Window x:Class="Pms.LanGatewayAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pms.LanGatewayAssistant"
        Title="PMS 内网应用连接助手" Icon="Resources/AppIcon.ico" Width="1000" Height="780" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Microsoft YaHei UI">
  <!--
    客户端只负责「接通」，不做任何管理：应用的新增、修改、删除，以及撤下这台电脑，全在 PMS 网页上做。
    所以界面只有两种状态：未配对 → 一个大大的配对框；已配对 → 状态节点 + 只读的应用卡片。
  -->
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E7EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E1E7EE" BorderThickness="0,0,0,1">
      <Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="12" Background="#2D4E73" VerticalAlignment="Center">
          <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,7 L12,3 L20,7 L20,17 L12,21 L4,17 Z M8,9 L8,15 M12,7 L12,17 M16,9 L16,15"/></Canvas></Viewbox>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"><TextBlock Text="PMS 内网应用连接助手" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><Border Background="#EDF2F8" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding VersionDisplay}" FontSize="12" Foreground="#2D4E73" FontWeight="SemiBold"/></Border></StackPanel>
          <TextBlock Text="{Binding ComputerDisplay}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" CornerRadius="16" Padding="12,6" Margin="0,0,14,0" VerticalAlignment="Center" Background="{Binding HeaderBackground}"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding HeaderStatus}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="14"/></StackPanel></Border>
        <Button x:Name="UpdateButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="检查更新" Height="38" MinHeight="38" FontSize="14" Click="CheckUpdate_Click"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="30,24,30,30">

        <!-- 被网页删除后的提示 -->
        <Border Padding="18,14" CornerRadius="12" Background="#FFF6E8" BorderBrush="#F1D3A2" BorderThickness="1" Margin="0,0,0,16" Visibility="{Binding RemovedVisibility}">
          <StackPanel><TextBlock Text="这台电脑已在 PMS 网页上移除" FontSize="16" FontWeight="SemiBold" Foreground="#8A5300"/>
            <TextBlock Text="{Binding RemovedNotice}" FontSize="14" Foreground="#8A5300" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock Text="转发已全部停止、配对凭据已清除。如果还要用这台电脑，请在 PMS「内网应用 → 新增内网客户端」生成新密钥，在下面重新配对。" FontSize="14" Foreground="#8A6A3A" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>

        <!-- 未配对：只有一件事 -->
        <Border Style="{StaticResource Card}" Padding="30,26" Visibility="{Binding EnrollmentVisibility}">
          <StackPanel>
            <TextBlock Text="把这台电脑接入 PMS" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
            <TextBlock Text="接入后，PMS 上发布到这台电脑的内网应用会自动同步过来，员工在外网微信扫码即可访问。" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,20"/>
            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="#F5F8FB" CornerRadius="12" Padding="14"><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#2D4E73" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="在 PMS 网页打开「内网应用」，点「新增内网客户端」" FontSize="14" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Background="#F5F8FB" CornerRadius="12" Padding="14"><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#2D4E73" HorizontalAlignment="Left"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="把网页上显示的配对密钥填到下面（10 分钟内有效，只能用一次）" FontSize="14" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Grid.Column="4" Background="#F5F8FB" CornerRadius="12" Padding="14"><StackPanel><Border Width="28" Height="28" CornerRadius="14" Background="#2D4E73" HorizontalAlignment="Left"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="点「连接」，Windows 询问时点「是」。网页上会自动显示已连上" FontSize="14" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="配对密钥" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/><TextBox x:Name="InstallCodeBox" Height="50" FontFamily="Consolas" FontSize="22" MaxLength="19" CharacterCasing="Upper" ToolTip="例如 ABCD-EFGH-JKLM-2345"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="客户端名称（写安装位置，如「财务室电脑」）" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/><TextBox x:Name="ClientNameBox" Height="50" FontSize="15" MaxLength="120" Text="{Binding SuggestedClientName, Mode=OneTime}"/></StackPanel>
              <Button x:Name="EnrollButton" Grid.Column="4" Content="连接" Click="Enroll_Click" MinWidth="130" Height="50" FontSize="16" VerticalAlignment="Bottom" Background="#2D4E73"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 已配对：结论 + 节点 -->
        <Border Style="{StaticResource Card}" Padding="26,22" Visibility="{Binding ManagedVisibility}">
          <StackPanel>
            <TextBlock Text="{Binding OverviewTitle}" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StabilitySummary}" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <ItemsControl ItemsSource="{Binding Nodes}" Margin="0,18,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:StatusNode}">
                <Border Margin="0,0,12,0" Padding="14,12" CornerRadius="12" Background="{Binding Background}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" VerticalAlignment="Center"><Ellipse Fill="{Binding Accent}"/><TextBlock Text="{Binding Glyph}" Foreground="White" FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" Foreground="#5D6F83"/><TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Accent}" TextTrimming="CharacterEllipsis"/></StackPanel>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{Binding ServiceActionText}" Click="RestartService_Click" HorizontalAlignment="Left" Margin="0,16,0,0" FontSize="14" Visibility="{Binding ServiceActionVisibility}"/>
          </StackPanel>
        </Border>

        <!-- 应用：只读 -->
        <StackPanel Margin="2,26,0,12" Visibility="{Binding RoutesSectionVisibility}">
          <TextBlock Text="这台电脑负责的内网应用" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="新增、修改、停用、删除都在 PMS 网页「内网应用」里操作，本机自动同步；后台服务每 5 秒从本机访问一次内网地址，下面就是检测结果。" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Routes}" Visibility="{Binding RoutesSectionVisibility}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:RouteViewModel}"><Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="18"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="42" Height="42" CornerRadius="12" Background="#E8F6F2" VerticalAlignment="Top"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Stroke="#168263" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,8 C4,5.8 5.8,4 8,4 L16,4 C18.2,4 20,5.8 20,8 L20,16 C20,18.2 18.2,20 16,20 L8,20 C5.8,20 4,18.2 4,16 Z M8,12 L16,12 M12,8 L12,16"/></Canvas></Viewbox></Border>
              <StackPanel Grid.Column="1" Margin="12,0,8,0"><TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding PublicHostname}" Foreground="#2D4E73" FontSize="14" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
              <Border Grid.Column="2" CornerRadius="11" Background="{Binding StatusBackground}" Padding="10,4" VerticalAlignment="Top"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="13" FontWeight="SemiBold"/></Border>
            </Grid>
            <Border Background="#F6F8FB" CornerRadius="10" Padding="12,10" Margin="0,14,0,0"><StackPanel>
              <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailForeground}" FontSize="14" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding AvailabilitySummary}" Foreground="#6C8099" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding FailureSummary}" Visibility="{Binding FailureVisibility}" Foreground="#8A97A6" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel></Border>
            <TextBlock Foreground="#7D8C9C" FontSize="13" Margin="2,10,0,0" TextWrapping="Wrap"><Run Text="内网 "/><Run Text="{Binding LocalUrl, Mode=OneWay}"/></TextBlock>
            <WrapPanel Margin="0,12,0,0">
              <Button Style="{StaticResource SecondaryButton}" Content="测试连接" Tag="{Binding Id}" Click="TestRoute_Click" MinHeight="36" Height="36" FontSize="14" Padding="14,0" Margin="0,0,8,0"/>
              <Button Style="{StaticResource SecondaryButton}" Content="打开网站" Tag="{Binding Id}" Click="OpenSite_Click" MinHeight="36" Height="36" FontSize="14" Padding="14,0"/>
            </WrapPanel>
          </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="EmptyPanel" Padding="26" Background="White" BorderBrush="#E1E7EE" BorderThickness="1" CornerRadius="14" Visibility="{Binding NoRoutesVisibility}">
          <TextBlock Text="PMS 还没有把内网应用发布到这台电脑。在网页「内网应用 → 新增应用」里选这台客户端，几秒后会出现在这里。" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
        </Border>

        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Expander Header="运行记录" FontSize="14" Background="White" BorderBrush="#E1E7EE" BorderThickness="1" Padding="16,10"><StackPanel Margin="8"><TextBlock Text="{Binding HealthMessage}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding LogPreview}" Foreground="{StaticResource Muted}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Style="{StaticResource SecondaryButton}" Content="打开日志文件夹" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenLogs_Click"/></StackPanel></Expander>
          <Expander Grid.Column="2" Header="后台服务维护" FontSize="14" Background="White" BorderBrush="#E1E7EE" BorderThickness="1" Padding="16,10"><StackPanel Margin="8"><TextBlock Text="关掉窗口后后台服务继续运行，电脑重启也会自动启动。要停用或撤下这台电脑，在 PMS 网页上停用或删除这个客户端即可，本机会自动断开并清除配对。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><WrapPanel Margin="0,14,0,0"><Button Content="安装 / 修复后台服务" Click="InstallService_Click" Margin="0,0,8,8"/><Button Style="{StaticResource SecondaryButton}" Content="重启代理" Click="RestartService_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel></Expander>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
