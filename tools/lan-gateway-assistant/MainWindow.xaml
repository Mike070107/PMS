<Window x:Class="Pms.LanGatewayAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pms.LanGatewayAssistant"
        Title="PMS 内网代理助手" Width="1040" Height="780" MinWidth="880" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#EEF3F8" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE5EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#D6E1EC" BorderThickness="0,0,0,1">
      <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource PrimaryStrong}" VerticalAlignment="Center">
          <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,7 L12,3 L20,7 L20,17 L12,21 L4,17 Z M8,9 L8,15 M12,7 L12,17 M16,9 L16,15"/></Canvas></Viewbox>
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="PMS 内网代理助手" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><Border Background="#EAF1F9" CornerRadius="9" Padding="7,2" Margin="9,0,0,0"><TextBlock Text="{Binding VersionDisplay}" FontSize="10" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/></Border></StackPanel><TextBlock Text="{Binding ComputerDisplay}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0"><Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding HeaderStatus}" Foreground="#405A73" FontWeight="SemiBold" FontSize="12"/></StackPanel>
        <Button x:Name="UpdateButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="检查更新" Height="36" MinHeight="36" Click="CheckUpdate_Click"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="30,24,30,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border CornerRadius="16" Padding="26" Background="{StaticResource PrimaryStrong}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="500"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="安全连接概览" Foreground="#BDD0E6" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding OverviewTitle}" Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock Text="窗口关闭后后台服务继续运行，所有业务通过 WSS 443 主动连接。" Foreground="#D5E1EF" FontSize="12"/></StackPanel>
            <Border Grid.Column="1" CornerRadius="12" Background="#22FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="12,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding ServiceState}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Windows 服务" Foreground="#C4D4E6" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="{Binding TunnelState}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="加密隧道" Foreground="#C4D4E6" FontSize="10"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="{Binding RouteCount}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="内网应用" Foreground="#C4D4E6" FontSize="10"/></StackPanel></Grid></Border>
          </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,0">
          <StackPanel><Grid Margin="22,18,22,15"><StackPanel><TextBlock Text="本机内网应用" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="这里管理本机隧道路由；公网发布、域名和授权名单由 PMS 管理。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button HorizontalAlignment="Right" Content="＋  添加内网应用" Click="AddRoute_Click"/></Grid>
            <Border BorderBrush="#E2E9F1" BorderThickness="0,1,0,0"/>
            <ItemsControl ItemsSource="{Binding Routes}" Margin="18,16,6,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:RouteViewModel}"><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16" MinHeight="146"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="11" Background="#E7F4F0" VerticalAlignment="Top"><Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Stroke="#168263" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,8 C4,5.8 5.8,4 8,4 L16,4 C18.2,4 20,5.8 20,8 L20,16 C20,18.2 18.2,20 16,20 L8,20 C5.8,20 4,18.2 4,16 Z M8,12 L16,12 M12,8 L12,16"/></Canvas></Viewbox></Border>
                <StackPanel Grid.Column="1" Margin="11,0,10,0"><TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding PublicHostname}" Foreground="{StaticResource Primary}" FontSize="11" Margin="0,4,0,9"/><TextBlock Text="{Binding LocalUrl}" Foreground="#506A82" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding RemotePort, StringFormat=云端通道 {0}}" Foreground="#8494A5" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="2"><Border CornerRadius="10" Background="{Binding StatusBackground}" Padding="8,4"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="10" FontWeight="SemiBold"/></Border><Button Style="{StaticResource SecondaryButton}" Content="设置" Tag="{Binding Id}" Click="EditRoute_Click" MinHeight="32" Height="32" Padding="11,0" Margin="0,48,0,0"/></StackPanel>
              </Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="EmptyPanel" Margin="22,0,22,22" Padding="24" Background="#F5F8FB" CornerRadius="10" Visibility="{Binding NoRoutesVisibility}"><TextBlock Text="还没有内网应用。点击「添加内网应用」，助手会自动分配隧道端口并测试本地网站。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></Border>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Expander Header="运行记录" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" Padding="16,10"><StackPanel Margin="8"><TextBlock Text="{Binding HealthMessage}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding LogPreview}" Foreground="{StaticResource Muted}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Style="{StaticResource SecondaryButton}" Content="打开日志文件夹" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenLogs_Click"/></StackPanel></Expander>
          <Expander Grid.Column="2" Header="助手与后台服务" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" Padding="16,10"><StackPanel Margin="8"><TextBlock Text="新电脑首次使用时，把助手、frpc.exe 和连接包放在同一目录。配置存在 ProgramData，更新不会覆盖。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><WrapPanel Margin="0,14,0,0"><Button Content="安装 / 修复后台服务" Click="InstallService_Click" Margin="0,0,8,8"/><Button Style="{StaticResource SecondaryButton}" Content="重启代理" Click="RestartService_Click" Margin="0,0,8,8"/><Button Style="{StaticResource SecondaryButton}" Content="导入连接凭据" Click="ImportToken_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel></Expander>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
