<Window x:Class="Pms.DataSyncAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pms.DataSyncAssistant"
        Title="PMS 数据同步助手" Icon="PmsDataSyncAssistant.png" Width="1080" Height="850" MinWidth="900" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#EEF3F8" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DCE5EF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="White" BorderBrush="#D6E1EC" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PmsPrimary}" VerticalAlignment="Center">
          <TextBlock Text="P" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="PMS 数据同步助手" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PmsInk}" />
            <Border Background="#EAF0F9" CornerRadius="9" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding AppVersionDisplay}" Foreground="{StaticResource PmsPrimary}" FontSize="10" FontWeight="SemiBold" /></Border>
          </StackPanel>
          <TextBlock Text="{Binding HostDisplay}" FontSize="11" Foreground="{StaticResource PmsMuted}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <Ellipse Width="8" Height="8" Fill="{Binding HeaderStatusColor}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding HeaderStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#405A73" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="CheckUpdateButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="检查更新" MinHeight="34" Height="34" Padding="14,0" Margin="0,0,2,0" VerticalAlignment="Center" Click="CheckUpdate_Click" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="30,24,30,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border CornerRadius="14" Padding="25" Background="{StaticResource PmsPrimaryStrong}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="520" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="本机服务概览" Foreground="#BDD0E6" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="{Binding OverviewTitle}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,3" />
              <TextBlock Text="配置会自动保存；后台服务运行后，关闭此窗口不会停止数据同步。" Foreground="#D5E1EF" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="11" Background="#22FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding PmsState}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="PMS 服务" Foreground="#C4D4E6" FontSize="10" /></StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding CredentialState}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="本机凭据" Foreground="#C4D4E6" FontSize="10" /></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding ServiceState}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="后台服务" Foreground="#C4D4E6" FontSize="10" /></StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="18,15">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="19" Background="#E9F6EF" VerticalAlignment="Center">
              <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Stroke="#24875C" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,4 L12,16 M7,11 L12,16 L17,11 M5,20 L19,20" /></Canvas></Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,20,0" VerticalAlignment="Center">
              <TextBlock x:Name="ProductUpdateTitle" Text="自动更新已开启" Foreground="{StaticResource PmsInk}" FontWeight="SemiBold" FontSize="13" />
              <TextBlock x:Name="ProductUpdateDetail" Text="后台服务每 6 小时自动检查；更新时这个窗口可继续使用。" Foreground="{StaticResource PmsMuted}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,18,0" VerticalAlignment="Center">
              <Grid><TextBlock x:Name="ProductUpdateStage" Text="已开启" Foreground="#506A82" FontSize="10" /><TextBlock x:Name="ProductUpdatePercent" Text="" HorizontalAlignment="Right" Foreground="{StaticResource PmsPrimary}" FontSize="10" FontWeight="SemiBold" /></Grid>
              <ProgressBar x:Name="ProductUpdateProgress" Minimum="0" Maximum="100" Value="0" Height="7" Margin="0,6,0,0" Foreground="#35A875" Background="#DFE7F0" />
            </StackPanel>
            <Button x:Name="OpenNewVersionButton" Grid.Column="3" Content="打开新版" Visibility="Collapsed" MinHeight="34" Height="34" Padding="14,0" VerticalAlignment="Center" Click="OpenNewVersion_Click" />
          </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,24,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="本机负责的连接" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PmsInk}" />
              <TextBlock Text="{Binding ConnectionCountDisplay}" FontSize="11" Foreground="{StaticResource PmsMuted}" Margin="0,3,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="＋  添加连接" Click="AddConnection_Click" />
          </Grid>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Connections}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:ConnectionViewModel}">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12" Padding="16" MinHeight="168">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#EAF0F9" VerticalAlignment="Top">
                      <TextBlock Text="D" Foreground="{StaticResource PmsPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,8,0">
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource PmsInk}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource PmsMuted}" FontSize="10" Margin="0,3,0,8" />
                      <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="运行电脑" Foreground="#7A8EA4" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding HostDisplay}" Foreground="#405D79" FontSize="10" /></Grid>
                      <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="数据位置" Foreground="#7A8EA4" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding DataLocation}" Foreground="#405D79" FontSize="10" /></Grid>
                      <TextBlock Text="{Binding Summary}" Foreground="#667B90" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Border CornerRadius="10" Background="{Binding StatusBackground}" Padding="8,4"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontSize="10" FontWeight="SemiBold" /></Border>
                      <Button Style="{StaticResource SecondaryButton}" Content="设置" MinHeight="30" Padding="10,0" Margin="0,62,0,0" Click="EditConnection_Click" Tag="{Binding Id}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <Grid Grid.Row="3" Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Expander Header="{Binding ActivityHeader}" IsExpanded="False" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" Padding="16,10">
            <Grid Margin="8">
              <TextBlock Text="暂无活动。查询、写入或下发后会自动显示在这里。" Foreground="{StaticResource PmsMuted}" Visibility="{Binding HasNoActivities, Converter={StaticResource BoolVisibility}}" />
              <ItemsControl ItemsSource="{Binding Activities}" Visibility="{Binding HasActivities, Converter={StaticResource BoolVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#E2E9F1" BorderThickness="0,0,0,1" Padding="0,9">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" Foreground="#7A8EA4" FontSize="10" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource PmsInk}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource PmsMuted}" FontSize="10" Margin="0,3,10,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="10" Background="{Binding StatusBackground}" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="10" FontWeight="SemiBold" /></Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Expander>
          <Expander Grid.Column="2" Header="{Binding AssistantInfoHeader}" IsExpanded="False" Background="White" BorderBrush="#DCE5EF" BorderThickness="1" Padding="16,10">
            <StackPanel Margin="8">
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="配置保存" Foreground="{StaticResource PmsMuted}" /><TextBlock Grid.Column="1" Text="已自动保存" HorizontalAlignment="Right" /></Grid>
              <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="配置目录" Foreground="{StaticResource PmsMuted}" /><TextBlock Grid.Column="1" Text="ProgramData\PMS" HorizontalAlignment="Right" /></Grid>
              <WrapPanel Margin="0,12,0,0"><Button x:Name="InstallServiceButton" Content="安装 / 更新后台服务" Margin="0,0,8,8" Click="InstallService_Click" /><Button Style="{StaticResource SecondaryButton}" Content="卸载本机连接服务" Margin="0,0,8,8" Click="UninstallService_Click" /><Button Background="#B1444B" Content="卸载此软件" Margin="0,0,0,8" Click="UninstallSoftware_Click" /></WrapPanel>
              <Border x:Name="UpgradeProgressPanel" Visibility="Collapsed" Background="#F5F8FB" BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                <StackPanel>
                  <Grid><TextBlock x:Name="UpgradeStatusText" Text="准备更新后台服务…" Foreground="{StaticResource PmsInk}" FontWeight="SemiBold" /><TextBlock x:Name="UpgradePercentText" Text="0%" HorizontalAlignment="Right" Foreground="{StaticResource PmsPrimary}" FontWeight="SemiBold" /></Grid>
                  <ProgressBar x:Name="UpgradeProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" Margin="0,9,0,7" Foreground="#35A875" Background="#DFE7F0" />
                  <TextBlock Text="更新期间请不要关机。窗口可以继续使用，后台服务完成切换后会自动恢复连接。" Foreground="{StaticResource PmsMuted}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Expander>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
