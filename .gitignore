node_modules
dist
build
.next
out
.env
.env.local
.env.*.local
*.log
.DS_Store
.idea
.vscode
.turbo
pnpm-lock.yaml.bak

# 小程序 npm 包产物（由 tools/build-miniapp-libs.mjs 生成）与开发者工具编译出的页面 JS
packages/*/miniprogram_dist/
apps/miniapp-*/miniprogram/miniprogram_npm/
apps/miniapp-*/miniprogram/pages/**/*.js
apps/miniapp-*/miniprogram/app.js

# deploy 产物（保留 .conf / .ps1 / README.md / dist 内的脚手架，不入库 tar.gz 与构建临时目录）
deploy/pms-api-*.tar.gz
deploy/pms-web-*.tar.gz
deploy/pms-api.tar.gz
deploy/dist/

# 本机工具与缓存
.pnpm-store/
.screenshots/
# 小程序上传台账（记录每次 upload 的版本号 + git hash，防止同号重复上传）
.ship-log.json
.ship.lock
# 写 `.claude/*` 而不是 `.claude/`：目录本身被忽略时 git 不会递归进去，
# 下面那条 `!` 放行规则就永远不生效（2026-08-31 踩过）。
.claude/*
# skills 是团队资产，不是本机配置：设计规范、工作流约定放在这里，
# 换台机器 / 另一个会话 / 姊妹项目都要能拿到，所以单独放行。
# settings.local.json、commands/ 这些仍被上面那条挡着。
!.claude/skills/
.codex/
.agents/

# 旧版 Flask 收费系统的本地拷贝（历史在 GitHub main/master 分支上，不混入 monorepo）
htdocs/
htdocs.rar

# 真实小区房产导入数据，含业主信息，绝不入库
data-prep/

# 原始素材：养护单扫描件、手写体 TTF 原文件（40MB）。
# 字体转成 woff2 后进仓库（apps/admin-web/src/fonts/），源文件留在本机。
# 重新生成：python tools/fonts/build-webfonts.py
/src/
