[Unit]
Description=WJWY Apartment Property Management System
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wjwy2
Environment=PYTHONPATH=/opt/wjwy2
Environment=FLASK_ENV=production
Environment=FLASK_APP=app.py

# 优化的资源限制配置
LimitNOFILE=65536
LimitNPROC=4096
LimitFSIZE=infinity
LimitAS=infinity
LimitLOCKS=infinity
LimitSIGPENDING=4096
LimitMSGQUEUE=819200
LimitNICE=0
LimitRTPRIO=0
LimitRTTIME=infinity

# 内存和CPU限制（可根据服务器配置调整）
MemoryHigh=2G
MemoryMax=3G
CPUQuota=80%

# 文件描述符软限制
LimitNOFILESoft=65536

# 进程优先级
Nice=0

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wjwy2/logs /opt/wjwy2/uploads
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# 超时设置
TimeoutStartSec=90
TimeoutStopSec=30

# 执行命令
ExecStart=/opt/wjwy2/venv/bin/python3 app.py --host=0.0.0.0 --port=5000
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# 环境变量
Environment=SECRET_KEY=your_production_secret_key_here
Environment=DATABASE_URL=mysql://user:password@localhost/wjwy_db

[Install]
WantedBy=multi-user.target