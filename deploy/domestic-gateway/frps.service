[Unit]
Description=PMS domestic gateway FRP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/frps -c /etc/pms-gateway/frps.toml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/pms-gateway

[Install]
WantedBy=multi-user.target
